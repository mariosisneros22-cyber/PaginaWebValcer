---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/variables.css';
import '../styles/global.css';
import PageHero from '../components/sections/hero/staticHero.astro';


interface Props {
  title: string;
  heroTitle?: string;
  heroImage?: ImageMetadata;
  disableHero?: boolean;
}

const { title, heroTitle, heroImage, disableHero } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ViewTransitions /> 
    
    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">

  </head>

  <body>
    
    <Header />

    {!disableHero && heroTitle && heroImage && (
      <PageHero title = {heroTitle} image={heroImage} />
    )}

    <slot name="hero" />
    
    <main transition:animate="initial">
    <!--<main transition:animate="slide">   Opcional: animación al cambiar -->
    <slot />  
    
    </main>
    
    <Footer />
  </body>
</html>

<style>
  main {
    padding-top: 0;
    min-height: 100vh;
  }
</style>