---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type IconType = 'construccion' | 'mantenimiento' | 'fabricacion' | 'consultoria';

interface Servicio {
  id: string;
  title: string;
  description: string;
  icon: IconType;
  image: ImageMetadata;
}

interface Props {
  servicios: Servicio[];
}

const { servicios } = Astro.props;

const icons: Record<IconType, string> = {
  construccion: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>`,
  mantenimiento: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>`,
  fabricacion: `<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line>`,
  consultoria: `<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>`,
};
---

<div class="servicios-container">
  <!-- Lado izquierdo: Lista de servicios -->
  <div class="servicios-nav">
    {servicios.map((servicio, index) => (
      <button 
        class={`servicio-tab ${index === 0 ? 'active' : ''}`}
        data-servicio={servicio.id}
      >
        <div class="tab-icono">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <Fragment set:html={icons[servicio.icon]} />
          </svg>
        </div>
        <h3>{servicio.title}</h3>
        <div class="tab-indicator"></div>
      </button>
    ))}
  </div>

  <!-- Lado derecho: Contenido del servicio -->
  <div class="servicios-content">
    {servicios.map((servicio, index) => (
      <div 
        class={`servicio-panel ${index === 0 ? 'active' : ''}`}
        data-panel={servicio.id}
      >
        <div class="panel-imagen">
          <Image src={servicio.image} alt={servicio.title} />
          <div class="imagen-overlay"></div>
        </div>
        <div class="panel-info">
          <h2>{servicio.title}</h2>
          <p>{servicio.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .servicios-container {
    display: flex;
    gap: 0;
    background: rgb(255, 255, 255);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    min-height: 400px;
  }

  /* NAVEGACIÓN IZQUIERDA */
  .servicios-nav {
    flex: 0;
    background: #1545ad;
    display: flex;
    flex-direction: column;
  }

  .servicio-tab {
    position: relative;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    padding: var(--spacing-md) ;
    text-align: left;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
  }

  .servicio-tab:hover {
    background: rgba(255, 255, 255, 0.05);
    color: white;
  }

  .servicio-tab.active {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .servicio-tab.active .tab-indicator {
    opacity: 1;
    transform: scaleY(1);
  }

  .tab-icono {
    flex-shrink: 0;
  }

  .servicio-tab h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    flex: 1;
  }

  .tab-indicator {
    position: absolute;
    right: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background: white;
    border-radius: 2px 0 0 2px;
    opacity: 0;
    transition: all 0.3s ease;
  }

  /* CONTENIDO DERECHO */
  .servicios-content {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .servicio-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s;
    display: flex;
    flex-direction: column;
  }

  .servicio-panel.active {
    opacity: 1;
    visibility: visible;
  }

  .panel-imagen {
    height: 60%;
    position: relative;
    overflow: hidden;
  }

  .panel-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .imagen-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.65) 70%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .imagen-titulo {
    position: absolute;
    bottom: var(--spacing-xl);
    left: var(--spacing-xl);
    right: var(--spacing-xl);

    margin: 0;
    z-index: 2;

    color: white;
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.2;
  }


  .panel-info {
    flex: 1;
    padding: var(--spacing-xl);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .panel-info h2 {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--spacing-md);
    color: var(--color-text);
  }

  .panel-info p {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-light);
    margin: 0;
  }

  /* RESPONSIVE */
  @media (max-width: 968px) {
    .servicios-container {
      flex-direction: column;
      min-height: auto;
    }

    .servicios-nav {
      flex: 0 0 auto;
      flex-direction: row;
      overflow-x: auto;
      padding: var(--spacing-sm);
    }

    .servicio-tab {
      flex-direction: column;
      min-width: 120px;
      text-align: center;
      padding: var(--spacing-md);
    }



    .tab-indicator {
      left: 50%;
      transform: translateX(-50%) scaleX(0);
      top: auto;
      bottom: 0;
      width: 60%;
      height: 3px;
      border-radius: 2px 2px 0 0;
    }

    .servicio-tab.active .tab-indicator {
      transform: translateX(-50%) scaleX(1);
    }

    .servicios-content {
      min-height: 400px;
    }

    .panel-imagen {
      height: 200px;
    }

    .panel-info {
      padding: var(--spacing-lg);
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    initServicios();
  });

  function initServicios() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.servicio-tab');
    const panels = document.querySelectorAll<HTMLDivElement>('.servicio-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const servicioId = tab.dataset.servicio;

        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        document
          .querySelector<HTMLDivElement>(`[data-panel="${servicioId}"]`)
          ?.classList.add('active');
      });
    });
  }
</script>