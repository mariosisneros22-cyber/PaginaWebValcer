---
import serviciosRaw from "../data/servicios.json";
import proyectosRaw from "../data/proyectos.json";

type Servicio = {
  id: string;
  title: string;
};

const servicios = (serviciosRaw as Servicio[]).map((s) => ({
  id: s.id,
  title: s.title.replace(/\s*\n\s*/g, " "),
}));

const totalProyectos = (proyectosRaw as unknown[]).length;
const year = new Date().getFullYear();
---

<footer class="footer" aria-labelledby="footer-title">
  <div class="container">
    <section class="footer-cta" aria-label="Llamado a la accion">
      <div>
        <h2 id="footer-title">Listos para ejecutar tu proximo proyecto</h2>
        <p>Conversemos sobre alcance, plazos y enfoque tecnico.</p>
      </div>
      <a class="btn-footer" href="/contacto">Conversemos</a>
    </section>

    <div class="footer-grid">
      <section class="footer-col">
        <h3>Valcer</h3>
        <p>
          Ejecucion, supervision y consultoria para obras civiles e infraestructura con
          estandares de calidad y seguridad.
        </p>
        <ul class="footer-kpis" aria-label="Indicadores">
          <li><strong>{totalProyectos}+</strong> proyectos</li>
          <li><strong>{servicios.length}</strong> lineas de servicio</li>
        </ul>
      </section>

      <nav class="footer-col" aria-label="Enlaces principales">
        <h4>Enlaces</h4>
        <ul class="footer-links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/proyectos">Proyectos</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/equipos">Equipos</a></li>
          <li><a href="/nosotros">Nosotros</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>

      <section class="footer-col" aria-label="Servicios">
        <h4>Servicios</h4>
        <ul class="footer-links">
          {servicios.map((s) => (
            <li>
              <a href={`/servicios?tab=${encodeURIComponent(s.id)}#servicios`}>{s.title}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="footer-col" aria-label="Politicas">
        <h4>Politicas</h4>
        <ul class="footer-links">
          <li>
            <a href="/docs/politicas.pdf" target="_blank" rel="noopener noreferrer">
              Politicas (PDF)
            </a>
          </li>
        </ul>
      </section>

      <address class="footer-col footer-contact" aria-label="Datos de contacto">
        <h4>Contacto</h4>
        <p>
          <span>Email:</span>{" "}
          <button type="button" class="copy-btn" data-copy="contacto@valcer.com">
            contacto@valcer.com
          </button>
        </p>
        <p>
          <span>Telefono:</span>{" "}
          <button type="button" class="copy-btn" data-copy="+51 123 456 789">
            +51 123 456 789
          </button>
        </p>
        <p><span>Horario:</span> Lun - Vie, 9:00 a 18:00</p>
      </address>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Valcer. Todos los derechos reservados.</p>
      <nav aria-label="Legal">
        <a href="/privacidad">Privacidad</a>
        <a href="/terminos">Terminos</a>
      </nav>
    </div>
  </div>

  <div id="copy-toast" class="copy-toast" role="status" aria-live="polite">
    Informacion Copiada
  </div>
</footer> 

<style>
  .footer {
    background:
      radial-gradient(circle at top right, rgba(109, 186, 235, 0.18), transparent 28%),
      linear-gradient(135deg, #22245d 0%, #2a2b6f 58%, #1c1f52 100%);
    color: #fff;
    padding: var(--spacing-lg) 0 var(--spacing-sm);
    margin-top: var(--spacing-lg);
  }

  .footer-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
    background: linear-gradient(135deg, rgba(109, 186, 235, .18), rgba(255,255,255,.06));
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 14px;
  }

  .footer-cta h2 {
    margin: 0 0 .4rem;
    font-size: var(--text-xl);
    color: #fff;
    line-height: 1.2;
  }

  .footer-cta p {
    margin: 0;
    color: rgba(255,255,255,.85);
  }

  .btn-footer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .7rem 1.1rem;
    background: var(--color-secondary);
    color: var(--color-primary);
    border-radius: 10px;
    font-weight: 700;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn-footer:hover {
    background: #92cdf2;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr 1.1fr;
    gap: var(--spacing-md);
  }

  .footer-col h3,
  .footer-col h4 {
    margin: 0 0 1rem;
    font-size: var(--text-md);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #fff;
    line-height: 1.2;
  }

  .footer-col h3::after,
  .footer-col h4::after {
    content: "";
    display: block;
    width: 36px;
    height: 2px;
    margin-top: .45rem;
    background: rgba(109, 186, 235, .85);
  }

  .footer-col p,
  .footer-links a,
  .footer-contact p {
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255,255,255,.78);
  }

  .footer-col p {
    margin: 0 0 .55rem;
  }

  .footer-kpis {
    list-style: none;
    padding: 0;
    margin: .85rem 0 0;
  }

  .footer-kpis li {
    margin-bottom: .35rem;
    color: rgba(255,255,255,.88);
    font-size: var(--text-sm);
  }

  .footer-kpis strong {
    color: #fff;
    font-weight: 800;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links li {
    margin-bottom: .5rem;
  }

  .footer-links a {
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-contact {
    font-style: normal;
  }

  .footer-contact span {
    color: rgba(255,255,255,.62);
    font-weight: 600;
  }

  /* ✅ Botón copiar: estilo "link" en TODAS las resoluciones */
  .copy-btn {
    background: none;
    border: 0;
    color: rgba(255,255,255,.92);
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    font: inherit;
  }

  .copy-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .footer-bottom {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-sm);
    border-top: 1px solid rgba(255,255,255,.24);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255,255,255,.72);
    font-size: var(--text-sm);
  }

  .footer-bottom nav {
    display: flex;
    gap: .9rem;
  }

  .footer-bottom nav a {
    color: rgba(255,255,255,.82);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .footer-bottom nav a:hover {
    color: #fff;
  }

  .footer a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ✅ Toast global */
  .copy-toast {
    position: fixed;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%) translateY(10px);
    background: rgba(15, 15, 15, 0.92);
    color: #fff;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: var(--text-sm);
    line-height: 1.2;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 9999;
  }

  .copy-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-toast {
      transition: none;
    }
  }

  @media (max-width: 1200px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .footer-cta {
      flex-direction: column;
      align-items: flex-start;
    }

    .btn-footer {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-sm);
    }

    .footer-col:first-child {
      grid-column: 1 / -1;
    }

    .footer-col h3,
    .footer-col h4 {
      font-size: var(--text-base);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  if (!window.__valcerCopyInit) {
    window.__valcerCopyInit = true;

    function showToast(message: string | null) {
      const toast = document.getElementById("copy-toast");
      if (!toast) return;

      toast.textContent = message;
      toast.classList.add("is-visible");

      if (window.__valcerToastTimer) {
        clearTimeout(window.__valcerToastTimer);
      }
      window.__valcerToastTimer = window.setTimeout(() => {
        toast.classList.remove("is-visible");
      }, 1600);
    }

    async function copyText(text: string) {
      if (navigator.clipboard?.writeText && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.top = "-9999px";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
    }

    document.addEventListener("click", async (e) => {
      const el = e.target instanceof Element ? e.target : null;
      const btn = el?.closest?.(".copy-btn");
      if (!btn) return;

      const text = btn.getAttribute("data-copy");
      if (!text) return;

      try {
        await copyText(text);
        showToast("Informacion Copiada");
      } catch {
        showToast("No se pudo copiar");
      }
    });
  }
</script>
