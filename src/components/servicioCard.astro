---
interface Props {
  title: string;
  description: string;
  icon: 'construccion' | 'mantenimiento' | 'fabricacion' | 'consultoria';
}

const { title, description, icon } = Astro.props;

const icons = {
  construccion: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>`,
  mantenimiento: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>`,
  fabricacion: `<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line>`,
  consultoria: `<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>`,
};
---

<div class="servicio-card">
  <div class="servicio-icono">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <Fragment set:html={icons[icon]} />
    </svg>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</div>

<style>
  .servicio-card {
    background: white;
    padding: var(--spacing-md);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .servicio-icono {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--spacing-sm);
    color: var(--color-primary);
  }

  .servicio-card h3 {
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .servicio-card p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0;
  }
</style>