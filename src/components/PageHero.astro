---
import { Image } from 'astro:assets';

interface Props{
    title: string;
    image: any;  
}

const { title, image} = Astro.props;
---
<section class="page-hero">
    <Image src={image} alt={title} />
    <div class="page-hero-content">
        <h1>{title}</h1>
    </div>
</section>

<style>
  .page-hero {
    position: relative;
    width: 100%;
    height: 50vh;
    overflow: hidden;
  }

  .page-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  .page-hero-content {
    position: absolute;
    bottom: 15%;
    left: 5%;
    color: white;
    z-index: 2;
  }

  .page-hero-content h1 {
    color: white;
    font-size: var(--text-3xl);
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-hero {
      height: 40vh;
    }

    .page-hero-content h1 {
      font-size: var(--text-2xl);
    }
  }

</style>