---
// src/components/Header.astro
const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav">
    <div class="logo">
      <a href="/">Valcer</a>
    </div>
    
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
      <span></span>
      <span></span>
      <span></span>
    </button>
    
    <ul class="nav-links" id="navLinks">
      <li>
        <a href="/" class={currentPath === '/' ? 'active' : ''}>
          Inicio
        </a>
      </li>
      <li>
        <a href="/proyectos" class={currentPath === '/proyectos' ? 'active' : ''}>
          Proyectos
        </a>
      </li>
      <li>
        <a href="/servicios" class={currentPath === '/servicios' ? 'active' : ''}>
          Servicios
        </a>
      </li>
      <li>
        <a href="/nosotros" class={currentPath === '/nosotros' ? 'active' : ''}>
          Nosotros
        </a>
      </li>
      <li>
        <a href="/contacto" class={currentPath === '/contacto' ? 'active' : ''}>
          Contacto
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background: transparent;
    z-index: 1000;
    transition: background 0.3s ease;
  }


  .header.scrolled {
    background: white;
    box-shadow: var(--shadow-sm);
  }

  .header.scrolled .logo a,
  .header.scrolled .nav-links a {
    color: var(--color-text);
  }

  .header.scrolled .nav-links a.active {
    color: var(--color-primary);
    text-decoration: none;
  }

  .header.scrolled .menu-toggle span {
    background: var(--color-text);
  }


  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-width);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--spacing-sm);
  }

  .logo a {
    font-size: var(--text-xl);
    font-weight: 700;
    color: white;
    transition: color var(--transition-fast);
  }

  .logo a:hover {
    color: var(--color-primary);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .menu-toggle span {
    width: 25px;
    height: 3px;
    background: var(--color-text);
    transition: all var(--transition-normal);
    border-radius: 2px;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--spacing-md);
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: white;
    font-weight: 500;
    font-size: var(--text-base);
    transition: color var(--transition-fast);
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .nav-links a.active {
    color: white;
    font-weight: 600;
    text-decoration: underline;
  }

  /* RESPONSIVE - Tablet y móvil */
  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: var(--header-height);
      left: 0;
      width: 100%;
      height: calc(100vh - var(--header-height));
      background: var(--color-background);
      flex-direction: column;
      gap: 0;
      padding: var(--spacing-md) 0;
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      box-shadow: var(--shadow-md);
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-links li {
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links a {
      display: block;
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--text-lg);
    }
  }
</style>

<script>
  function setupMenu() {
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');

    if (menuToggle && navLinks) {
      menuToggle.onclick = () => {
        navLinks.classList.toggle('active');
      };

      navLinks.querySelectorAll('a').forEach(link => {
        link.onclick = () => {
          navLinks.classList.remove('active');
        };
      });
    }
  }

  function handleScroll() {
    const header = document.querySelector('.header');
    if (window.scrollY > 50) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }

  // Ejecutar solo una vez
  setupMenu();
  handleScroll();
  window.addEventListener('scroll', handleScroll, { passive: true });

  // Re-ejecutar después de navegación
  document.addEventListener('astro:page-load', () => {
    setupMenu();
    handleScroll();
  });
</script>