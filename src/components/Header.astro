---
const currentPath = Astro.url.pathname;
---

<header class="header">
  <nav class="nav" aria-label="Navegacion principal">
    <div class="logo">
      <a href="/">Valcer</a>
    </div>

    <button
      class="menu-toggle"
      data-menu-toggle
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links" data-nav-links id="navLinks" aria-hidden="true" inert>
      <li>
        <a href="/" class={currentPath === '/' ? 'active' : ''}>Inicio</a>
      </li>
      <li>
        <a href="/proyectos" class={currentPath === '/proyectos' ? 'active' : ''}>Proyectos</a>
      </li>
      <li>
        <a href="/servicios" class={currentPath === '/servicios' ? 'active' : ''}>Servicios</a>
      </li>
      <li>
        <a href="/nosotros" class={currentPath === '/nosotros' ? 'active' : ''}>Nosotros</a>
      </li>
      <li>
        <a href="/contacto" class={currentPath === '/contacto' ? 'active' : ''}>Contacto</a>
      </li>
    </ul>
  </nav>
  <button class="nav-backdrop" data-nav-backdrop aria-hidden="true" tabindex="-1"></button>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background: transparent;
    z-index: 1000;
    transition: background 0.3s ease;
  }

  .header.scrolled {
    background: white;
    box-shadow: var(--shadow-sm);
  }

  .header.scrolled .logo a,
  .header.scrolled .nav-links a {
    color: var(--color-text);
  }

  .header.scrolled .nav-links a.active {
    color: var(--color-primary);
    text-decoration: none;
  }

  .header.scrolled .menu-toggle span {
    background: var(--color-text);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-width);
    height: 100%;
    margin: 0 auto;
    padding: 0 var(--spacing-sm);
  }

  .logo a {
    font-size: var(--text-xl);
    font-weight: 700;
    color: white;
    transition: color var(--transition-fast);
  }

  .logo a:hover {
    color: var(--color-primary);
  }

  .logo a:focus-visible,
  .nav-links a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .menu-toggle span {
    width: 25px;
    height: 3px;
    background: white;
    transition: all var(--transition-normal);
    border-radius: 2px;
  }

  .menu-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--spacing-md);
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: white;
    font-weight: 500;
    font-size: var(--text-base);
    transition: color var(--transition-fast);
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .nav-links a.active {
    color: white;
    font-weight: 600;
    text-decoration: underline;
  }

  .nav-backdrop {
    display: none;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
      z-index: 1001;
    }

    .nav-links {
      position: fixed;
      top: var(--header-height);
      left: 0;
      width: 100%;
      height: calc(100vh - var(--header-height));
      background: var(--color-background);
      flex-direction: column;
      gap: 0;
      padding: var(--spacing-md) 0;
      transform: translateX(-100%);
      transition: transform var(--transition-normal);
      box-shadow: var(--shadow-md);
      z-index: 1000;
    }

    .nav-links.active {
      transform: translateX(0);
    }

    .nav-backdrop {
      display: block;
      position: fixed;
      inset: var(--header-height) 0 0 0;
      border: 0;
      background: rgba(0, 0, 0, 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-normal);
      z-index: 999;
    }

    .nav-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links li {
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links a {
      display: block;
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--text-lg);
      color: var(--color-text);
    }

    .nav-links a.active {
      color: var(--color-primary);
    }
  }
</style>

<script>
  if (!window.__valcerHeader) {
    window.__valcerHeader = { cleanup: null };
  }

  function initHeader() {
    window.__valcerHeader.cleanup?.();

    const header = document.querySelector('.header');
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const navLinks = document.querySelector('[data-nav-links]');
    const backdrop = document.querySelector('[data-nav-backdrop]');
    if (!header || !menuToggle || !navLinks || !backdrop) return;

    const signalController = new AbortController();
    const { signal } = signalController;
    const isMobileMq = window.matchMedia('(max-width: 768px)');
    const links = Array.from(navLinks.querySelectorAll('a'));

    const lockScroll = () => {
      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
    };

    const applyMenuState = (open) => {
      menuToggle.classList.toggle('active', open);
      navLinks.classList.toggle('active', open);
      backdrop.classList.toggle('active', open);
      menuToggle.setAttribute('aria-expanded', String(open));
      menuToggle.setAttribute('aria-label', open ? 'Cerrar menu' : 'Abrir menu');

      if (isMobileMq.matches) {
        navLinks.toggleAttribute('inert', !open);
        navLinks.setAttribute('aria-hidden', String(!open));
      } else {
        navLinks.removeAttribute('inert');
        navLinks.setAttribute('aria-hidden', 'false');
      }

      if (open && isMobileMq.matches) {
        lockScroll();
        links[0]?.focus();
      } else {
        unlockScroll();
      }
    };

    const closeMenu = () => applyMenuState(false);
    const handleToggle = () => applyMenuState(!navLinks.classList.contains('active'));
    const handleScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 50);
    };

    menuToggle.addEventListener('click', handleToggle, { signal });
    backdrop.addEventListener('click', closeMenu, { signal });

    links.forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navLinks.classList.contains('active')) {
        closeMenu();
        menuToggle.focus();
      }
    }, { signal });

    window.addEventListener('resize', () => {
      if (!isMobileMq.matches) closeMenu();
      applyMenuState(navLinks.classList.contains('active'));
    }, { signal, passive: true });

    window.addEventListener('scroll', handleScroll, { signal, passive: true });
    handleScroll();
    applyMenuState(false);

    window.__valcerHeader.cleanup = () => {
      signalController.abort();
      closeMenu();
      window.__valcerHeader.cleanup = null;
    };
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('astro:before-preparation', () => {
    window.__valcerHeader.cleanup?.();
  });
</script>
