---
import { Image } from 'astro:assets';

interface ServiceTab {
  id: string;
  label: string;
  content: string;
  image?: ImageMetadata;
}

interface Props {
  tabs: ServiceTab[];
}

const { tabs } = Astro.props;
---
<div class="tabs">
  <div class="tabs-header-row">
    <div class="tab-headers" role="tablist">
      {tabs.map((tab, index) => (
        <button
          class={`tab-button ${index === 0 ? 'active' : ''}`}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? '0' : '-1'}
          data-index={index}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <h2 class="tabs-title">Nuestros <br /> servicios</h2>
  </div>

  <div class="tab-panels">
    {tabs.map((tab, index) => (
      <div
        class={`tab-panel ${index === 0 ? 'active' : ''}`}
        role="tabpanel"
        data-index={index}
      >
        <p>{tab.content}</p>

        {tab.image && (
          <Image
            src={tab.image}
            alt={tab.label}
            class="service-image"
          />
        )}
      </div>
    ))}
  </div>
</div>


<style>
  .tabs {
    width: 100%;
  }

  .tab-headers {
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tabs-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .tab-button {
    background: none;
    border: none;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    cursor: pointer;
    color: #666;
    position: relative;

    white-space: normal;        /* permite salto */
    text-align: center;
    line-height: center;
    max-width: 8rem;            /* controla el ancho del tab */
  }

  .tabs-title {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
  }

  .tab-button.active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .tab-button.active::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.5rem;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
  }

  .tab-panels {
    margin-top: 0.5rem;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

</style>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-button');
  const tabPanels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const indexAttr = button.dataset.index;
      if (indexAttr === undefined) return;

      const index = Number(indexAttr);

      tabButtons.forEach((btn) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
        btn.setAttribute('tabindex', '-1');
      });

      tabPanels.forEach((panel) => {
        panel.classList.remove('active');
      });

      button.classList.add('active');
      button.setAttribute('aria-selected', 'true');
      button.setAttribute('tabindex', '0');

      tabPanels[index]?.classList.add('active');
    });
  });
</script>
