---
import { Image } from 'astro:assets';

interface Props {
  images: any[];
  title: string;
  subtitle?: string;
}

const { images, title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="hero-slider">
    {images.map((image, index) => (
      <div class={`slide ${index === 0 ? 'active' : ''}`}>
        <Image 
          src={image} 
          alt={`Slide ${index + 1}`} 
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}
    
    <div class="hero-content">
      <div class="hero-container">
        <h1>{title}</h1>
        <p>{subtitle}</p>
      </div>
    </div>
    
    <button class="slide-btn prev" id="prevBtn">‹</button>
    <button class="slide-btn next" id="nextBtn">›</button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: min(95vh, 900px);
    overflow: hidden;
  }

  .hero-slider {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .slide.active {
    opacity: 1;
  }

  .slide::after { 
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.40);
    z-index: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center; /* o flex-end / flex-start */
  }
  .hero-container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .hero-content h1 {
    color: white;
    margin-bottom: 1rem;
    font-size: var(--text-3xl);
  }

  .hero-content p {
    color: white;
    font-size: var(--text-2xl);
  }

  .slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.5);
    border: none;
    font-size: 3rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    z-index: 10;
  }

  .slide-btn.prev {
    left: 20px;
  }

  .slide-btn.next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .hero {
      height: 60vh;
    }
    
    .hero-content {
      left: 5%;
    }

    .hero-content h1 {
      font-size: var(--text-2xl);
    }

    .hero-content p {
      font-size: var(--text-xl);
    }
    
    .slide-btn {
      font-size: 2rem;
      padding: 0.5rem 1rem;
    }
  }
</style>

<script>
  function initSlider() {
    let currentSlide = 0;
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;
    
    if (totalSlides === 0) return;
    
    let autoSlide: ReturnType<typeof setInterval>;

    function showSlide(index: number) {
      slides.forEach(slide => slide.classList.remove('active'));
      slides[index].classList.add('active');
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      showSlide(currentSlide);
    }

    function startAutoSlide() {
      autoSlide = setInterval(nextSlide, 5000);
    }

    document.getElementById('prevBtn')?.addEventListener('click', () => {
      clearInterval(autoSlide);
      prevSlide();
      startAutoSlide();
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      clearInterval(autoSlide);
      nextSlide();
      startAutoSlide();
    });

    startAutoSlide();
  }

  // Ejecutar en carga inicial
  initSlider();

  // Ejecutar después de navegación con View Transitions
  document.addEventListener('astro:page-load', initSlider);
</script>