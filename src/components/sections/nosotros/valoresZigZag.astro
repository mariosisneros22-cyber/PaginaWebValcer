---
import type { ValorData } from "../../../utils/valores";
type Props = {
  title?: string;
  lead?: string;
  items: ValorData[];
};

const {
  title = "Nuestros valores",
  lead = "Son los principios que guían cómo trabajamos, cómo decidimos y cómo entregamos resultados.",
  items
} = Astro.props as Props;
---

<section class="section values-zigzag" aria-labelledby="values-title">
  <div class="container">
    <header class="values-head">
      <h2 id="values-title" class="val-title">{title}</h2>
      <p class="val-subtitle">{lead}</p>
    </header>

    <ol class="values-track">
      {items.map((it, i) => (
        <li class="value" data-value>
          <div class="value-card">
            <div class="value-top">
              <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="value-title">{it.title}</h3>
            </div>

            <p class="value-principle">{it.principle}</p>
            <p class="value-body">{it.body}</p>
          </div>

          <span class="value-node" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .values-zigzag{
    padding: clamp(56px, 6vw, 88px) 0;
  }

  .val-title{
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  .val-subtitle{
    font-size: var(--text-xl);
  }
  .values-head{
    max-width: 72ch;
    margin: 0 auto 26px;
    text-align: center;
  }
  .values-head h2{ margin: 0 0 10px; }
  .values-head p{ margin: 0; color: var(--color-text-light); line-height: 1.7; }

  /* Track central (línea) */
  .values-track{
    --line: color-mix(in srgb, var(--color-primary) 12%, transparent);

    list-style: none;
    padding: 0;
    margin: 34px auto 0;

    position: relative;
    max-width: 980px;
  }

  .values-track::before{
    content:"";
    position:absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, transparent, var(--line), transparent);
    opacity: 1;
    pointer-events:none;
  }

  /* Cada item alterna */
  .value{
    position: relative;
    display: grid;
    grid-template-columns: 1fr 200px 1fr; /* canal central */
    align-items: start;                  /* no center */

    /* ✅ altura fija por fila = controla distancia entre dots */
    min-height: 170px;                   /* ajusta 150–210 según tu contenido */
    padding: 0;                          /* padding negativo fuera */
    margin: 0;
  }

  /* nodo central */
  .value-node{
    position: absolute;
    left: 50%;
    top: calc(var(--dot-y, 50%));   /* te dejo variable por si quieres micro ajuste */
    transform: translate(-50%, -50%);

    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  /* Card base */
  .value-card{
    background: rgba(255, 255, 255, 0.62);
    padding: 22px 24px;
    max-width: 46ch;

    /* anim base (opcional) */
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 520ms ease, transform 520ms cubic-bezier(.2,.8,.2,1);

    box-shadow: 0 10px 28px rgba(42, 43, 111, .08);
    border: 1px solid rgba(42, 43, 111, .08);
    border-radius: 14px;

  }

  .value.is-visible .value-card{
    opacity: 1;
    transform: translateY(0);
  }

  /* izquierda/derecha */
 .value:nth-child(odd) .value-card{
    grid-column: 1;
    justify-self: end;
    margin-top: calc((170px / 2) - 18px); /* 170px debe coincidir con min-height */
  }

  .value:nth-child(even) .value-card{
    grid-column: 3;
    justify-self: start;
    margin-top: calc((170px / 2) - 18px);
  }

  /* “conector” desde el centro a la card */
  .value:nth-child(odd)::before,
  .value:nth-child(even)::before{
    content:"";
    position:absolute;
    left: 50%;
    top: calc(var(--dot-y, 50%));
    transform: translateY(-50%);
    width: 96px;
    height: 2px;
    background: var(--line);
  }
  .value:nth-child(odd)::before{
    transform: translate(-96px, -50%);
  }

  /* Jerarquía tipográfica */
  .value-top{
    display:flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .value-num{
    font-weight: 900;
    letter-spacing: .06em;
    color: color-mix(in srgb, var(--color-primary) 85%, black);
    opacity: .9;
  }

  .value-title{
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
  }

  .value-principle{
    margin: 0 0 10px;
    font-weight: 700;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-primary) 78%, black);
  }

  .value-body{
    margin: 0;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  /* Móvil: una columna, línea a la izquierda */
  @media (max-width: 820px){
    .values-track{
      --lane: 0px;     /* ya no hay canal central */
      --branch: 0px;
    }

    .values-track::before{
      left: 14px;
      transform: none;
    }

    .value{
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 12px 0;
    }

    .value-node{
      left: 14px;     /* ✅ alinea con la línea */
      top: 22px;      /* ✅ ancla arriba, se ve “timeline” */
      transform: translate(-50%, 0);
    }

    .value:nth-child(odd)::before,
    .value:nth-child(even)::before{
      display:none;
    }

    .value-card{
      grid-column: 1;
      justify-self: stretch;
      max-width: none;
      margin-top: 0;
      padding-left: 28px; /* deja espacio para la línea y el dot */
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll<HTMLElement>('[data-value]');
    if (!items.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { items.forEach(i => i.classList.add('is-visible')); return; }

    const obs = new IntersectionObserver((entries, o) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.classList.add('is-visible');
        o.unobserve(el);
      });
    }, { threshold: 0.18, rootMargin: "0px 0px -12% 0px" });

    items.forEach((el) => obs.observe(el));
  });
</script>
