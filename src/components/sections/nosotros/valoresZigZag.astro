---
import type { ValorData } from "../../../utils/valores";
type Props = {
  title?: string;
  lead?: string;
  items: ValorData[];
};

const {
  title = "Nuestros valores",
  lead = "Son los principios que guian como trabajamos, como decidimos y como entregamos resultados.",
  items
} = Astro.props as Props;
---

<section class="section values-zigzag" aria-labelledby="values-title">
  <div class="container">
    <header class="values-head">
      <h2 id="values-title" class="val-title">{title}</h2>
      <p class="val-subtitle">{lead}</p>
    </header>

    <ol class="values-track">
      {items.map((it, i) => (
        <li class="value" data-value>
          <div class="value-card">
            <div class="value-top">
              <span class="value-num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="value-title">{it.title}</h3>
            </div>

            <p class="value-principle">{it.principle}</p>
            <p class="value-body">{it.body}</p>
          </div>

          <span class="value-node" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .values-zigzag {
    padding: clamp(56px, 6vw, 88px) 0;
  }

  .values-head {
    max-width: 72ch;
    margin: 0 auto 26px;
    text-align: center;
  }

  .val-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin: 0 0 10px;
  }

  .val-subtitle {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-text-light);
    line-height: 1.7;
  }

  .values-track {
    --line: color-mix(in srgb, var(--color-primary) 12%, transparent);
    --lane-gap: clamp(4rem, 8vw, 7rem);

    list-style: none;
    padding: 0;
    margin: 34px auto 0;
    max-width: 980px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--lane-gap);
    row-gap: 2rem;
  }

  .values-track::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, transparent, var(--line), transparent);
    pointer-events: none;
  }

  .value {
    position: relative;
    min-width: 0;
  }

  .value-card {
    background: rgba(255, 255, 255, 0.62);
    padding: 22px 24px;
    max-width: 46ch;
    box-shadow: 0 10px 28px rgba(42, 43, 111, 0.08);
    border: 1px solid rgba(42, 43, 111, 0.08);
    border-radius: 14px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 520ms ease, transform 520ms cubic-bezier(.2,.8,.2,1);
  }

  .value.is-visible .value-card {
    opacity: 1;
    transform: translateY(0);
  }

  .value:nth-child(odd) {
    grid-column: 1;
  }

  .value:nth-child(even) {
    grid-column: 2;
  }

  .value:nth-child(odd) .value-card {
    margin-left: auto;
  }

  .value:nth-child(even) .value-card {
    margin-right: auto;
  }

  .value-node {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--color-primary);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-primary) 10%, transparent);
  }

  .value:nth-child(odd) .value-node {
    right: calc(var(--lane-gap) / -2);
    transform: translate(50%, -50%);
  }

  .value:nth-child(even) .value-node {
    left: calc(var(--lane-gap) / -2);
    transform: translate(-50%, -50%);
  }

  .value:nth-child(odd)::before,
  .value:nth-child(even)::before {
    content: "";
    position: absolute;
    top: 50%;
    width: calc(var(--lane-gap) / 2);
    height: 2px;
    background: var(--line);
    transform: translateY(-50%);
  }

  .value:nth-child(odd)::before {
    right: calc(var(--lane-gap) / -2);
  }

  .value:nth-child(even)::before {
    left: calc(var(--lane-gap) / -2);
  }

  .value-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .value-num {
    font-weight: 900;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-primary) 85%, black);
    opacity: 0.9;
  }

  .value-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 900;
  }

  .value-principle {
    margin: 0 0 10px;
    font-weight: 700;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-primary) 78%, black);
  }

  .value-body {
    margin: 0;
    line-height: 1.75;
    color: var(--color-text-light);
  }

  @media (max-width: 820px) {
    .values-track {
      grid-template-columns: 1fr;
      row-gap: 1rem;
    }

    .values-track::before {
      left: 14px;
      transform: none;
    }

    .value:nth-child(odd),
    .value:nth-child(even) {
      grid-column: 1;
      padding: 12px 0;
    }

    .value::before {
      display: none;
    }

    .value-node,
    .value:nth-child(odd) .value-node,
    .value:nth-child(even) .value-node {
      left: 14px;
      right: auto;
      top: 22px;
      transform: translate(-50%, 0);
    }

    .value-card,
    .value:nth-child(odd) .value-card,
    .value:nth-child(even) .value-card {
      max-width: none;
      margin: 0;
      padding-left: 28px;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll<HTMLElement>('[data-value]');
    if (!items.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      items.forEach((i) => i.classList.add('is-visible'));
      return;
    }

    const obs = new IntersectionObserver((entries, o) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.classList.add('is-visible');
        o.unobserve(el);
      });
    }, { threshold: 0.18, rootMargin: "0px 0px -12% 0px" });

    items.forEach((el) => obs.observe(el));
  });
</script>
