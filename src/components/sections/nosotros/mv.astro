---
type TextBlock = { title: string; body: string };

type Props = {

  leftTag?: string;      // ej: "Propósito" o "Hoy"
  rightTag?: string;     // ej: "Rumbo" o "Futuro"

  mission: TextBlock;    // ej: { title: "Cómo trabajamos", body: "..." }
  vision: TextBlock;     // ej: { title: "Hacia dónde vamos", body: "..." }
};

const {
  leftTag = "MISION",
  rightTag = "VISION",

  mission,
  vision,
} = Astro.props;
---

<section class="section-3">
  <div class="container mvx">
    <div class="mvx-grid">

      <div class="mvx-main-title">
        <span class="mvx-main-title__part">NUESTRO</span>
        <span class="mvx-main-title__part mvx-main-title__part--accent">PROPOSITO</span>
      </div>

      <div class="mvx-side-label mvx-side-label--mission">
        {leftTag}
      </div>

      <div class="mvx-content mvx-content--mission">
        <h3 class="mvx-label">{mission.title}</h3>
        <p class="mvx-text">{mission.body}</p>
      </div>

      <div class="mvx-content mvx-content--vision">
        <h3 class="mvx-label">{vision.title}</h3>
        <p class="mvx-text">{vision.body}</p>
      </div>

      <div class="mvx-side-label mvx-side-label--vision">
        {rightTag}
      </div>

    </div>
  </div>
</section>

<style>
  .mvx-grid {
    display: grid;
    grid-template-columns: 120px 80px minmax(0, 1fr);
    grid-template-rows: minmax(220px, 1fr) minmax(220px, 1fr);
    gap: 1.5rem;
    align-items: stretch;
  }

  .mvx-main-title {
    grid-column: 1;
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .mvx-main-title__part {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-lr;
    text-orientation: upright;
    margin: 0;
    text-transform: uppercase;
    font-size: var(--text-3xl);
    line-height: 0.9;
    letter-spacing: 0.04em;
    font-weight: 800;
    color: var(--color-primary);
    -webkit-text-stroke: 1px var(--color-primary);
    paint-order: stroke fill;
    text-shadow: 0.05em 0.1em 0 rgba(95, 95, 95, 0.6);
    text-align: center;
  }

  .mvx-main-title__part--accent {
    color: var(--color-secondary);
    -webkit-text-stroke: 1px var(--color-secondary);
  }

  .mvx-side-label {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-lr;
    text-orientation: upright;
    text-align: center;

    margin: 0;
    text-transform: uppercase;
    font-size: var(--text-md);
    line-height: 0.9;
    letter-spacing: 0.08em;
    font-weight: 900;

    color: var(--color-primary);
    -webkit-text-stroke: 0.8px var(--color-primary);
    paint-order: stroke fill;
    text-shadow: 0.04em 0.08em 0 rgba(255, 255, 255, 0.6);

    opacity: 1;
  }

  .mvx-side-label--mission {
    grid-column: 2;
    grid-row: 1;
  }

  .mvx-content--mission {
    grid-column: 3 / 5;
    grid-row: 1;
  }

  .mvx-content--vision {
    grid-column: 2 / 4;
    grid-row: 2;
  }

  .mvx-side-label--vision {
    grid-column: 4;
    grid-row: 2;
  }

  .mvx-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mvx-content--vision {
    text-align: right;
    align-items: flex-end;
  }

  .mvx-content--mission {
    text-align: left;
    align-items: flex-start;
  }

  .mvx-label {
    margin: 0 0 0.5rem;
  }

  .mvx-text {
    margin: 0;
    line-height: 1.85;
    font-size: clamp(1rem, 0.643rem + 0.952vw, 1.5rem);
    max-width: 62ch;
  }

  @media (max-width: 900px) {
    .mvx-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .mvx-main-title,
    .mvx-side-label--mission,
    .mvx-side-label--vision,
    .mvx-content--mission,
    .mvx-content--vision {
      grid-column: auto;
      grid-row: auto;
    }

    .mvx-main-title {
      justify-content: flex-start;
      gap: 0.4rem;
    }

    .mvx-main-title__part,
    .mvx-side-label {
      writing-mode: initial;
      text-orientation: initial;
    }

    .mvx-content--mission,
    .mvx-content--vision {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>