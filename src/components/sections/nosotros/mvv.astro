---
import type { ImageMetadata } from "astro";

type TextBlock = { title: string; body: string };
type ValueItem = {
  label: string;
  desc?: string;
  icon?: string; // SVG string (inline)
};
type ValuesBlock = { title: string; items: ValueItem[] };

type Props = {
  title?: string;

  mission: TextBlock;
  vision: TextBlock;
  values: ValuesBlock;

  mediaImage: ImageMetadata;
  mediaAlt: string;
  mediaSide?: "left" | "right";
};

const {
  title = "Misión, visión y valores",
  mission,
  vision,
  values,
  mediaImage,
  mediaAlt,
  mediaSide = "left",
} = Astro.props;

---

<section class="section">
  <div class="container mvv">
    <h2 class="mvv__title">{title}</h2>

    <div class={`mvv__frame ${mediaSide === "right" ? "mvv__frame--right" : ""}`}>
      <!-- Top: Imagen + (Misión/Vision) -->
      <div class="mvv__top">
        <div class="mvv__media" aria-hidden={mediaAlt ? undefined : "true"}>
          <img
            class="mvv__mediaImg"
            src={mediaImage.src}
            width={mediaImage.width}
            height={mediaImage.height}
            alt={mediaAlt?.trim() ? mediaAlt : ""}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="mvv__mv" aria-label="Misión y Visión">
          <article class="mvv__mvItem" aria-labelledby="mvv-mision-title">
            <h3 class="mvv__mvLabel" id="mvv-mision-title">{mission.title}</h3>
            <p class="mvv__mvText">{mission.body}</p>
          </article>

          <div class="mvv__divider" aria-hidden="true"></div>

          <article class="mvv__mvItem" aria-labelledby="mvv-vision-title">
            <h3 class="mvv__mvLabel" id="mvv-vision-title">{vision.title}</h3>
            <p class="mvv__mvText">{vision.body}</p>
          </article>
        </div>
      </div>

      <!-- Bottom: Valores full width -->
      <div class="mvv__values" aria-label={values.title}>
        <h3 class="mvv__mvLabel">{values.title}</h3>

        {values.items?.length > 0 && (
          <ul class="mvv__valuesGrid" role="list">
            {values.items.map((v) => (
              <li class="mvv__valuesCard">
                <div class="mvv__valuesText">
                  <h4 class="mvv__valuesLabel">{v.label}</h4>
                  {v.desc ? <p class="mvv__valuesDesc">{v.desc}</p> : null}
                </div>

                {v.icon ? (
                  <div class="mvv__valuesIcon" aria-hidden="true" set:html={v.icon}></div>
                ) : null}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .mvv{
    --mvv-line-color: #e2e2e2;
    --mvv-line-width: 1px;
  }
  /* Base sobria (sin “cards”, sin equal heights) */
  .mvv__title {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* “Frame” general: apila top + bottom */
  .mvv__frame {
    display: grid;
    gap: 1.25rem;
  }

  .mvv__top {
    display: grid;
    grid-template-columns: clamp(320px, 32vw, 420px) 1fr; 
    align-items: stretch; /* iguala altura imagen con bloque MV */
    gap: 2rem;
  }

  .mvv__frame--right .mvv__media { order: 2; }
  .mvv__frame--right .mvv__mv { order: 1; }

  .mvv__media {
    overflow: hidden;
    align-self: stretch;
  }

  .mvv__mediaImg {
    display: block;
    width: 100%;
    height: 100%;       
    object-fit: cover;   
  }
  /* Right side (Misión/Vision) */
  .mvv__mv {
    border-top: var(--mvv-line-width) solid var(--mvv-line-color);
    padding: 1rem 0;
  }

  .mvv__mvItem {
    display: grid;
    gap: 0.5rem;
    padding-left: 0;
  }

  .mvv__mvLabel {
    margin: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mvv__mvLabel, .mvv__valuesLabel { line-height: 1.2; }

  .mvv__mvLabel::before,
  .mvv__mvLabel::after {
    content: "";
    flex: 1;
    border-top: var(--mvv-line-width) solid var(--mvv-line-color);
  }

  .mvv__mvText {
    margin: 0;
    line-height: 1.7;
  }

  .mvv__divider {
    height: 0;
    border-top: var(--mvv-line-width) solid var(--mvv-line-color);
    margin: 1rem 0;
  }

  /* Valores bottom */
  .mvv__values {
    border-top: var(--mvv-line-width) solid var(--mvv-line-color);
    padding-top: 1rem;
  }

  .mvv__valuesTitle {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .mvv__valuesGrid {
    list-style: none;
    margin: 0;
    padding: 0;

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: var(--mvv-line-width) solid var(--mvv-line-color);

    padding-bottom: 1rem;
  }

  .mvv__valuesCard {
    min-width: 0;
    padding: 1rem 1rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
  }

  .mvv__valuesIcon {
    width: 44px;
    height: 44px;
    justify-self: center; /* 👈 centra horizontal */
    align-self: end;   /* 👈 queda abajo */
  }

  .mvv__valuesIcon :global(svg) {
    width: 44px !important;
    height: 44px !important;
    max-width: 44px !important;
    max-height: 44px !important;
    display: block;
    overflow: visible;
  }

  /* Línea vertical entre columnas */
  .mvv__valuesCard + .mvv__valuesCard {
    border-left: var(--mvv-line-width) solid var(--mvv-line-color);
  }

  .mvv__valuesLabel {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .mvv__valuesDesc {
    margin: 0.35rem 0 0;
    line-height: 1.5;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .mvv__mvText { white-space: pre-line; }

  @media (prefers-reduced-motion: no-preference) {
    .mvv__frame {
      animation: mvvFadeUp 420ms ease-out both;
    }

     .mvv__valuesCard {
      position: relative;
      transition: transform 160ms ease;
    }

    .mvv__valuesCard::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 0;
      border-top: var(--mvv-line-width) solid var(--mvv-line-color);
      opacity: 0;
      transition: opacity 160ms ease;
    }

    
    .mvv__valuesCard:hover {
      transform: translateY(-2px);
    }

    .mvv__valuesCard:hover::after{
      opacity: 1;
    }

    .mvv__valuesCard:hover .mvv__valuesIcon :global(svg) {
      transform: translateY(-1px);
      transition: transform 160ms ease;
    }

    @keyframes mvvFadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

    /* ✅ Desktop desde 768px (como indicaste) */
  @media (max-width: 768px) {
    .mvv__top {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }

    .mvv__mediaImg {
      height: auto;         /* vuelve a natural */
      object-fit: initial;
    }
    /* valores en 4 columnas (tu diagrama) */
    .mvv__valuesGrid {
      grid-template-columns: 1fr;
    }

    .mvv__valuesCard + .mvv__valuesCard {
      border-left: 0;
      border-top: var(--mvv-line-width) solid var(--mvv-line-color);
    }
  }
</style>
