---
import type { ImageMetadata } from "astro";

type TextBlock = { title: string; body: string };
type ValueItem = {
  label: string;
  desc?: string;
  icon?: string; // SVG string (inline)
};
type ValuesBlock = { title: string; items: ValueItem[] };

type Props = {
  title?: string;

  mission: TextBlock;
  vision: TextBlock;
  values: ValuesBlock;

  mediaImage: ImageMetadata;
  mediaAlt: string;
  mediaSide?: "left" | "right";
};

const {
  title = "Misión, visión y valores",
  mission,
  vision,
  values,
  mediaImage,
  mediaAlt,
  mediaSide = "left",
} = Astro.props;

---

<section class="section">
  <div class="container mvv">
    <h2 class="mvv__title">{title}</h2>

    <div class={`mvv__frame ${mediaSide === "right" ? "mvv__frame--right" : ""}`} data-mvv>
      <!-- Top: Imagen + (Misión/Vision) -->
      <div class="mvv__top">
        <div class="mvv__media" aria-hidden={mediaAlt ? undefined : "true"} data-reveal style="--d:0ms">
          <img
            class="mvv__mediaImg"
            src={mediaImage.src}
            width={mediaImage.width}
            height={mediaImage.height}
            alt={mediaAlt?.trim() ? mediaAlt : ""}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="mvv__mv" aria-label="Misión y Visión" data-reveal style="--d:0ms">
          <article class="mvv__mvItem" aria-labelledby="mvv-mision-title">
            <h3 class="mvv__mvLabel" id="mvv-mision-title">{mission.title}</h3>
            <p class="mvv__mvText">{mission.body}</p>
          </article>

          <div class="mvv__divider" aria-hidden="true"></div>

          <article class="mvv__mvItem" aria-labelledby="mvv-vision-title">
            <h3 class="mvv__mvLabel" id="mvv-vision-title">{vision.title}</h3>
            <p class="mvv__mvText">{vision.body}</p>
          </article>
        </div>
      </div>

      <!-- Bottom: Valores full width -->
      <div class="mvv__values" aria-label={values.title} data-reveal style="--d:140ms">
        <h3 class="mvv__mvLabel">{values.title}</h3>

        {values.items?.length > 0 && (
          <ul class="mvv__valuesGrid" role="list">
            {values.items.map((v, i) => (
              <li class="mvv__valuesCard" data-reveal-item style={`--d:${220 + i * 150}ms`}>
                <div class="mvv__valuesText">
                  <h4 class="mvv__valuesLabel">{v.label}</h4>
                  {v.desc ? <p class="mvv__valuesDesc">{v.desc}</p> : null}
                </div>

                {v.icon ? (
                  <div class="mvv__valuesIcon" aria-hidden="true" set:html={v.icon}></div>
                ) : null}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .mvv{
    --mvv-line-color: #e2e2e2;
    --mvv-line-width: 1px;
  }
  /* Base sobria (sin “cards”, sin equal heights) */
  .mvv__title {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* “Frame” general: apila top + bottom */
  .mvv__frame {
    display: grid;
    gap: 1.25rem;
  }

  .mvv__top {
    display: grid;
    grid-template-columns: clamp(320px, 32vw, 420px) 1fr; 
    align-items: stretch; /* iguala altura imagen con bloque MV */
    gap: 2rem;
  }

  .mvv__frame--right .mvv__media { order: 2; }
  .mvv__frame--right .mvv__mv { order: 1; }

  .mvv__media {
    overflow: hidden;
    align-self: stretch;
  }

  .mvv__mediaImg {
    display: block;
    width: 100%;
    height: 100%;       
    object-fit: cover;   
  }

  /* Right side (Misión/Vision) */

  .mvv__mvItem {
    display: grid;
    gap: 0.5rem;
    padding-left: 0;
  }

  .mvv__mvLabel {
    margin: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mvv__mvLabel, .mvv__valuesLabel { line-height: 1.2; }

  .mvv__mvLabel::before,
  .mvv__mvLabel::after {
    content: "";
    flex: 1;
    border-top: var(--mvv-line-width) solid var(--mvv-line-color);
  }

  .mvv__mvText {
    margin: 0;
    line-height: 1.7;
    padding-inline: 3rem;  }

  .mvv__divider {
    height: 0;
    margin: 1rem 0;
  }

  /* Valores bottom */

  .mvv__valuesTitle {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .mvv__valuesGrid {
    list-style: none;
    margin: 0;
    padding: 0;

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: var(--mvv-line-width) solid var(--mvv-line-color);

    padding-bottom: 1rem;
  }

  .mvv__valuesCard {
    min-width: 0;
    padding: 1rem 1rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
  }

  .mvv__valuesIcon {
    width: 44px;
    height: 44px;
    justify-self: center; /* 👈 centra horizontal */
    align-self: end;   /* 👈 queda abajo */
  }

  .mvv__valuesIcon :global(svg) {
    width: 44px !important;
    height: 44px !important;
    max-width: 44px !important;
    max-height: 44px !important;
    display: block;
    overflow: visible;
  }

  /* Línea vertical entre columnas */
  .mvv__valuesCard + .mvv__valuesCard {
    border-left: var(--mvv-line-width) solid var(--mvv-line-color);
  }

  .mvv__valuesLabel {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .mvv__valuesDesc {
    margin: 0.35rem 0 0;
    line-height: 1.5;
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .mvv__mvText { white-space: pre-line; }


  .mvv__frame {
    /* estado final por defecto */
    opacity: 1;
    transform: none;
    will-change: opacity, transform;
  }


  /* Reveal por partes (stagger) */
  @media (prefers-reduced-motion: no-preference) {
    /* Duraciones y easing centralizados */
    .mvv {
      --reveal-duration: 1500ms;     /* 👈 aquí aumentas el tiempo */
      --reveal-ease: cubic-bezier(.22, 1, .36, 1);
      --reveal-distance: 12px;
    }

    /* Estado inicial (oculto) */
    .mvv__frame [data-reveal],
    .mvv__frame [data-reveal-item] {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
      will-change: opacity, transform;

      /* La transición vive siempre en el elemento */
      transition:
        opacity var(--reveal-duration) var(--reveal-ease),
        transform var(--reveal-duration) var(--reveal-ease);
      transition-delay: var(--d, 0ms);
    }

    /* Estado visible */
    .mvv__frame.is-reveal [data-reveal],
    .mvv__frame.is-reveal [data-reveal-item] {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .mvv__top {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
    }

    .mvv__mediaImg {
      height: auto;         /* vuelve a natural */
      object-fit: initial;
    }
    /* valores en 4 columnas (tu diagrama) */
    .mvv__valuesGrid {
      grid-template-columns: 1fr;
    }

    .mvv__valuesCard + .mvv__valuesCard {
      border-left: 0;
      border-top: var(--mvv-line-width) solid var(--mvv-line-color);
    }
  }
</style>


<script>
  document.addEventListener("astro:page-load", () => {
    const frame = document.querySelector("[data-mvv]");
    if (!frame) return;

    const prefersReduced =
      window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;

    if (prefersReduced) {
      frame.classList.add("is-reveal");
      return;
    }

    const img = frame.querySelector(".mvv__mediaImg");
    const reveal = async () => {
      try {
        if (img instanceof HTMLImageElement) {
          // decode() puede fallar si aún no hay src listo, por eso el try/catch
          await img.decode();
        }
      } catch (_) {}

      requestAnimationFrame(() => frame.classList.add("is-reveal"));
    };

    const obs = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (entry?.isIntersecting) {
          obs.disconnect();
          reveal();
        }
      },
      { threshold: 0.3, rootMargin: "-15% 0px -15% 0px" }
    );

    obs.observe(frame);
  });
</script>
