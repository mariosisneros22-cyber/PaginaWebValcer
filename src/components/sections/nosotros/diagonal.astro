---
import { Image } from "astro:assets";

type Img = { src: ImageMetadata; alt?: string };

interface Props {
  images: Img[];
  ratio?: string;
}

const { images, ratio = "16 / 7" } = Astro.props as Props;
const imgs = (images ?? []).slice(0, 4);
---

<div class="diag-lamellas" style={`--ratio:${ratio};`}>
  {imgs.map((img, i) => (
    <button
      type="button"
      class="lamella"
      aria-label={img.alt ?? `Imagen ${i + 1}`}
    >
      <Image
        src={img.src}
        alt={img.alt ?? `Imagen ${i + 1}`}
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 768px) 50vw, 25vw"
        quality={72}
      />
    </button>
  ))}
</div>

<style>
  .diag-lamellas {
    aspect-ratio: var(--ratio, 16 / 7);
    width: 100%;
    height: auto;
    display: flex;
    gap: 12px;
    overflow: hidden;
    background: transparent;
    border: 0;
    border-radius: 0;
  }

  .lamella {
    flex: 1 1 0;
    position: relative;
    border: 0;
    padding: 0;
    overflow: hidden;
    cursor: pointer;
    border-radius: 10px;
    background: transparent;
    transition: flex 0.35s cubic-bezier(.4, 0, .2, 1), filter 0.25s ease, transform 0.25s ease;
    filter: saturate(.92) contrast(.96) brightness(.96);
  }

  .lamella :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .diag-lamellas:hover .lamella {
    flex: 0.05 1 0; 
    filter: saturate(.82) brightness(.86);
  }

  .diag-lamellas:hover .lamella:hover {
    flex: 0.85 1 0; 
    filter: saturate(1) contrast(1) brightness(1);
  }
  
  .lamella:focus-visible {
    outline: 0;
    box-shadow: inset 0 0 0 3px rgba(109, 186, 235, 0.42);
  }

  @media (max-width: 768px) {
    .diag-lamellas {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      aspect-ratio: auto;
      overflow: visible;
    }

    .lamella {
      aspect-ratio: 4 / 3;
      border-radius: 10px;
    }
  }
</style>