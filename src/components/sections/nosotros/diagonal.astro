---
import { Image } from "astro:assets";

type Img = { src: ImageMetadata; alt?: string };

interface Props {
  images: Img[];
  ratio?: string;
}

const { images, ratio = "16 / 7" } = Astro.props as Props;
const imgs = (images ?? []).slice(0, 4);
---

<div class="diag-lamellas" style={`--ratio:${ratio};`} data-lamellas>
  {imgs.map((img, i) => (
    <button
      type="button"
      class={`lamella ${i === 0 ? "is-active" : ""}`}
      aria-label={img.alt ?? `Imagen ${i + 1}`}
    >
      <Image
        src={img.src}
        alt={img.alt ?? `Imagen ${i + 1}`}
        loading={i === 0 ? "eager" : "lazy"}
        decoding="async"
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 768px) 50vw, 25vw"
        quality={72}
      />
    </button>
  ))}
</div>

<style>
  .diag-lamellas{
    /* controla proporción */
    aspect-ratio: var(--ratio, 16 / 7);   /* ✅ ajusta aquí */
    height: auto;
    width: 100%;

    /* ✅ sin borde ni fondo */
    border: 0;
    background: transparent;
    border-radius: 0;

    /* si quieres que los cortes no se salgan */
    overflow: hidden;

    display: flex;
  }


  .lamella{
    flex: 1 1 0;
    position: relative;
    border: 0;
    padding: 0;
    overflow: hidden;

    cursor: pointer;

    clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);

    transition: flex .35s cubic-bezier(.4,0,.2,1), filter .25s ease;
    filter: saturate(.9) contrast(.95) brightness(.95);
  }

  .lamella :global(img){
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lamella + .lamella{
    box-shadow: inset 1px 0 0 rgba(255,255,255,.32);
  }

  .diag-lamellas:hover .lamella{
    flex: 0.8 1 0;
    filter: saturate(.8) brightness(.85);
  }

  .diag-lamellas:hover .lamella:hover,
  .lamella.is-active{
    flex: 2.2 1 0;
    filter: saturate(1) contrast(1) brightness(1);
  }

  .lamella:focus-visible{
    outline: 0;
    box-shadow: inset 0 0 0 3px rgba(109, 186, 235, .42);
  }

  @media (max-width: 768px){
    .diag-lamellas{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      aspect-ratio: auto;
      overflow: visible;
    }

    .lamella{
      aspect-ratio: 4/3;
      clip-path: none;
      border-radius: 10px; /* opcional */
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-lamellas]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const items = root.querySelectorAll<HTMLButtonElement>('.lamella');
      if (!items.length) return;

      const setActive = (el: HTMLButtonElement) => {
        items.forEach((x) => x.classList.remove('is-active'));
        el.classList.add('is-active');
      };

      items.forEach((el) => {
        el.addEventListener('click', () => setActive(el));
        el.addEventListener('focus', () => setActive(el));
      });
    });
  });
</script>
