---
import type { PilarData } from '../../../utils/valores';

const {
  title,
  text,
  color = '#000',
  direction = 'right',
} = Astro.props as PilarData;

--- 


<div class ={`pillar from-${direction}`} style={`--pillar-color: ${color};`} >
  <h3>{title}</h3>
  <p>{text}</p>
</div>

<style>
  .pillar{
    padding: 2rem;
    border-left:4px solid var(--pillar-color);
    opacity: 0;
    transition: 
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }


  /*estados inicales según dirección*/
  .from-right { transform: translateX(60px);}
  .from-left { transform: translateX(-60px);}
  .from-up { transform: translateY(-40px);}
  .from-down { transform: translateY(40px);}

  /*Visible */
  .pillar.is-visible{
    opacity: 1;
    transform: translate(0);
  }

  .pillar h3{
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .pillar p{
    line-height: 1.6;
    max-width: 60ch;
  }

</style>