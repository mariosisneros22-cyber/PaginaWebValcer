---
import type { ImageMetadata } from "astro";
import Diagonal from './diagonal.astro';

interface Props {
  images: ImageMetadata[];
}

const { images } = Astro.props;
const imgs = (images ?? []).slice(0, 4).map((img, i) => ({
  src: img,
  alt: `Imagen ${i + 1}`
}));
---

<section class="section section-who">
  <div class="container who-wrap">
    <div class="who-bottom">
      <Diagonal images={imgs} ratio="16/9" />
    </div>
  </div>
</section>

<style>
  .who-wrap{
    display: grid;
    gap: clamp(18px, 3vw, 28px);
  }

  /* Top: 2 columnas */
  .who-top{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(22px, 4vw, 64px);
    align-items: start;
  }
  .who-top__left{
    padding: clamp(1.3rem, 2vw, 2rem);
    font-size: var(--text-lg);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .who-top__left,
  .who-top__right{
    min-width: 0;
  }

  .who-top__right{
    text-align: right;

  }
  /* Tipografía */
  .who-top__right h2{
    margin: 0 0 12px;
    margin-left: auto;
  }

  .who-lead{
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-primary-dark);
    margin: 0;
    max-width: 40ch;
    margin-left: auto;
  }

  .who-top__left p{
    margin: 0 0 12px;
    line-height: 1.85;
    max-width: 75ch;
  }

  /* Bottom: imágenes full width */
  .who-bottom{
    width: 100%;
  }

  /* En móvil: apila título y texto */
  @media (max-width: 900px){
    .who-top{
      grid-template-columns: 1fr;
    }

    /* si quieres que el título vaya primero en móvil */
    .who-top__right{ order: -1; }
    .who-top__right,
    .who-lead,
    .who-top__right h2{
      text-align: left;
      margin-left: 0;
    }
  }


</style>

