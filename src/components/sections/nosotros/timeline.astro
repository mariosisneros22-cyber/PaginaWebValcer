---
import TimelineItem from "../../ui/timelineitem.astro";
import { timelineDataSorted as timelineData } from "../../../utils/timeline";
---

<section class="timeline-section" data-timeline style={`--n:${timelineData.length};`}>
  <div class="container">
    <header class="timeline-header">
      <h2>Historia y trayectoria</h2>
    </header>

    <div class="timeline-track" data-track>
      <div class="timeline-stage" data-stage>
        <div class="timeline-axis" aria-hidden="true">
          <div class="axis-line"></div>
          <div class="axis-progress"></div>
        </div>

        <div class="timeline-scenes">
          {timelineData.map((item, index) => {
            const layout = (item.layout ?? (index === 0 ? "intro" : "split")) as "intro" | "split";
            const side =
              layout === "split"
                ? ((index - 1) % 2 === 0 ? "A" : "B")
                : undefined;

            return <TimelineItem {...item} index={index} layout={layout} side={side} />;
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-track{ height: calc(var(--n) * 100vh); }

  .timeline-stage{
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .timeline-axis{
    position:absolute;
    inset:0;
    pointer-events:none;
    z-index: 1;
  }

  .axis-line, .axis-progress{
    position:absolute;
    left:50%;
    top:12vh;
    width:2px;
    height:76vh;
    transform: translateX(-50%);
  }

  .axis-line{ background:#e5e5e5; }
  .axis-progress{ background:#333; height: var(--line-progress, 0px); }

  .timeline-scenes{ 
    position:absolute; 
    inset:0;
    z-index: 2;
  }

  @media (max-width:768px){
    .timeline-track{ height:auto; }
    .timeline-stage{ position:static; height:auto; overflow:visible; }
    .timeline-axis{ display:none; }
    .timeline-scenes{ position:static; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const root = document.querySelector<HTMLElement>("[data-timeline]");
    if (!root) return;

    const track = root.querySelector<HTMLElement>("[data-track]");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-scene]"));
    if (!track || !stage || scenes.length === 0) return;

    let raf = 0;
    let activeIndex = -1;

    const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

    const setActive = (idx: number, t: number) => {
      if (idx !== activeIndex) {
        if (activeIndex >= 0) scenes[activeIndex]?.classList.remove("is-active");
        scenes[idx]?.classList.add("is-active");
        activeIndex = idx;
      }

      const n = scenes.length;
      const progress01 = (idx + t) / Math.max(1, n - 1);
      const usable = stage.getBoundingClientRect().height * 0.76;
      root.style.setProperty("--line-progress", `${progress01 * usable}px`);
    };

    const update = () => {
      raf = 0;

      const trackRect = track.getBoundingClientRect();
      const vh = window.innerHeight;

      const scrolled = clamp(-trackRect.top, 0, trackRect.height - vh);
      const raw = scrolled / vh;

      const idx = clamp(Math.floor(raw), 0, scenes.length - 1);
      const t = raw - Math.floor(raw);

      setActive(idx, t);
    };

    const schedule = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };

    schedule();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", schedule);
      window.removeEventListener("resize", schedule);
      if (raf) cancelAnimationFrame(raf);
    }, { once: true });
  });
</script>
