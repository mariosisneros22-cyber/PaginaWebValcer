---
import TimelineItem from "../../ui/timelineitem.astro";
import { timelineDataSorted as timelineData } from "../../../utils/timeline";
import type { TimelineItemData, TimelineLayout } from "../../../utils/timeline";

type SceneSide = "A" | "B";
type Scene = TimelineItemData & {
  layout: TimelineLayout;
  side?: SceneSide;
}

const currentYear = new Date().getFullYear().toString();

const outro: Scene = {
    id: 999,
    year: currentYear,
    title: "",
    description: "",
    layout: "outro",
    tagline: "Construyendo hoy, proyectando el mañana",
  };

const scenes: Scene[] = [...timelineData, outro].map((item, index) => {
  const layout: TimelineLayout = item.layout ?? (index === 0 ? "intro" : "split");
  const side: SceneSide | undefined =
    layout === "split" ? ((index - 1) % 2 === 0 ? "A" : "B") : undefined;

  return { ...item, layout, side };
});

const mobileYears = Array.from(new Set(scenes.map((s) => s.year)));
---

<section class="timeline-section" data-timeline style={`--n:${scenes.length}; --tail:0.6;`}>
  <div class="container">
    <header class="timeline-header">
      <h2 class="timeline-title">Conoce nuestra historia y trayectoria</h2>
    </header>

    <nav class="timeline-mobile-nav" aria-label="Navegacion por años">
      {mobileYears.map((year, idx) => (
        <button
          type="button"
          class={`mobile-year-chip${idx === 0 ? " is-active" : ""}`}
          data-mobile-year={year}
          data-target={`mobile-item-${scenes.findIndex((s) => s.year === year)}`}
        >
          {year}
        </button>
      ))}
    </nav>

    <div class="timeline-mobile-list">
      {scenes.map((item, index) => (
        <details
          class="timeline-mobile-item"
          data-mobile-item
          data-year={item.year}
          id={`mobile-item-${index}`}
          open={index === 0}
        >
          <summary>
            <span class="mobile-item-year">{item.year}</span>
            <span class="mobile-item-title">{item.layout === "outro" ? "Actualidad" : item.title}</span>
          </summary>

          <div class="mobile-item-body">
            {item.layout === "outro" ? (
              <p>{item.tagline ?? "Construyendo hoy, proyectando el manana."}</p>
            ) : (
              <p>{item.description}</p>
            )}

            {item.image ? (
              <img src={item.image.src} alt={item.imageAlt ?? item.title} loading="lazy" />
            ) : null}
          </div>
        </details>
      ))}
    </div>

    <div class="timeline-track" data-track>
      <div class="timeline-stage" data-stage>
        <div class="timeline-axis" aria-hidden="true">
          <div class="axis-line"></div>
          <div class="axis-progress"></div>
        </div>

        <div class="timeline-scenes">
          {scenes.map((item, index) => (
            <TimelineItem {...item} index={index} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-track{ 
    height: calc((var(--n) + var(--tail,0)) * 100vh); 
  }

  .timeline-title{
    font-size: var(--text-3xl);
    font-weight: 700;
  }

  .timeline-stage{
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .timeline-axis{
    position:absolute;
    inset:0;
    pointer-events:none;
    z-index: 1;
  }

  .axis-line, .axis-progress{
    position:absolute;
    left:50%;
    top:12vh;
    width:2px;
    height:76vh;
    transform: translateX(-50%);
  }

  .axis-line{ background: rgba(42, 43, 111, .14); }
  .axis-progress{ background: var(--color-primary); height: var(--line-progress, 0px); }

  .timeline-scenes{ 
    position:absolute; 
    inset:0;
    z-index: 2;
  }

  .timeline-mobile-nav,
  .timeline-mobile-list{
    display: none;
  }

  @media (max-width:768px){
    .timeline-title{
      font-size: var(--text-2xl);
      margin-bottom: 0.75rem;
    }

    .timeline-mobile-nav{
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 6px 0 10px;
      margin-bottom: 12px;
      position: sticky;
      top: calc(var(--header-height) + 8px);
      z-index: 25;
      background: var(--color-background);
      border-bottom: 1px solid rgba(42, 43, 111, .08);
      scrollbar-width: none;
    }

    .timeline-mobile-nav::-webkit-scrollbar{
      display: none;
    }

    .mobile-year-chip{
      border: 1px solid rgba(42, 43, 111, .14);
      border-radius: 999px;
      background: var(--color-white);
      color: var(--color-primary);
      padding: 6px 12px;
      font-size: var(--text-sm);
      white-space: nowrap;
      cursor: pointer;
    }

    .mobile-year-chip.is-active{
      background: var(--color-primary);
      color: var(--color-white);
      border-color: var(--color-primary);
    }

    .timeline-mobile-list{
      display: grid;
      gap: 10px;
      margin-bottom: 10px;
    }

    .timeline-mobile-item{
      border: 1px solid rgba(42, 43, 111, .1);
      border-radius: 10px;
      background: rgba(255, 255, 255, .9);
      overflow: clip;
      scroll-margin-top: calc(var(--header-height) + 70px);
    }

    .timeline-mobile-item > summary{
      list-style: none;
      display: grid;
      gap: 2px;
      padding: 10px 12px;
      cursor: pointer;
    }

    .timeline-mobile-item > summary::-webkit-details-marker{
      display: none;
    }

    .mobile-item-year{
      font-size: var(--text-xs);
      opacity: .75;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .mobile-item-title{
      font-size: var(--text-base);
      font-weight: 700;
      line-height: 1.3;
    }

    .mobile-item-body{
      padding: 0 12px 12px;
      display: grid;
      gap: 10px;
    }

    .mobile-item-body p{
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.55;
    }

    .mobile-item-body img{
      width: 100%;
      aspect-ratio: 16/10;
      object-fit: cover;
      border-radius: 8px;
    }

    .timeline-track{ height:auto; }
    .timeline-stage{ position:static; height:auto; overflow:visible; }
    .timeline-axis{ display:none; }
    .timeline-scenes{ display:none; }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const roots = Array.from(document.querySelectorAll<HTMLElement>("[data-timeline]"));
    if (roots.length === 0) return;

    for (const root of roots) {
      initTimeline(root);
    }

    function initTimeline(root: HTMLElement) {

      const isMobile = window.matchMedia("(max-width:768px)").matches;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // =========================
      // MÓVIL: timeline acordeon + chips de año
      // =========================
      if (isMobile) {
        const chips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-mobile-year]"));
        const items = Array.from(root.querySelectorAll<HTMLElement>("[data-mobile-item]"));
        if (chips.length === 0 || items.length === 0) return;

        const setActiveYear = (year: string) => {
          chips.forEach((chip) => {
            chip.classList.toggle("is-active", chip.dataset.mobileYear === year);
          });
        };

        const onChipClick = (e: Event) => {
          const btn = e.currentTarget as HTMLButtonElement;
          const targetId = btn.dataset.target;
          const year = btn.dataset.mobileYear;
          if (!targetId || !year) return;

          const target = root.querySelector<HTMLElement>(`#${targetId}`);
          if (!target) return;

          setActiveYear(year);
          const details = target as HTMLDetailsElement;
          details.open = true;
          target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
        };

        chips.forEach((chip) => chip.addEventListener("click", onChipClick));

        const io = new IntersectionObserver((entries) => {
          const candidate = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          const year = candidate?.target instanceof HTMLElement ? candidate.target.dataset.year : null;
          if (year) setActiveYear(year);
        }, { rootMargin: "-35% 0px -50% 0px", threshold: [0.2, 0.5, 0.8] });

        items.forEach((el) => io.observe(el));

        document.addEventListener(
          "astro:before-swap",
          () => {
            chips.forEach((chip) => chip.removeEventListener("click", onChipClick));
            io.disconnect();
          },
          { once: true }
        );

        return; // ✅ MUY IMPORTANTE: no ejecutar desktop
      }

      // =========================
      // DESKTOP: sticky + axis + fill
      // =========================
      if (reduceMotion) return;

      const track = root.querySelector<HTMLElement>("[data-track]");
      const stage = root.querySelector<HTMLElement>("[data-stage]");
      const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-scene]"));
      if (!track || !stage || scenes.length === 0) return;

      let raf = 0;
      let activeIndex = -1;
      let usable = stage.getBoundingClientRect().height * 0.76;
      let lastRaw = 0;

      const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));

      const recalc = () => {
        usable = stage.getBoundingClientRect().height * 0.76;
      };

      const setActive = (idx: number, t: number, progress01: number) => {
        if (idx !== activeIndex) {
          const prev = activeIndex;

          if (prev >= 0) {
            scenes[prev]?.classList.remove("is-active");
            scenes[prev]?.classList.add("is-prev");
          }

          scenes[idx]?.classList.add("is-active");
          scenes[idx]?.classList.remove("is-prev");

          activeIndex = idx;
        }

        root.style.setProperty("--line-progress", `${progress01 * usable}px`);

        for (let i = 0; i < scenes.length; i++) {
          // solo actualiza activa + vecinas / prev (perf)
          if (i !== activeIndex && !scenes[i].classList.contains("is-prev")) continue;

          if (i !== activeIndex && i !== activeIndex - 1 && i !== activeIndex + 1) {
            scenes[i].classList.remove("is-prev");
          }

          const v = i < idx ? 1 : i === idx ? t : 0;
          const next = String(v);
          if (scenes[i].style.getPropertyValue("--fill") !== next) {
            scenes[i].style.setProperty("--fill", next);
          }
        }
      };

      const update = () => {
        raf = 0;

        const trackRect = track.getBoundingClientRect();
        const vh = window.innerHeight;

        const scrolled = clamp(-trackRect.top, 0, trackRect.height - vh);
        const raw = scrolled / vh;

        lastRaw = raw;

        const last = scenes.length - 1;

        const idxUnclamped = Math.floor(raw);
        const rawClamped = clamp(raw, 0, last);

        const idx = Math.floor(rawClamped);
        const t = rawClamped - idx;

        const tFinal = idxUnclamped >= last ? 1 : t;
        const progress01 = rawClamped / Math.max(1, last);

        setActive(idx, tFinal, progress01);
      };

      const schedule = () => {
        if (raf) return;
        raf = requestAnimationFrame(update);
      };

      const onResize = () => {
        recalc();
        schedule();
      };

      schedule();
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", onResize, { passive: true });

      document.addEventListener(
        "astro:before-swap",
        () => {
          window.removeEventListener("scroll", schedule);
          window.removeEventListener("resize", onResize);
          if (raf) cancelAnimationFrame(raf);
        },
        { once: true }
      );
    }
  });

</script>
