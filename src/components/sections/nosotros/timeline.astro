---
import TimelineItem from '../../ui/timelineitem.astro';
import { timelineData } from '../../../utils/timeline';
---

<section class="timeline-section">
  <div class="container">
    <header class="timeline-header">
      <h2>Historia y trayectoria</h2>
    </header>
    

    <div class="timeline">
      {timelineData.map((item, index) => (
        <TimelineItem {...item} side={index % 2 === 0 ? 'left' : 'right'} />
      ))}
    </div>
  </div>
</section>

<style>
  

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-left: 0;
  }

  .timeline-section{
    position: relative;
  }

  .timeline-header{
    position:sticky;
    top: 0;
    z-index:5;

    background: white;

    padding-top: 5rem;
  
    border-bottom: 1px solid #e5e5e5;
  }
  .timeline-section h2 {
    margin-bottom: 3rem;
  }
  /* Línea vertical */
  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 100%;
    background-color: #e5e5e5;
    transform: translateX(-50%);
  }

  /* Línea progreso (animada) */
  .timeline::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: var(--line-progress, 0px); /* 👈 clave */
    background-color: #333;
    transform: translateX(-50%);
    transition: height 0.25s ease-out;
  }

  @media (max-width: 768px) {
    .timeline {
      padding-left: 2rem;
    }

    .timeline::before, .timeline::after {
      left: 1rem;
      transform: none;
    }

    .timeline-header{
      position:static;
      border-bottom: 0;
      padding-bottom: 0;
    }
  }

    
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll<HTMLElement>('.timeline-item');
    if (!items.length) return;

    const timeline = document.querySelector<HTMLElement>('.timeline');
    if (!timeline) return;

    let activeEl: HTMLElement | null = null;
    const visible = new Set<HTMLElement>();
    let rafPending = false;

    // 1) Centro del marker en viewport (para decidir escena activa)
    const getMarkerCenterViewport = (el: HTMLElement): number => {
      const marker = el.querySelector<HTMLElement>('.timeline-marker') ?? el;
      const r = marker.getBoundingClientRect();
      return r.top + r.height / 2;
    };

    // 2) Centro del marker dentro del timeline (para la línea de progreso)
    const getMarkerCenterInTimeline = (el: HTMLElement): number => {
      const marker =
        el.querySelector<HTMLElement>('.timeline-marker-inner') ??
        el.querySelector<HTMLElement>('.timeline-marker') ??
        el;

      const markerRect = marker.getBoundingClientRect();
      const timelineRect = timeline.getBoundingClientRect();

      const center =
        (markerRect.top + markerRect.height / 2) - timelineRect.top;

      return Math.max(0, Math.min(center, timeline.scrollHeight));
    };

    // 3) Activa una escena y actualiza progreso
    const setActive = (el: HTMLElement): void => {
      if (activeEl === el) return;

      if (activeEl) activeEl.classList.remove('is-active');
      el.classList.add('is-active');
      activeEl = el;

      const y = getMarkerCenterInTimeline(el);
      timeline.style.setProperty('--line-progress', `${y}px`);
    };

    // 4) Elige el item visible más cercano al centro del viewport
    const pickClosestToCenter = (): HTMLElement | null => {
      if (!visible.size) return null;

      const center = window.innerHeight * 0.5;
      let best: HTMLElement | null = null;
      let bestDist = Infinity;

      for (const el of visible) {
        const dist = Math.abs(getMarkerCenterViewport(el) - center);
        if (dist < bestDist) {
          bestDist = dist;
          best = el;
        }
      }

      return best;
    };

    // 5) Scheduler (anti-jitter)
    const scheduleUpdate = (): void => {
      if (rafPending) return;
      rafPending = true;

      requestAnimationFrame(() => {
        rafPending = false;
        const candidate = pickClosestToCenter();
        if (candidate) setActive(candidate);
      });
    };

    // 6) IntersectionObserver: solo gestiona visibilidad
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;

          if (entry.isIntersecting) {
            visible.add(el);
            el.classList.add('is-visible');
          } else {
            visible.delete(el);
          }
        }
        scheduleUpdate();
      },
      {
        threshold: 0.01,
        rootMargin: '-45% 0px -45% 0px',
      }
    );

    items.forEach((el) => observer.observe(el));

    // 7) Mantener escena/progreso sincronizados
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });

    // 8) Init
    scheduleUpdate();

    // 9) Cleanup opcional en navegación Astro
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        window.removeEventListener('scroll', scheduleUpdate);
        window.removeEventListener('resize', scheduleUpdate);
      },
      { once: true }
    );
  });
</script>
