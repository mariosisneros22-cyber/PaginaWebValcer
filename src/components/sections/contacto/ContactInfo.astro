---

<div class="info-block">
  <h3>Contactanos</h3>

  <dl class="info-list">
    <div class="info-row">
      <dt>Dirección:</dt>
      <dd>Calle Falsa 123, Ciudad</dd>
    </div>

    <div class="info-row">
      <dt>Teléfono:</dt>
      <dd>+52 123 456 7890</dd>
    </div>

    <div class="info-row">
      <dt>Email:</dt>
      <dd>contacto@ejemplo.com</dd>
    </div>

    <div class="info-row">
      <dt>Horario:</dt>
      <dd>
        <div>Lunes a Viernes: 9:00 - 18:00</div>
        <div>Sábados: 9:00 - 13:00</div>
      </dd>
    </div>
  </dl>

  <div class="social">
    <a class="social-link" href="#" aria-label="Instagram">
      <!-- SVG Instagram -->
      <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
        <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 4a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm5.2-.9a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"/>
      </svg>
    </a>

    <a class="social-link" href="#" aria-label="Facebook">
      <!-- SVG Facebook -->
      <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
        <path d="M13.5 22v-8h2.7l.4-3H13.5V9.1c0-.9.3-1.6 1.7-1.6h1.4V4.8c-.2 0-1.1-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.9V11H8v3h2.3v8h3.2z"/>
      </svg>
    </a>

    <a class="social-link" href="#" aria-label="LinkedIn">
      <!-- SVG LinkedIn -->
      <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
        <path d="M6.5 6.8A1.9 1.9 0 1 1 6.5 3a1.9 1.9 0 0 1 0 3.8zM5 21h3V9H5v12zm5.5-12h2.9v1.6h.04c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.9V21h-3v-5.4c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-3V9z"/>
      </svg>
    </a>
  </div>
</div>

<style>
  .info-block h3 { 
    margin: 0 0 1rem 0;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    font-weight: 600;
  }

  .info-list { margin: 0; padding: 0; }

  .info-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.9rem;
    padding: 0.55rem 0;
    border-bottom: 1px dashed rgba(42, 43, 111, .12);

  }

  .info-row dt { 
    font-weight: 600;
    color: var(--color-text-light);
  }
  .info-row dd { margin: 0; }

  .info-row:last-child {
    border-bottom: 0;
  }
  .social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    align-items: center;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: rgba(109, 186, 235, 0.06);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }

  .social-link:hover {
    transform: translateY(-1px);
    border-color: rgba(109, 186, 235, .5);
    box-shadow: 0 10px 18px rgba(42, 43, 111, .12);
  }
  
  .social-link svg {
    display: block;
    fill: var(--color-primary);
  }
</style>
