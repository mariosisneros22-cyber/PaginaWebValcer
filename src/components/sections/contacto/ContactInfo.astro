<div class="info-block">
  <h3>Dirigete a nosotros</h3>

  <dl class="info-list">
    <div class="info-row">
      <dt>Dirección:</dt>
      <dd>Calle Coronel Andre Reyes 175 - San Isidro</dd>
    </div>

    <div class="info-row">
      <dt>Teléfono:</dt>
      <dd>+51 941 027 146</dd>
    </div>

    <div class="info-row">
      <dt>Email:</dt>
      <dd>contacto@valcer.com.pe</dd>
    </div>

    <div class="info-row">
      <dt>Horario:</dt>
      <dd>
        <div>Lunes a Viernes: 9:00 - 19:00</div>
        <div>Sábados: 9:00 - 13:00</div>
      </dd>
    </div>
  </dl>

  <div class="social">
    <a class="social-link" href="https://www.instagram.com/valcer.cm/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
      <img src="/icons/social/instagram-svg.svg" alt="" width="22" height="22" loading="lazy" />
    </a>

    <a class="social-link" href="https://www.facebook.com/profile.php?id=61586425509843" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
      <img src="/icons/social/facebook-svg.svg" alt="" width="22" height="22" loading="lazy" />
    </a>

    <a class="social-link" href="https://pe.linkedin.com/company/constructora-valcer" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <img src="/icons/social/linkedin-svg.svg" alt="" width="22" height="22" loading="lazy" />
    </a>
  </div>
</div>

<style>
  .info-block h3 { 
    margin: 0 0 1rem 0;
    max-width: 10ch;
  }

  .info-list { margin: 0; padding: 0; }

  .info-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 0.9rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(42, 43, 111, 0.08);

  }

  .info-row dt { 
    font-weight: 700;
    color: var(--color-primary-dark);
  }
  .info-row dd {
    margin: 0;
    color: var(--color-text-light);
  }

  .info-row:last-child {
    border-bottom: 0;
  }
  .social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    align-items: center;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(42, 43, 111, 0.08);
    border-radius: 12px;
    background: rgba(109, 186, 235, 0.08);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }

  .social-link:hover {
    transform: translateY(-1px);
    border-color: rgba(109, 186, 235, 0.32);
    box-shadow: 0 10px 18px rgba(42, 43, 111, 0.08);
  }
  
  .social-link img {
    display: block;
    width: 22px;
    height: 22px;
  }
</style>
