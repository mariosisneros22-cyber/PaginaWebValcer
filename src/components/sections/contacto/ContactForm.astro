---

import Button from '../../ui/button.astro';

const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;

// Opcional: si quieres redireccionar a /gracias al enviar correctamente
const REDIRECT_URL = "/contacto?enviado=1";
---

<div class="contact-form">
  <form action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
  <input type="hidden" name="from_name" value="Valcer Web" />
  <input type="hidden" name="redirect" value={REDIRECT_URL} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <!-- Nombre + Apellidos -->
  <div class="field-row">
    <div class="field">
      <label for="name">Nombre</label>
      <input id="name" name="name" type="text" required />
    </div>

    <div class="field">
      <label for="last_name">Apellidos</label>
      <input id="last_name" name="last_name" type="text" required />
    </div>
  </div>

  <!-- Correo + Telefono -->
  <div class="field-row">
    <div class="field">
      <label for="email">Correo</label>
      <input id="email" name="email" type="email" required />
    </div>

    <div class="field">
      <label for="phone">Telefono</label>
      <input id="phone" name="phone" type="tel" />
    </div>
  </div>

  <!-- Mensaje -->
  <div class="field">
    <label for="message">Mensaje</label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>

  <div class="form-actions">
    <Button type="submit" class="submit-btn">
      Enviar
    </Button>
  <slot />
</button>
  </div>
</form>

</div>

<style>
  .contact-form form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.9rem;
  }

  input,
  textarea {
    padding: 0.6rem 0.85rem;
    border: 1px solid #dcdcdc;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  textarea {
    resize: vertical;
  }

  .submit-btn {
    margin-top: 0.5rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }


  .hidden {
    display: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .field-row {
      grid-template-columns: 1fr;
    }
  }

</style>
