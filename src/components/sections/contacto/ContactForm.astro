---

import Button from '../../ui/button.astro';

const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;

---

<div class="contact-form">
  <h3>  Solicita informacion</h3>

  <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">

    <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
    <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
    <input type="hidden" name="from_name" value="Valcer Web" />
    <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

    <!-- Nombre + Apellidos -->
    <div class="field-row">
      <div class="field">
        <label for="name">Nombre</label>
        <input id="name" name="name" type="text" required />
      </div>

      <div class="field">
        <label for="last_name">Apellidos</label>
        <input id="last_name" name="last_name" type="text" required />
      </div>
    </div>

    <!-- RUC / DNI -->
    <div class="field-row">
      <div class="field">
        <label for="doc_type">Documento</label>
        <select id="doc_type" name="doc_type" required>
          <option value="DNI">DNI</option>
          <option value="RUC">RUC</option>
        </select>
      </div>

      <div class="field">
        <label for="doc_number">N° Documento</label>
        <input
          id="doc_number"
          name="doc_number"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          placeholder="8 dígitos (DNI) / 11 dígitos (RUC)"
          required
        />
      </div>
    </div>

    <!-- Correo + Telefono -->
    <div class="field-row">
      <div class="field">
        <label for="email">Correo</label>
        <input id="email" name="email" type="email" required />
      </div>

      <div class="field">
        <label for="phone">Telefono</label>
        <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="Ej: 999988721"/>
      </div>
    </div>

    <!-- Mensaje -->
    <div class="field">
      <label for="message">Mensaje</label>
      <textarea id="message" name="message" rows="6" required></textarea>
    </div>

    <div class="form-actions">
      <Button type="submit" class="submit-btn">
        Enviar
      </Button>
    </div>
    <div id="form-message" class="form-message" aria-live="polite"></div>
  </form>

  <dialog id="contact-modal" class="contact-modal" aria-labelledby="contact-modal-title">
    <div class="modal-card">
      <h4 id="contact-modal-title">Mensaje</h4>
      <p id="contact-modal-text">Se envio correctamente el mensaje a VALCER </p>

      <div class="modal-actions">
        <button type="button" id="contact-modal-ok" class="btn btn-primary btn-sm">
          OK
        </button>

        
      </div>

      
    </div>
  </dialog>
</div>
<style>
  .contact-form form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  input,
  select,
  textarea {
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    line-height: 1.4;
    border-radius: 6px;
    color: var(--color-text);
    background: rgba(240, 246, 252, 0.72);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
  }

  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: none;
    border-color: var(--color-secondary-dark);
    background: var(--color-white);
    box-shadow: 0 0 0 4px rgba(109, 186, 235, .16);
  }

  textarea {
    resize: vertical;
  }

  .submit-btn {
    margin-top: 0.5rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }


  .hidden {
    display: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-message {
    margin-top: 1rem;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.25s ease;
  }

  .form-message-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    border-radius: 6px;
  }

  .form-message.success .form-message-inner {
    background: var(--color-success-soft);
    color: var(--color-success);
    border-left: 4px solid var(--color-success);
  }

  .form-message.error .form-message-inner {
    background: var(--color-error-soft);
    color: var(--color-error);
    border-left: 4px solid var(--color-error);
  }

  .form-message.loading .form-message-inner {
    background: var(--color-warning-soft);
    color: var(--color-warning);
    border-left: 4px solid var(--color-warning);
  }

  .form-message.success,
  .form-message.error,
  .form-message.loading {
    opacity: 1;
    transform: translateY(0);
  }


  .contact-modal::backdrop {
    background: var(--color-overlay);
  }

  .contact-modal {
    border: 0;
    padding: 0;
    background: transparent;

    width: min(520px, calc(100% - 2rem));
    margin: auto;           /* ✅ centra */
  }

  .contact-modal[open] {
    inset: 0;              /* ✅ fuerza centrado consistente */
  }

  .modal-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.25rem;
    box-shadow: var(--shadow-lg);
  }

  .modal-card h4 {
    margin: 0 0 .5rem 0;
  }

  .modal-card p {
    margin: 0;
    line-height: 1.6;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  
  .contact-form h3 {
    margin: 0 0 1rem 0;
    font-size: var(--text-xl);
    letter-spacing: -0.01em;
    font-weight: 650;
  }
  .spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .form-actions {
      justify-content: stretch;
    }
    .submit-btn {
      width: 100%;
    }
  }

</style>


<script>
  const form = document.querySelector("#contact-form") as HTMLFormElement | null;
  const submitBtn = form
    ? (form.querySelector('button[type="submit"]') as HTMLButtonElement | null)
    : null;

  const docTypeEl = document.getElementById("doc_type") as HTMLSelectElement | null;
  const docNumberEl = document.getElementById("doc_number") as HTMLInputElement | null;

  const modal = document.getElementById("contact-modal") as HTMLDialogElement | null;
  const modalText = document.getElementById("contact-modal-text") as HTMLParagraphElement | null;
  const modalOk = document.getElementById("contact-modal-ok") as HTMLButtonElement | null;

  function setSubmitting(isSubmitting: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = isSubmitting;
  }

  function digitsOnly(value:string) {
    return (value || "").replace(/\D+/g, "");
  }
  function validatePhone() {
    const phoneEl = document.getElementById("phone") as HTMLInputElement | null;
    if (!phoneEl) return true;

    const raw = digitsOnly(phoneEl.value);
    phoneEl.value = raw;

    // Ajusta regla según tu negocio:
    // Perú móvil: 9 dígitos. Si aceptas fijo, cambia la lógica.
    if (raw.length > 0 && raw.length !== 9) {
      phoneEl.setCustomValidity("El teléfono debe tener 9 dígitos.");
      return false;
    }

    phoneEl.setCustomValidity("");
    return true;
  }

  function validateDoc() {
    if (!docTypeEl || !docNumberEl) return true;

    const type = docTypeEl.value;
    const raw = digitsOnly(docNumberEl.value);
    docNumberEl.value = raw;

    const expected = type === "DNI" ? 8 : 11;

    if (raw.length !== expected) {
      docNumberEl.setCustomValidity(
        type === "DNI"
          ? "El DNI debe tener 8 dígitos."
          : "El RUC debe tener 11 dígitos."
      );
      return false;
    }

    docNumberEl.setCustomValidity("");
    return true;
  }

  function openModal(text: string) {
    if (!modal || !modalText) return;
    modalText.textContent = text;
    modal.showModal();
  }

  if (docTypeEl && docNumberEl) {
    docTypeEl.addEventListener("change", validateDoc);
    docNumberEl.addEventListener("input", validateDoc);
  }

  const phoneEl = document.getElementById("phone") as HTMLInputElement | null;

  if (phoneEl) {
    phoneEl.addEventListener("input", validatePhone);
  }

  if (modalOk && modal) {
    modalOk.addEventListener("click", () => modal.close("ok"));
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const docOk = validateDoc();
      if (!docOk) {
        form.reportValidity();
        return;
      }

      if (!form.reportValidity()) return;

      setSubmitting(true);

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();

        if (data && data.success) {
          openModal("Mensaje enviado correctamente.");

          modal?.addEventListener(
            "close",
            () => {
              if (modal.returnValue === "ok") {
                form.reset();
                if (docNumberEl) docNumberEl.setCustomValidity("");
              }
            },
            { once: true }
          );
        } else {
          openModal("No se pudo enviar. Revisa los campos e inténtalo nuevamente.");
        }
      } catch {
        openModal("Error de conexión. Intenta nuevamente.");
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
