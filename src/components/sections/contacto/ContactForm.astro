---

import Button from '../../ui/button.astro';

const WEB3FORMS_KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY;

---

<div class="contact-form">

  <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">

  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="Nuevo mensaje desde la web" />
  <input type="hidden" name="from_name" value="Valcer Web" />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <!-- Nombre + Apellidos -->
  <div class="field-row">
    <div class="field">
      <label for="name">Nombre</label>
      <input id="name" name="name" type="text" required />
    </div>

    <div class="field">
      <label for="last_name">Apellidos</label>
      <input id="last_name" name="last_name" type="text" required />
    </div>
  </div>

  <!-- Correo + Telefono -->
  <div class="field-row">
    <div class="field">
      <label for="email">Correo</label>
      <input id="email" name="email" type="email" required />
    </div>

    <div class="field">
      <label for="phone">Telefono</label>
      <input id="phone" name="phone" type="tel" />
    </div>
  </div>

  <!-- Mensaje -->
  <div class="field">
    <label for="message">Mensaje</label>
    <textarea id="message" name="message" rows="6" required></textarea>
  </div>

  <div class="form-actions">
    <Button type="submit" class="submit-btn">
      Enviar
    </Button>
  </div>

  <div id="form-message" class="form-message" aria-live="polite"></div>
</form>

</div>

<style>
  .contact-form form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.9rem;
  }

  input,
  textarea {
    padding: 0.6rem 0.85rem;
    border: 1px solid #dcdcdc;
    font-size: 0.95rem;
    line-height: 1.4;
    border-radius: 6px;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  textarea {
    resize: vertical;
  }

  .submit-btn {
    margin-top: 0.5rem;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }


  .hidden {
    display: none;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-message {
    margin-top: 1rem;
    opacity: 0;
    transform: translateY(-5px);
    transition: all 0.25s ease;
  }

  .form-message-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1rem;
    font-size: 0.9rem;
    border-radius: 6px;
  }

  .form-message.success .form-message-inner {
    background: #e8f5e9;
    color: #2e7d32;
    border-left: 4px solid #2e7d32;
  }

  .form-message.error .form-message-inner {
    background: #fdecea;
    color: #c62828;
    border-left: 4px solid #c62828;
  }

  .form-message.loading .form-message-inner {
    background: #f3f3f3;
    color: #555;
    border-left: 4px solid #999;
  }

  .form-message.success,
  .form-message.error,
  .form-message.loading {
    opacity: 1;
    transform: translateY(0);
  }

  .spin {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .form-actions {
      justify-content: stretch;
    }
    .submit-btn {
      width: 100%;
    }
  }

</style>


<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const messageEl = document.getElementById("form-message") as HTMLDivElement | null;

  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;

  type MessageType = "success" | "error" | "loading";

  const icons: Record<MessageType, string> = {
    success: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 16.2l-3.5-3.5L4 14.2 9 19l11-11-1.5-1.5z"/></svg>`,
    error: `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 14h-2v-2h2v2zm0-4h-2V6h2v6z"/></svg>`,
    loading: `<svg viewBox="0 0 24 24" width="18" height="18" class="spin" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="60"/></svg>`,
  };

  function setMessage(type: MessageType, text: string) {
    if (!messageEl) return;
    messageEl.className = `form-message ${type}`;
    messageEl.innerHTML = `<div class="form-message-inner">${icons[type]}<span>${text}</span></div>`;
  }

  function setSubmitting(isSubmitting: boolean) {
    if (!submitBtn) return;
    submitBtn.disabled = isSubmitting;
  }

  if (form && messageEl) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      setSubmitting(true);
      setMessage("loading", "Enviando mensaje...");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          body: new FormData(form),
        });

        const data = await response.json();

        if (data.success) {
          setMessage("success", "Mensaje enviado correctamente.");
          form.reset();
        } else {
          setMessage("error", "Hubo un error al enviar el mensaje.");
        }
      } catch {
        setMessage("error", "Error de conexión. Intenta nuevamente.");
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
