---
import { Image } from "astro:assets";

interface Client {
  name: string;
  logo: ImageMetadata;
}

interface Props{
  clients: Client[];
}

const { clients } = Astro.props;
---

<section class="section-2 clientes-seccion">
  <div class="carrusel-wrapper">
    <div class="carrusel-track">
      {clients.map((client) => (
        <div class="cliente-logo">
          <div class="logo-box">
            <Image src={client.logo} alt={client.name} loading="lazy" />
          </div>
        </div>
      ))}

      <!-- duplicado automático -->
      {clients.map((client) => (
        <div class="cliente-logo">
          <div class="logo-box">
            <Image src={client.logo} alt={client.name} loading="lazy" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carrusel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .carrusel-track {
    display: flex;
    gap: var(--spacing-md);
    width: max-content;
    animation: scroll 30s linear infinite;
  }

  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: clamp(120px, 12vw, 180px);
    height: clamp(120px, 12vw, 180px); /* altura fija igual al ancho */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-box {
    width: 100%;
    height: 100%;
    padding: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .cliente-logo:hover :global(img) {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }
  
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>