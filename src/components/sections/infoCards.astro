---
import { Image } from 'astro:assets';

interface InfoCard {
  title: string;
  year: string;
  location: string;
  status: string;
  content: string;
  image: ImageMetadata;
}

interface Props {
  cards: InfoCard[];
}

const { cards } = Astro.props;
---

<div class="cards-wrapper">
  <div class="cards-container">
    {cards.map((card) => (
      <div class="card">
        <div class="card-bg">
          <Image src={card.image} alt={card.title} loading="lazy" />
        </div>

        <div class="card-content">
          <h3 class="card-title">{card.title}</h3>

          <span class="card-meta">
            {card.year} · {card.location} · {card.status}
          </span>

          <p class="card-text">{card.content}</p>
        </div>

      </div>
    ))}
  </div>
</div>

<style>
  .cards-wrapper {
    width: 100%;
    overflow-x: auto;
    padding: 2rem 0;
  }

  .cards-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .card {
    position: relative;
    height: 420px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e0e0e0;
    background: #000;
  }

  .card-bg {
    position: absolute;
    inset: 0;
  }

  .card-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) contrast(1.05);
  }


  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 1.5rem;

    display: flex;
    flex-direction: column;
  }
  .card-meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
  }

  
  .card-title {
    margin-top: 0;
    margin-bottom: auto; 
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;

    text-align: left;
    align-self: flex-start;
    
    max-width: 90%;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.45),
      rgba(0, 0, 0, 0.55),
      rgba(0, 0, 0, 0.75)
    );
  }

  /* Mobile */
  @media (max-width: 768px) {
    .cards-wrapper {
      padding: 1rem;
      overflow-x: auto;
    }

    .cards-container {
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    }

    .card {
      min-width: 280px;
    }

    .card-image {
      height: 360px;
    }

    .card-title {
      font-size: 1.125rem;
    }
  }
</style>