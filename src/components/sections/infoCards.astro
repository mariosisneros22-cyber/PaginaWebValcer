---
import { Image } from 'astro:assets';

interface InfoCard {
  title: string;
  year: string;
  location: string;
  status: string;
  content: string;
  image: ImageMetadata;
}

interface Props {
  cards: InfoCard[];
}

const { cards } = Astro.props;
---

<div class="cards-wrapper">
  <div class="cards-container">
    {cards.map((card, index) => (
      <div class="card">
        <div class="card-bg">
          <Image src={card.image} alt={card.title} loading={index < 4 ? "eager" : "lazy"} width={400}  height={420} quality={75} densities={[1, 2]}/>
        </div>

        <div class="card-content">
          <h3 class="card-title">{card.title}</h3>

          <span class="card-meta">
            {card.year} · {card.location} · {card.status}
          </span>

          <p class="card-text">{card.content}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .cards-wrapper {
    width: 100%;
    overflow-x: auto;
    padding: 2rem 0;
    /* Suaviza scroll horizontal en móvil */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .cards-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .card {
    position: relative;
    height: 420px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(224, 224, 224, 0.2);
    background: #000;
    /* Mejora rendimiento de animaciones */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .card-bg {
    position: absolute;
    inset: 0;
  }

  .card-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Removí filtros CSS costosos */
  }

  .card-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-meta {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.8);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .card-title {
    margin: 0 0 auto 0;
    font-size: 1.3rem;
    font-weight: 600;
    color: #fff;
    text-align: left;
    max-width: 90%;
    
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.6);
  }

  .card-text {
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  /* Overlay mejorado - más eficiente */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    pointer-events: none;
  }

  /* Hover suave */
  @media (hover: hover) {
    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
    }
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .cards-container {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }

    .card {
      height: 380px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .cards-wrapper {
      padding: 1rem;
    }

    .cards-container {
      gap: 1rem;
      grid-template-columns: 1fr;
    }

    .card {
      height: 360px;
    }

    .card-title {
      font-size: 1.125rem;
    }

    .card-text {
      font-size: 0.85rem;
    }
  }
</style>