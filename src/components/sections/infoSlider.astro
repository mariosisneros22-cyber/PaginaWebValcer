---
interface Slider {
  title: string;
  content: string;
  metric?: string;
  icon?: string;
}

interface Props {
  slider: Slider[];
  autoplayInterval?: number;
}

const { slider, autoplayInterval = 5000 } = Astro.props;
---

<div class="about-slider-fade">
  <div class="cards-container">
    {slider.map((slide, index) => (
      <div 
        class={`about-card ${index === 0 ? 'active' : ''}`}
        data-slide={index}
      >
        <div class="slider-layout">
          <div class="slider-content">
            {slide.metric && <span class="slider-metric">{slide.metric}</span>}
            <h3>{slide.title}</h3>
            <p>{slide.content}</p>
          </div>
          {slide.icon && (
            <div class="slider-icon">
              <img 
                src={slide.icon} 
                alt="" 
                aria-hidden="true"
                width="96"
                height="96"
                loading={index === 0 ? "eager" : "lazy"}
              />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
  
  <div class="slider-controls">
    <div class="slider-indicators">
      {slider.map((_, index) => (
        <button 
          class={`indicator ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`Slide ${index + 1} de ${slider.length}`}
        ></button>
      ))}
    </div>
  </div>
</div>

<style>
  .about-slider-fade {
    width: 100%;
  }

  .cards-container {
    position: relative;
    min-height: 250px;
    contain: layout style paint;
  }

  .about-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out, visibility 0s 0.6s;
    background: #ffffff;
    padding: 2.5rem;
    box-shadow: 0px 10px 5px -5px rgba(0,0,0,0.05);
    pointer-events: none;
    will-change: opacity;
  }

  .about-card.active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease-in-out, visibility 0s 0s;
    pointer-events: auto;
  }

  .slider-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .slider-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .slider-metric {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .slider-content h3 {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    font-weight: 600;
    margin: 0;
  }

  .slider-content p {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  .slider-icon {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
  }

  .slider-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slider-controls {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-md);
  }

  .slider-indicators {
    display: flex;
    gap: 12px;
  }

  .indicator {
    width: 40px;
    height: 4px;
    background: #e0e0e0;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .indicator.active {
    background: var(--color-primary);
  }

  .indicator:hover:not(.active) {
    background: #bdbdbd;
    transform: scaleY(1.5);
  }

  .indicator:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .about-card {
      padding: 1.5rem;
    }

    .slider-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .slider-icon {
      width: 72px;
      height: 72px;
      margin: 0 auto;
    }

    .slider-content {
      text-align: center;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-card {
      transition: none;
    }
  }
</style>

<script define:vars={{ autoplayInterval }}>
  function initAboutSlider() {
    let currentCard = 0;
    let autoplayTimer = null;
    const cards = document.querySelectorAll('.about-card');
    const indicators = document.querySelectorAll('.indicator');
    const totalCards = cards.length;

    if (totalCards === 0) return;

    function showCard(index) {
      cards.forEach(card => card.classList.remove('active'));
      indicators.forEach(ind => ind.classList.remove('active'));
      
      cards[index].classList.add('active');
      indicators[index].classList.add('active');
      currentCard = index;
    }

    function nextCard() {
      const nextIndex = (currentCard + 1) % totalCards;
      showCard(nextIndex);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(nextCard, autoplayInterval);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        showCard(index);
        startAutoplay();
      });
    });

    const slider = document.querySelector('.about-slider-fade');
    if (slider) {
      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);
    }

    // Pausar cuando tab no está visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    });

    // Cleanup
    const cleanup = () => {
      stopAutoplay();
    };

    document.addEventListener('astro:before-preparation', cleanup);

    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutSlider);
  } else {
    initAboutSlider();
  }
  
  document.addEventListener('astro:page-load', initAboutSlider);
</script>