---
import isoRaw from "../../../data/iso.json";

type IsoItem = {
  id: string;
  number: string;
  title: string;
  scope: string;
  status?: "vigente" | "en_proceso";
  year?: number;
  certificate?: string | null;
};

const iso = isoRaw as IsoItem[];
---

<section class="section" id="iso">
  <div class="container">
    <header class="iso-head">
      <h2>Certificaciones ISO</h2>
      <p class="iso-lead">
        Estándares internacionales que respaldan nuestros procesos, seguridad operativa y gestión.
      </p>
    </header>

    <div class="iso-grid" role="list">
      {iso.map((item) => (
        <article class="iso-card" role="listitem" aria-label={`ISO ${item.number}`}>
          <div class="iso-top">
            <div class="iso-label">
              <span class="iso-label__text">ISO</span>
              <span class="iso-number">{item.number}</span>
            </div>

            {item.status && (
              <span class={`iso-badge iso-badge--${item.status}`}>
                {item.status === "vigente" ? "Vigente" : "En proceso"}
              </span>
            )}
          </div>

          <div class="iso-body">
            <h3 class="iso-title">{item.title}</h3>
            <p class="iso-scope">{item.scope}</p>
            {typeof item.year === "number" && <p class="iso-year">Año: {item.year}</p>}
          </div>

          <div class="iso-foot">
            {item.certificate ? (
              <a class="iso-link" href={item.certificate} target="_blank" rel="noopener">
                Ver certificado
              </a>
            ) : (
              <span class="iso-muted">Certificado disponible a solicitud</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @import "./iso-grid.css";
</style>