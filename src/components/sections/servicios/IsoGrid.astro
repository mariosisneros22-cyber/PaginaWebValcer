---
import isoRaw from "../../../data/iso.json";

type IsoItem = {
  id: string;
  number: string;
  title: string;
  scope?: string;
  status?: "vigente" | "en_proceso";
  year?: number;
  certificate?: string | null;
};

const iso = isoRaw as IsoItem[];

const getPreviewFromCertificate = (certificate?: string | null) =>
  certificate
    ? certificate
        .replace("/iso/pdf/", "/iso/webp/")
        .replace(/\.pdf$/i, ".webp")
    : null;

const getStatusLabel = (status?: "vigente" | "en_proceso") => {
  if (status === "vigente") return "Vigente";
  if (status === "en_proceso") return "En proceso";
  return "";
};
---

<section class="section-3 iso-section" id="iso">
  <div class="container">
    <header class="iso-head">
      <h2>Certificaciones ISO</h2>
    </header>

    <div class="iso-grid" role="list">
      {iso.map((item) => {
        const previewSrc = getPreviewFromCertificate(item.certificate);
        const statusLabel = getStatusLabel(item.status);

        return (
          <article class="iso-item" role="listitem" aria-label={`ISO ${item.number}`}>
            {previewSrc && (
              <a
                class="iso-thumb-link"
                href={item.certificate ?? "#"}
                target="_blank"
                rel="noopener"
                aria-label={`Abrir certificado ISO ${item.number}`}
              >
                <img
                  class="iso-thumb"
                  src={previewSrc}
                  alt={`Vista previa del certificado ISO ${item.number}`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}

            <div class="iso-text">
              {item.certificate ? (
                <a
                  class="iso-number"
                  href={item.certificate}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Abrir certificado ISO ${item.number}`}
                >
                  {item.number}
                </a>
              ) : (
                <span class="iso-number">{item.number}</span>
              )}

              <h3 class="iso-title">{item.title}</h3>

              {statusLabel && <p class="iso-status">{statusLabel}</p>}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  @import "./iso-grid.css";
</style>