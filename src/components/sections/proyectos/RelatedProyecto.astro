---
import type { ImageMetadata } from "astro";
import proyectos from "../../../data/proyectos.json";
import { isVisibleProject } from "../../../lib/projects";
import RelatedProyectoReact from "./RelatedProyectoReact.tsx";

type Proyecto = (typeof proyectos)[number];

type Props = {
  currentSlug: string;
  limit?: number;
  // ✅ ya NO recibimos resolveImg desde el slug, porque aquí resolvemos coverUrl
};

const { currentSlug, limit = 3 } = Astro.props as Props;

// ✅ conserva querystring del slug (ej: ?estado=...&q=...)
// esto ayuda a "volver" con filtros
const backQuery = Astro.url.search ?? "";

// ✅ glob para obtener URL serializable
type ImgModule = { default: ImageMetadata };
const imgs = import.meta.glob<ImgModule>(
  "../../../assets/images/proyecto/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

function resolveCoverUrl(relPath: string): string {
  const key = `../../../assets/images/proyecto/${relPath}`;
  const mod = imgs[key];
  return mod ? mod.default.src : "";
}

const current = proyectos.find((p) => p.slug === currentSlug);

let related: Proyecto[] = [];
let subtitle = "";

if (current && isVisibleProject(current)) {
  const base = proyectos
    .filter(isVisibleProject)
    .filter((p) => p.slug !== currentSlug);

  const currentServicios = new Set(
    (current.servicios ?? []).map((r) => String(r).toLowerCase())
  );
  const currentDpto = current.ubicacion?.departamento?.toLowerCase?.() ?? "";

  const relatedByServicio = base
    .filter((p) =>
      (p.servicios ?? []).some((r) => currentServicios.has(String(r).toLowerCase()))
    )
    .slice(0, limit);

  related = relatedByServicio;
  subtitle =
    relatedByServicio.length > 0
      ? "Relacionados por servicio."
      : "Relacionados por departamento.";

  if (related.length < limit && currentDpto) {
    const remaining = limit - related.length;
    const used = new Set(related.map((p) => p.slug));

    const byDpto = base
      .filter((p) => !used.has(p.slug))
      .filter(
        (p) => (p.ubicacion?.departamento?.toLowerCase?.() ?? "") === currentDpto
      )
      .slice(0, remaining);

    related = [...related, ...byDpto];
  }
}

const relatedWithCover = related.map((p) => ({
  ...p,
  coverUrl: resolveCoverUrl(p.portada),
}));
---

<RelatedProyectoReact
  client:visible
  subtitle={subtitle}
  projects={relatedWithCover}
  backQuery={backQuery}
/>
