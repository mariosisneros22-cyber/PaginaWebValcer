---
import type { ImageMetadata } from "astro";
import ProyectoExplorerReact from "./ProyectoExplorerReact.tsx";

import proyectos from "../../../data/proyectos.json";
import { assertValidProjects } from "../../../lib/projects";

assertValidProjects(proyectos);

type ImgModule = { default: ImageMetadata };




const imgs = import.meta.glob<ImgModule>(
  "../../../assets/images/proyecto/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

function resolveCoverUrl(relPath: string): string {
  const key = `../../../assets/images/proyecto/${relPath}`;
  const mod = imgs[key];
  if (!mod) return ""; // o throw si quieres ser estricto
  return mod.default.src; // ✅ URL serializable para React
}

const projectsWithCover = proyectos.map((p) => ({
  ...p,
  coverUrl: resolveCoverUrl(p.portada),
}));
---

<ProyectoExplorerReact client:load projects={projectsWithCover} />
