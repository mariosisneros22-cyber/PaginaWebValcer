---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Ubicacion = {
  departamento: string;
  provincia?: string;
  distrito?: string;
};

type Proyecto = {
  id: string;
  slug: string;
  nombre: string;
  estado: string;
  rubros?: string[];
  ubicacion: Ubicacion;
  resumen?: string;
};

const { project, cover } = Astro.props as {
  project: Proyecto;
  cover: ImageMetadata;
};
---

<a class="project-card" href={`/proyectos/${project.slug}`}>
  <div class="thumb">
    <Image src={cover} alt={project.nombre} />
  </div>

  <div class="body">
    <h3 class="title">{project.nombre}</h3>

    <p class="meta">
      {project.ubicacion.distrito ? `${project.ubicacion.distrito}, ` : ""}
      {project.ubicacion.departamento}
    </p>

    <div class="badges">
      <span class="badge">{project.estado}</span>
      {project.rubros?.slice(0, 2).map((r) => <span class="tag">{r}</span>)}
    </div>

    {project.resumen ? <p class="desc">{project.resumen}</p> : null}
  </div>

  <style>
    .project-card {
      display: block;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 14px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      background: rgba(255,255,255,.6);
    }

    .thumb { aspect-ratio: 16/10; background: rgba(0,0,0,.04); }
    .body { padding: 14px 14px 16px; }
    .title { margin: 0; font-size: 1.05rem; }
    .meta { margin: 6px 0 10px; opacity: .75; font-size: .95rem; }

    .badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 10px; }
    .badge, .tag {
      font-size: .8rem;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid rgba(0,0,0,.12);
    }

    .desc { margin: 0; opacity: .85; font-size: .95rem; }

    @media (prefers-reduced-motion: no-preference) {
      .project-card { transition: transform .2s ease, box-shadow .2s ease; }
      .project-card:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(0,0,0,.08); }
    }
  </style>
</a>
