---
import { Image } from 'astro:assets';

interface HeroButton{
  label: string;
  href: string;
}

interface Props {
  images: any[];
  titleImage: string;
  subtitle?: string;
  primaryButton?: HeroButton;
  secondaryButton?: HeroButton;
}

const { images, titleImage, subtitle, primaryButton, secondaryButton } = Astro.props;
---

<section class="hero" aria-label="Hero carousel">
  <div class="hero-slider" data-hero-slider>
    {images.map((image, index) => (
      <div class={`slide ${index === 0 ? 'active' : ''}`}>
        <Image 
          src={image} 
          alt={`Slide ${index + 1}`} 
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={index === 0 ? "high" : "auto"}
          format="avif"
          widths={[768, 1024, 1440, 1920]}
          sizes="100vw"
          quality={70}
        />
      </div>
    ))}
    
    <div class="hero-content">
      <div class="hero-container">
        <div class="hero-text">
          <img src={titleImage} alt="Valcer" class="hero-title-image" />

          {subtitle && <p class="hero-subtitle">{subtitle}</p>}

          <div class="hero-actions">
            {primaryButton && (
              <a href={primaryButton.href} class="btn btn-primary hero-btn">
                {primaryButton.label}
              </a>
            )}

            {secondaryButton && (
              <a href={secondaryButton.href} class="btn btn-secondary hero-btn hero-btn-outline">
                {secondaryButton.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
    
    <button 
      class="slide-btn prev" 
      data-slide-prev
      aria-label="Previous slide"
    ><img src="icons/arrow.svg" alt = ""></button>
    
    <button 
      class="slide-btn next" 
      data-slide-next
      aria-label="Next slide"
    > <img src="icons/arrow.svg" alt = ""></button>
    
    <div class="slide-indicators" role="tablist">
      {images.map((_, index) => (
        <button
          class={`indicator ${index === 0 ? 'active' : ''}`}
          data-slide-to={index}
          role="tab"
          aria-label={`Go to slide ${index + 1}`}
          aria-selected={index === 0}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: min(95vh, 900px);
    overflow: hidden;
  }
  .hero-text {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem; /* controla la separación vertical */
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    width: 100%;
    flex-wrap: wrap;

    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero-title-image {
    display: block;
    width: min(100%, 720px);
    height: auto;
  }

  .hero-subtitle {
    color: var(--color-white);
    font-size: var(--text-xl);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    text-align: center;
    max-width: 700px;
  }

  .hero-btn {
    min-width: 180px;
    justify-content: center;
    padding: 0.9rem 1.6rem;
    border-radius: 10px;
    font-size: var(--text-base);
  }

  .hero-btn-outline {
    color: var(--color-white);
    border-color: rgba(109, 186, 235, 0.85);
    background: rgba(255, 255, 255, 0.06);
  }

  .hero-btn-outline:hover {
    background: rgba(109, 186, 235, 0.18);
    color: var(--color-white);
  }
  .hero-slider {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-slider::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(16, 21, 52, 0.64), rgba(42, 43, 111, 0.42));
    z-index: 2;
    pointer-events: none;
  }

  .slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }

  .slide.active {
    opacity: 1;
  }

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
  }
  
  .hero-container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .slide-btn img {
    width: 42px;
    height: auto;
    display: block;
    filter: brightness(0) invert(1);
    transition: transform 0.25s ease, opacity 0.25s ease;
    opacity: 0.95;
  }

  .slide-btn.next img {
    transform: rotate(180deg);
  }

  .slide-btn:hover img {
    opacity: 1;
  }

  .slide-btn.prev:hover img {
    transform: translateX(-4px);
  }

  .slide-btn.next:hover img {
    transform: rotate(180deg) translateX(-4px);
  }

  .slide-btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .slide-btn.prev {
    left: 20px;
  }

  .slide-btn.next {
    right: 20px;
  }

  .slide-indicators {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    gap: 0.5rem;
  }

  .indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.42);
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }
  
  .indicator:hover {
    background: rgba(109, 186, 235, 0.72);
  }
  
  .indicator.active {
    background: var(--color-white);
  }
  
  @media (max-width: 768px) {
    .hero {
      height: 60vh;
    }
    
    .hero-container {
      padding: 0 1rem;
    }

    .hero-content h1 {
      font-size: var(--text-2xl);
    }

    .hero-content p {
      font-size: var(--text-xl);
    }

    .hero-actions {
      gap: 0.75rem;
    }

    .hero-btn {
      min-width: 150px;
      padding: 0.8rem 1.2rem;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      letter-spacing: 0.12em;
      margin-bottom: 1.5rem;
    }
        
    .slide-btn {
      padding: 0.5rem;
    }

    .slide-btn img {
      width: 34px;
    }
      
    .slide-indicators {
      bottom: 1rem;
    }
    
    .indicator {
      width: 8px;
      height: 8px;
    }
  }
</style>

<script>
  function initSlider() {
    const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
    if (!slider) return;

    let currentSlide = 0;
    const slides = slider.querySelectorAll('.slide');
    const indicators = slider.querySelectorAll('.indicator');
    const totalSlides = slides.length;
    const controller = new AbortController();
    const { signal } = controller;
    
    if (totalSlides === 0) return;
    
    let autoSlide: ReturnType<typeof setInterval> | null = null;

    function showSlide(index: number) {
      slides.forEach(slide => slide.classList.remove('active'));
      indicators.forEach(ind => {
        ind.classList.remove('active');
        ind.setAttribute('aria-selected', 'false');
      });
      
      slides[index].classList.add('active');
      indicators[index]?.classList.add('active');
      indicators[index]?.setAttribute('aria-selected', 'true');
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % totalSlides;
      showSlide(currentSlide);
    }

    function prevSlide() {
      currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
      showSlide(currentSlide);
    }

    function startAutoSlide() {
      if (autoSlide) clearInterval(autoSlide);
      autoSlide = setInterval(nextSlide, 5000);
    }

    function stopAutoSlide() {
      if (autoSlide) {
        clearInterval(autoSlide);
        autoSlide = null;
      }
    }

    // Event listeners para botones
    slider.querySelector<HTMLButtonElement>('[data-slide-prev]')?.addEventListener('click', () => {
      prevSlide();
      stopAutoSlide();
      startAutoSlide();
    }, { signal });

    slider.querySelector<HTMLButtonElement>('[data-slide-next]')?.addEventListener('click', () => {
      nextSlide();
      stopAutoSlide();
      startAutoSlide();
    }, { signal });

    // Event listeners para indicadores
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
        stopAutoSlide();
        startAutoSlide();
      }, { signal });
    });

    // Pausar en hover
    slider.addEventListener('mouseenter', stopAutoSlide, { signal });
    slider.addEventListener('mouseleave', startAutoSlide, { signal });

    // Pausar cuando tab está inactivo
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoSlide();
      } else {
        startAutoSlide();
      }
    }, { signal });

    startAutoSlide();

    // Cleanup function
    return () => {
      controller.abort();
      stopAutoSlide();
    };
  }

  // Ejecutar y guardar cleanup
  let cleanup: (() => void) | undefined;

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = initSlider();
  });

  document.addEventListener('astro:before-preparation', () => {
    cleanup?.();
  });
</script>
