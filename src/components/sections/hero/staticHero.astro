---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  image: any;
  imageAlt?: string;
}

const { title, image, imageAlt } = Astro.props;
---

<section class="page-hero" aria-label="Page header">
  <Image 
    src={image} 
    alt={imageAlt || `${title} hero background`}
    loading="eager"
    fetchpriority="high"
  />
  <div class="page-hero-content">
    <div class="hero-container">
      <h1>{title}</h1>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    width: 100%;
    height: clamp(300px, 50vh, 600px);
    overflow: hidden;
  }

  .page-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.6) 100%
    );
    z-index: 1;
  }

  .page-hero-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: 3rem;
    z-index: 2;
  }

  .hero-container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-hero-content h1 {
    color: white;
    font-size: var(--text-3xl);
    line-height: 1.2;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 768px) {
    .page-hero {
      height: clamp(250px, 40vh, 400px);
    }

    .page-hero-content {
      padding-bottom: 2rem;
    }

    .hero-container {
      padding: 0 1rem;
    }

    .page-hero-content h1 {
      font-size: var(--text-2xl);
    }
  }
</style>