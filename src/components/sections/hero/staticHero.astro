---
import { Image } from "astro:assets";

interface Props {
  title: string;
  image: ImageMetadata;
  eager?: boolean;
}

const { title, image, eager = true } = Astro.props;
---

<section class="page-hero" aria-label={title}>
  <div class="page-hero-media" aria-hidden="true">
    <Image
      src={image}
      alt={title}
      class="page-hero-img"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : "auto"}
      format="avif"
      widths={[640, 768, 1024, 1280, 1600, 1920]}
      sizes="100vw"
    />
  </div>

  <div class="page-hero-overlay" aria-hidden="true"></div>

  <div class="page-hero-content">
    <div class="container">
      <h1>{title}</h1>
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
    isolation: isolate;
  }

  .page-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero :global(.page-hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .page-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,.6), rgba(0,0,0,.3));
    z-index: 1;
    pointer-events: none;
  }

  .page-hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;

    display: flex;
    align-items: flex-end;
    justify-content: flex-start;

    padding-bottom: clamp(1.5rem, 4vh, 3rem); /* casi tocando el borde */
  }

  .page-hero-content .container {
    padding-left: clamp(2rem, 6vw, 5rem); /* separación izquierda */
  }

  .page-hero-content h1 {
    color: #fff;
    font-size: var(--text-3xl);
    margin: 0;
    text-align: left;
    text-shadow: 0 2px 8px rgba(0,0,0,.4);
  }

  @media (max-width: 768px) {
    .page-hero {
      min-height: 55vh;
    }

    .page-hero-content h1 {
      font-size: var(--text-2xl);
    }
  }
</style>
