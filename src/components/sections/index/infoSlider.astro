---
interface Slider {
  title: string;
  content: string;
  metric?: string;
  icon?: string;
}

interface Props {
  slider: Slider[];
  autoplayInterval?: number;
}

const { slider, autoplayInterval = 5000 } = Astro.props;
const sliderId = `slider-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="about-slider-fade" data-slider={sliderId}>
  <div class="cards-container">
    {slider.map((slide, index) => (
      <div
        class={`about-card ${index === 0 ? 'active' : ''}`}
        data-slide={index}
      >
        <div class="about-card__inner">
          <div class="slider-layout">
            {slide.metric && <span class="slider-metric">{slide.metric}</span>}

            <div class="slider-copy">
              <h3>{slide.title}</h3>
              <p>{slide.content}</p>
            </div>

            {slide.icon && (
              <div class="slider-icon">
                <img
                  src={slide.icon}
                  alt=""
                  aria-hidden="true"
                  width="96"
                  height="96"
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
</div>

  <div class="slider-controls">
    <div class="slider-indicators" role="tablist" aria-label="Slider navigation">
      {slider.map((_, index) => (
        <button
          class={`indicator ${index === 0 ? 'active' : ''}`}
          data-index={index}
          role="tab"
          aria-selected={index === 0}
          aria-label={`Slide ${index + 1} de ${slider.length}`}
        ></button>
      ))}
    </div>
  </div>
</div>

<style>
  .about-slider-fade {
    width: 100%;
  }

  .cards-container {
    position: relative;
    min-height: 290px;
    contain: layout style paint;
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(19, 24, 63, 0.98), rgba(42, 43, 111, 0.96) 52%, rgba(22, 27, 69, 0.98));
    box-shadow: 0 18px 44px rgba(42, 43, 111, 0.18);
  }

  .about-card {
    position: absolute;
    inset: 0;
    color: var(--color-white);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 900ms ease-in-out,
      visibility 0s 1400ms;
    will-change: opacity;
  }

  .about-card__inner {
    width: 100%;
    max-width: var(--container-width);
    min-height: 290px;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.2rem) 16px;
    display: flex;
    align-items: center;
    transform: translate3d(22px, 0, 0);
    opacity: 0;
    transition: transform 900ms ease-in-out, opacity 900ms ease-in-out;
    will-change: transform, opacity;
  }

  .about-card.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 900ms ease-in-out,
      visibility 0s 0s;
  }

  .about-card.active .about-card__inner {
    transform: translate3d(0, 0, 0);
    opacity: 1;
  }

  .about-card.leaving {
    opacity: 0;
    visibility: visible;
    pointer-events: none;
    transition:
      opacity 900ms ease-in-out;
  }

  .about-card.leaving .about-card__inner {
    transform: translate3d(-22px, 0, 0);
    opacity: 0;
  }

  .slider-layout {
    display: grid;
    grid-template-columns: auto minmax(320px, 560px) auto;
    align-items: center;
    gap: clamp(1rem, 2.8vw, 2.6rem);
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    justify-content: center;
  }

  .slider-copy {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .slider-metric {
    font-family: var(--font-secondary);
    font-size: clamp(4.5rem, 12vw, 8.8rem);
    font-weight: 780;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--color-secondary);
    white-space: nowrap;
  }

  .slider-copy h3 {
    font-size: clamp(1.3rem, 1.4vw + 1rem, 2rem);
    font-weight: 700;
    margin: 0;
    text-transform: uppercase;
    color: var(--color-white);
    max-width: 18ch;
  }

  .slider-copy p {
    font-size: clamp(0.98rem, 0.4vw + 0.92rem, 1.12rem);
    font-weight: 500;
    line-height: 1.72;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    max-width: 60ch;
  }

  .slider-icon {
    width: clamp(100px, 11vw, 156px);
    height: clamp(100px, 11vw, 156px);
    flex-shrink: 0;
    filter: brightness(0) invert(1);
    opacity: 0.94;
  }

  .slider-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slider-controls {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    width: max-content;
    z-index: 3;
  }

  .slider-indicators {
    display: flex;
    gap: 12px;
  }

  .indicator {
    width: 40px;
    height: 4px;
    background: rgba(255, 255, 255, 0.38);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .indicator.active {
    background: var(--color-white);
  }

  .indicator:hover:not(.active) {
    background: rgba(255, 255, 255, 0.72);
    transform: scaleY(1.5);
  }

  .indicator:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .cards-container {
      min-height: 420px;
    }

    .about-card__inner {
      min-height: 420px;
      padding-block: 1.75rem 3.75rem;
    }

    .slider-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
      text-align: center;
    }

    .slider-icon {
      width: 84px;
      height: 84px;
      margin: 0 auto;
      order: 3;
    }

    .slider-copy {
      align-items: center;
    }

    .slider-copy h3,
    .slider-copy p {
      max-width: none;
    }

    .slider-metric {
      justify-self: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-card {
      transition: none;
    }

    .about-card__inner {
      transition: none;
    }

    .indicator {
      transition: none;
    }
  }
</style>

<script define:vars={{ autoplayInterval, sliderId }}>
  window.__sliderInstances = window.__sliderInstances || {};

  function initAboutSlider() {
    const slider = document.querySelector(`[data-slider="${sliderId}"]`);
    if (!slider) return;

    if (window.__sliderInstances[sliderId]) {
      window.__sliderInstances[sliderId].cleanup();
    }

    let currentCard = 0;
    let autoplayTimer = null;
    const cards = slider.querySelectorAll('.about-card');
    const indicators = slider.querySelectorAll('.indicator');
    const totalCards = cards.length;

    if (totalCards === 0) return;

    function showCard(index) {
      if (index < 0 || index >= totalCards) return;

      const prev = cards[currentCard];
      const next = cards[index];

      if (prev && prev !== next) {
        prev.classList.remove('active');
        prev.classList.add('leaving');

        window.setTimeout(() => {
          prev.classList.remove('leaving');
        }, 1400);
      }

      indicators.forEach((ind) => {
        ind.classList.remove('active');
        ind.setAttribute('aria-selected', 'false');
      });

      next.classList.add('active');
      next.classList.remove('leaving');

      indicators[index].classList.add('active');
      indicators[index].setAttribute('aria-selected', 'true');

      currentCard = index;
    }

    function nextCard() {
      const nextIndex = (currentCard + 1) % totalCards;
      showCard(nextIndex);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(nextCard, autoplayInterval);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    const clickHandlers = [];
    indicators.forEach((indicator, index) => {
      const handler = () => {
        showCard(index);
        startAutoplay();
      };
      indicator.addEventListener('click', handler);
      clickHandlers.push({ element: indicator, handler });
    });

    const mouseEnterHandler = () => stopAutoplay();
    const mouseLeaveHandler = () => startAutoplay();

    slider.addEventListener('mouseenter', mouseEnterHandler);
    slider.addEventListener('mouseleave', mouseLeaveHandler);

    const visibilityHandler = () => {
      if (document.hidden) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    };
    document.addEventListener('visibilitychange', visibilityHandler);

    const cleanup = () => {
      stopAutoplay();

      clickHandlers.forEach(({ element, handler }) => {
        element.removeEventListener('click', handler);
      });
      slider.removeEventListener('mouseenter', mouseEnterHandler);
      slider.removeEventListener('mouseleave', mouseLeaveHandler);
      document.removeEventListener('visibilitychange', visibilityHandler);

      delete window.__sliderInstances[sliderId];
    };

    window.__sliderInstances[sliderId] = { cleanup };
    startAutoplay();
  }

  initAboutSlider();

  document.addEventListener('astro:before-preparation', () => {
    if (window.__sliderInstances[sliderId]) {
      window.__sliderInstances[sliderId].cleanup();
    }
  });
</script>
