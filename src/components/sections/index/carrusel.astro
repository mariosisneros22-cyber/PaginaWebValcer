---
import { Image } from "astro:assets";

interface Client {
  name: string;
  logo: ImageMetadata;
}

interface Props{
  clients: Client[];
}

const { clients } = Astro.props;
---


<div class="carrusel-wrapper">
  <div class="carrusel-track">
    {clients.map((client) => (
      <div class="cliente-logo">
        <div class="logo-box">
          <Image 
            src={client.logo} 
            alt={client.name} 
            loading="lazy"
            decoding="async"
            width={180}
            height={180}
            quality={70}
            sizes="(max-width: 768px) 140px, 180px"
            densities={[1, 2]}
          />
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .carrusel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .carrusel-track {
    display: flex;
    width: max-content; /* ✅ importante */
    gap: var(--spacing-md, 1.5rem);
    animation: scroll-infinite 60s linear infinite;
    will-change: transform;
  }

  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: clamp(120px, 12vw, 180px);
    height: clamp(120px, 12vw, 180px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .logo-box {
    width: 100%;
    height: 100%;
    padding: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-box img {
    opacity: 0.75;
    transition: opacity 0.25s ease;
    /* evita filter si notas jank: quítalo */
  }

  .cliente-logo:hover img { opacity: 1; }

  .logo-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .cliente-logo:hover :global(img) {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .carrusel-track { animation: none; transform: none; }
  }
  
  @keyframes scroll-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .cliente-logo {
      width: clamp(100px, 15vw, 140px);
      height: clamp(100px, 15vw, 140px);
    }

    .logo-box {
      padding: 1rem;
    }
  }
</style>

<script>
  function initCarrusel() {
    document.querySelectorAll('.carrusel-track').forEach((track) => {
      // ✅ idempotente: no volver a clonar si ya se hizo
      if (track.getAttribute('data-initialized') === 'true') return;
      track.setAttribute('data-initialized', 'true');

      const originals = Array.from(track.children);
      if (originals.length === 0) return;

      // Medir cuánto necesitamos duplicar para cubrir al menos 2 pantallas
      const wrapper = track.closest('.carrusel-wrapper');
      const targetWidth = (wrapper?.clientWidth ?? window.innerWidth) * 2;

      // Clonar hasta exceder targetWidth (máximo límite por seguridad)
      let guard = 0;
      while (track.scrollWidth < targetWidth && guard < 10) {
        originals.forEach((item) => {
          track.appendChild(item.cloneNode(true));
        });
        guard++;
      }

      // ✅ Duplicación final exacta 1 vez para loop perfecto (2 copias)
      originals.forEach((item) => {
        track.appendChild(item.cloneNode(true));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarrusel, { once: true });
  } else {
    initCarrusel();
  }

  document.addEventListener('astro:page-load', initCarrusel);
</script>