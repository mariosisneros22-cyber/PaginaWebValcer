---
import { Image } from "astro:assets";

interface Client {
  name: string;
  logo: ImageMetadata;
}

interface Props{
  clients: Client[];
}

const { clients } = Astro.props;
---

<section class="section clientes-seccion">
  <div class="carrusel-wrapper">
    <div class="carrusel-track">
      {clients.map((client) => (
        <div class="cliente-logo">
          <div class="logo-box">
            <Image 
              src={client.logo} 
              alt={client.name} 
              loading="eager"
              width={180}
              height={180}
              quality={80}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carrusel-wrapper {
    position: relative;
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .carrusel-track {
    display: flex;
    gap: var(--spacing-md, 1.5rem);
    animation: scroll-infinite 30s linear infinite;
    will-change: transform;
  }

  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: clamp(120px, 12vw, 180px);
    height: clamp(120px, 12vw, 180px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  .logo-box {
    width: 100%;
    height: 100%;
    padding: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .cliente-logo:hover :global(img) {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.05);
  }
  
  @keyframes scroll-infinite {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .cliente-logo {
      width: clamp(100px, 15vw, 140px);
      height: clamp(100px, 15vw, 140px);
    }

    .logo-box {
      padding: 1rem;
    }
  }
</style>

<script>
  function initCarrusel() {
    const tracks = document.querySelectorAll('.carrusel-track');
    
    tracks.forEach(track => {
      // Clonar TODO el contenido para duplicar
      const content = Array.from(track.children);
      
      // Duplicar suficientes veces para llenar la pantalla + loop
      const duplicates = 3; // Ajusta según necesites
      
      for (let i = 0; i < duplicates; i++) {
        content.forEach(item => {
          const clone = item.cloneNode(true) as HTMLElement;
          track.appendChild(clone);
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarrusel);
  } else {
    initCarrusel();
  }
  
  document.addEventListener('astro:page-load', initCarrusel);
</script>