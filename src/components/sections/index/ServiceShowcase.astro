---
import Button from '../../ui/button.astro';

interface Service {
  id: string;
  title: string;
  tagline: string;
  items: string[];
  imageSrc?: string;
}

interface Props {
  services: Service[];
}

const { services } = Astro.props;
const displayServices = services.slice(0, 4); // Show max 4 services
---

<section class="section section-alt">
  <div class="container">
    <div class="showcase-header">
      <h2>Nuestros Servicios</h2>
      <p>Soluciones integrales para tu proyecto con estándares de calidad internacional</p>
    </div>

    <div class="showcase-grid">
      {displayServices.map((service, index) => (
        <div class="showcase-card" data-service-id={service.id}>
          {service.imageSrc && (
            <div class="card-image">
              <img src={service.imageSrc} alt={service.title} loading="lazy" />
            </div>
          )}
          
          <div class="card-content">
            <h3 class="card-title">{service.title}</h3>
            <p class="card-tagline">{service.tagline}</p>
            
            <ul class="card-highlights">
              {service.items.slice(0, 2).map((item) => (
                <li>
                  <span class="highlight-dot"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <div class="card-arrow">→</div>
        </div>
      ))}
    </div>

    <div class="showcase-cta">
      <p>¿Necesitas una solución específica?</p>
      <Button href="/servicios" class="btn-large">
        Explorar todos los servicios
      </Button>
    </div>
  </div>
</section>

<style>

  .showcase-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .showcase-header h2 {
    font-size: var(--text-3xl);
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .showcase-header p {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    max-width: 60ch;
    margin: 0 auto;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: var(--spacing-lg);
  }

  .showcase-card {
    background: white;
    border: 1.5px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(34, 56, 80, 0.08);
  }

  .showcase-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(34, 56, 80, 0.12);
  }

  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: #f0f0f0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    flex: 1;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
    white-space: pre-line;
  }

  .card-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0 0 1.25rem 0;
  }

  .card-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-highlights li {
    font-size: 0.9rem;
    color: var(--color-text-lighter);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .highlight-dot {
    width: 4px;
    height: 4px;
    background: var(--color-primary);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .card-arrow {
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: 700;
    opacity: 1;
    transition: none;
    align-self: flex-start;
    padding: 0 2rem;
    padding-bottom: 1rem;
  }

  .showcase-cta {
    text-align: center;
    padding: var(--spacing-md) 0;
    border-top: 1px solid var(--color-border);
  }

  .showcase-cta p {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }

  .btn-large {
    padding: 0.9rem 2.5rem;
    font-size: var(--text-base);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    color: white;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: all var(--transition-normal);
    box-shadow: 0 4px 16px rgba(50, 56, 80, 0.2);
  }

  .btn-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(50, 56, 80, 0.3);
  }

  /* Tablet */
  @media (max-width: var(--bp-tablet)) {
    .showcase-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .showcase-header p {
      font-size: var(--text-base);
    }
  }

  /* Mobile */
  @media (max-width: var(--bp-mobile)) {
    .showcase-section {
      padding: var(--spacing-md) 0;
    }

    .showcase-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .showcase-header {
      margin-bottom: var(--spacing-md);
    }

    .showcase-header h2 {
      font-size: var(--text-2xl);
    }

    .card-title {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
