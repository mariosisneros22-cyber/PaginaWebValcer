---
interface Card {
  title: string;
  content: string;
  metric?: string;
  icon?: string;
}

interface Props {
  cards: Card[];
  autoplayInterval?: number;
}

const { cards, autoplayInterval = 5000 } = Astro.props;
---

<div class="about-slider-fade">
  <div class="cards-container">
    {cards.map((card, index) => (
      <div class={`about-card ${index === 0 ? 'active' : ''}`}>
        <div class="card-layout">
          <div class="card-content">
            {card.metric && <span class="card-metric">{card.metric}</span>}
            <h3>{card.title}</h3>
            <p>{card.content}</p>
          </div>
          {card.icon &&(
            <div class="card-icon">
              <img src={card.icon} alt="" aria-hidden="true" />
            </div>
          )}
          
        </div>
       
      </div>
    ))}
  </div>
  
  <div class="slider-controls">
    <div class="slider-indicators">
      {cards.map((_, index) => (
        <button 
          class={`indicator ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`Tarjeta ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</div>

<style>
  .about-slider-fade {
    width: 100%;
  }

  .cards-container {
    position: relative;
    min-height: 250px;
  }

  .about-card {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease-in-out;
    background: #ffffff;
    padding: 2.5rem;
    box-shadow: 0px 10px 5px -5px rgba(0,0,0,0.05);
    pointer-events: none;
  }

  .about-card.active {
    opacity: 1;
    pointer-events: auto;
  }
  .card-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-metric {
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .card-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .card-content p {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }
  .card-icon {
    width: 96px;
    height: 96px;
  }

  .card-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slider-controls {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-md);
  }

  .slider-indicators {
    display: flex;
    gap: 15px;
  }

  .indicator {
    width: 40px;
    height: 4px;
    background: #ccc;
    border: none;
    border-radius: 2px;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s ease;
  }

  .indicator.active {
    background: var(--color-primary);
  }

  .indicator:hover {
    background: #999;
  }

  @media (max-width: 768px) {
    .about-card {
      padding: 1.5rem;
    }

    .card-metric {
      font-size: 2.5rem;
    }
  }
</style>

<script define:vars={{ autoplayInterval }}>
  function initAboutSlider() {
    let currentCard = 0;
    let autoplayTimer = null;
    const cards = document.querySelectorAll('.about-card');
    const indicators = document.querySelectorAll('.indicator');
    const totalCards = cards.length;

    if (totalCards === 0) return;

    function showCard(index) {
      cards.forEach(card => card.classList.remove('active'));
      indicators.forEach(ind => ind.classList.remove('active'));
      
      cards[index].classList.add('active');
      indicators[index].classList.add('active');
      currentCard = index;
    }

    function nextCard() {
      const nextIndex = (currentCard + 1) % totalCards;
      showCard(nextIndex);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(nextCard, autoplayInterval);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        showCard(index);
        startAutoplay();
      });
    });

    const slider = document.querySelector('.about-slider-fade');
    if (slider) {
      slider.addEventListener('mouseenter', stopAutoplay);
      slider.addEventListener('mouseleave', startAutoplay);
    }

    startAutoplay();
  }

  document.addEventListener('astro:page-load', initAboutSlider);
</script>