---
import { Image } from "astro:assets";
import type { TimelineItemData } from "../../utils/timeline.ts";

type Side = "A" | "B";
type Layout = "intro" | "split";

type Props = TimelineItemData & {
  index: number;
  layout: Layout;
  side?: Side;
};

const { index, year, title, description, image, imageAlt, layout, side } = Astro.props as Props;
---

<article
  class="scene"
  data-scene
  data-index={index}
  data-layout={layout}
  data-side={side ?? undefined}
>
  <div class="scene-marker">
    <div class="scene-year">
      {layout === "intro" ? (
        <span class="year-horizontal">{year}</span>
      ) : (
        <span class="year-vertical">
          {year.split("").map((digit) => (
            <span class="year-digit">{digit}</span>
          ))}
        </span>
      )}
    </div>
    <div class="scene-dot" aria-hidden="true"></div>
  </div>

  <div class="scene-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>

  {image ? (
    <div class="scene-media">
      <Image src={image} alt={imageAlt ?? ""} loading="lazy" />
    </div>
  ) : null}
</article>

<style>
  .scene{
    position: absolute;
    inset: 0;
    display: none;

    /* GRID base */
    grid-template-columns: 1fr minmax(120px, 160px) 1fr;
    grid-template-rows: 1fr;
    align-items: center;

    padding: 12vh clamp(16px, 4vw, 48px);
    column-gap: clamp(16px, 4vw, 48px);
  }

  .scene.is-active{
    display: grid;
  }


  .scene.is-active{ display:grid; }

  /* Marker en columna central, centrado vertical */
  .scene-marker{
    grid-column: 2;
    justify-self: center;
    align-self: center;

    display:flex;
    flex-direction: column;   /* año arriba, dot abajo */
    align-items:center;
    gap: 10px;

    pointer-events:none;
  }

  /* Dot */
  .scene-dot{
    width:10px;
    height:10px;
    border-radius:999px;
    background:#333;
  }

  /* INTRO: contenido abajo centrado, sin media */
  .scene[data-layout="intro"]{
    grid-template-rows: auto auto;   /* marker arriba, contenido abajo */
    align-content: center;           /* centra el bloque (marker+content) en la pantalla */
    row-gap: 14px;                   /* separación entre dot y contenido */
  }

  .scene[data-layout="intro"] .scene-marker{
    grid-column: 2;
    grid-row: 1;
  }

  .scene[data-layout="intro"] .scene-content{
    grid-column: 2;
    grid-row: 2;

    justify-self: center;
    text-align: center;
    min-width: 50ch;
  }

  .scene[data-layout="intro"] .scene-media{ display:none; }

  /* SPLIT: texto e imagen en columnas opuestas */
  .scene[data-layout="split"]{
    align-items: center;     /* ya lo tienes en .scene, lo reafirmamos aquí */
  }

  .scene[data-layout="split"] .scene-content,
  .scene[data-layout="split"] .scene-media{
    grid-row: 1;
    align-self: center;
  }
  /* Para manejar textos largos sin romper */
  .scene-content{
    max-width: 65ch;
  }

  .scene-media{
    max-width: 520px;
    width: 100%;
  }

  .scene-media :global(img){
    width: 100%;
    height: auto;
    display:block;
    border-radius: 12px;
  }

  /* A: imagen izquierda / texto derecha */
  .scene[data-layout="split"][data-side="A"] .scene-media{
    grid-column: 1;
    place-self: center start;
  }

  .scene[data-layout="split"][data-side="A"] .scene-content{
    grid-column: 3;
    place-self: center end;
  }

  /* B: texto izquierda / imagen derecha */
  .scene[data-layout="split"][data-side="B"] .scene-content{
    grid-column: 1;
    place-self: center start;
  }

  .scene[data-layout="split"][data-side="B"] .scene-media{
    grid-column: 3;
    place-self: center end;
  }


  /* AÑO */
  .scene-year{
    line-height: 1;
  }

  .year-horizontal,
  .year-digit{
    font-weight: 700;
    font-size: clamp(5rem, 4vw, 3.5rem);
  }

  /* Vertical por dígitos */
  .year-vertical{
    display: flex;
    flex-direction: column;
    align-items: center;
  }


  /* Mobile fallback (lista normal) */
  @media (max-width:768px){
    .scene{
      position: static;
      display:block;
      padding: 1.5rem 0;
    }

    .scene.is-active{ display:block; }

    .scene-marker{
      margin-bottom: .5rem;
    }

    .scene-content, .scene-media{
      max-width: none;
    }
  }

</style>
