---
import type { TimelineItemData } from '../../utils/timeline';

import Dot from './Dot.astro'



type Props = TimelineItemData & { side: 'left' | 'right' };

const { 
  date, 
  title, 
  description,
  side,
} = Astro.props as Props;

---
<article class={`timeline-item ${side}`}>
  <div class="timeline-marker">
     <Dot />
    <time class="timeline-date" datetime={date}>{date}</time>
  </div>

  <div class="timeline-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .timeline-item{
  position: relative;
  width: 50%;
  box-sizing: border-box;

  display: grid;
  grid-template-columns: minmax(110px, auto) 1fr;
  grid-template-areas: "marker content";
  gap: 2rem;
  align-items: start;

  --branch: 3rem;

  opacity: 0;
  transform: translateY(24px);
  transition: opacity .35s ease, transform .35s ease;
}

.timeline-marker{ grid-area: marker; }
.timeline-content{ grid-area: content; }

/* Left / Right layout */
.timeline-item.left{
  grid-template-columns: 1fr minmax(110px, auto);
  grid-template-areas: "content marker";
  align-self: flex-start;
  padding-right: 3rem;
  text-align: right;
}

.timeline-item.right{
  align-self: flex-end;
  padding-left: 3rem;
  text-align: left;
}

/* Marker (dot + date) */
.timeline-marker{
  align-self: start;
  position: relative;
  min-width: 110px;

  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.75rem;
}

.timeline-item.left .timeline-marker{
  flex-direction: row-reverse;
  justify-content: flex-end;
}

/* Branch from center line to dot */
.timeline-marker::before{
  content: "";
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  height: 2px;
  width: var(--branch);
  background: #e5e5e5;
  opacity: 0;
  transition: opacity .2s ease, background-color .2s ease;
}

.timeline-item.right .timeline-marker::before{ left: calc(-1 * var(--branch)); }
.timeline-item.left  .timeline-marker::before{ right: calc(-1 * var(--branch)); }

.timeline-item.is-visible .timeline-marker::before{ opacity: 1; }
.timeline-item.is-active  .timeline-marker::before{ background: #333; }

/* Date */
.timeline-date{
  font-weight: 600;
  font-size: 0.9rem;
  color: #555;

  opacity: 0;
  transform: translateY(6px);
  transition: opacity .4s ease-out, transform .4s ease-out;
  transition-delay: calc(var(--delay, 0ms) + 80ms);
}

.timeline-item.is-visible .timeline-date{
  opacity: 1;
  transform: translateY(0);
}

/* Content */
.timeline-content h3{
  margin-bottom: 0.5rem;
  font-size: 1.25rem;
}

.timeline-content p{
  line-height: 1.6;
  max-width: 65ch;
}

/* Visible */
.timeline-item.is-visible{
  opacity: 1;
  transform: translateY(0);
}

/* Active vs inactive */
.timeline-item.is-visible:not(.is-active) .timeline-content{ opacity: 0.85; }
.timeline-item.is-active .timeline-content h3{ font-weight: 700; }

/* Dot + date emphasis */
.timeline-dot,
.timeline-date{
  transition: opacity .2s ease, transform .2s ease;
}

.timeline-item.is-visible:not(.is-active) .timeline-dot,
.timeline-item.is-visible:not(.is-active) .timeline-date{
  opacity: 0.6;
}

.timeline-item.is-active .timeline-dot,
.timeline-item.is-active .timeline-date{
  opacity: 1;
}

.timeline-item.is-active .timeline-dot{
  transform: scale(1.2);
}

/* Mobile */
@media (max-width: 768px){
  .timeline-item{
    width: 100%;
    padding: 0;
    text-align: left;

    transition: none !important;
    transform: none !important;
  }

  .timeline-marker{
    justify-content: flex-start;
    min-width: auto;
  }

  .timeline-marker::before{ display: none; }

  .timeline-content{ padding-left: 1rem; }

  .timeline-dot,
  .timeline-date{
    transition: none !important;
    transform: none !important;
  }
}


</style>
