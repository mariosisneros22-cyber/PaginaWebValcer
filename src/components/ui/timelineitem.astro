---
import { Image } from "astro:assets";
import type { TimelineItemData, TimelineLayout } from "../../utils/timeline.ts";

type Side = "A" | "B";

type Props = TimelineItemData & {
  index: number;
  layout: TimelineLayout;
  side?: Side;
};

const { index, year, title, description, image, imageAlt, layout, side, tagline } = Astro.props as Props;
---

<article
  class="scene"
  data-scene
  data-index={index}
  data-layout={layout}
  data-side={side ?? undefined}
>
  <div class="scene-marker">
    <div class="scene-year">
      {layout === "split" ? (
        <span class="year year-vertical" data-text={year.split("").join("\n")}>
          {year.split("").join("\n")}
        </span>
      ) : (
        <span class="year year-horizontal" data-text={year}>
          {year}
        </span>
      )}
    </div>
    <div class="scene-dot" aria-hidden="true"></div>
  </div>

  <div class="scene-content">
    {layout === "outro" ? (
      <p class="scene-tagline">{tagline ?? ""}</p>
    ) : (
      <>
        <h2>{title}</h2>
        <p>{description}</p>
      </>
    )}
  </div>

  {image ? (
    <div class="scene-media">
      <Image src={image} alt={imageAlt ?? ""} loading="lazy" />
    </div>
  ) : null}
</article>

<style>
  .scene{
    position: absolute;
    inset: 0;
    display: none;

    /* GRID base */
    grid-template-columns: 1fr minmax(120px, 160px) 1fr;
    grid-template-rows: 1fr;
    align-items: center;

    padding: 12vh clamp(16px, 4vw, 48px);
    column-gap: clamp(16px, 4vw, 48px);
  }

  .scene.is-active{
    display: grid;
  }

  .scene-content{

    max-width: 60ch;

    background: white;
    padding: 0.75rem 1rem;
    border-radius: 12px;
  }
  
  /* Marker en columna central, centrado vertical */
  .scene-marker{
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    align-self: center;

    display:flex;
    flex-direction: column;   /* año arriba, dot abajo */
    align-items:center;
    gap: 10px;

    pointer-events:none;
  }

  /* Dot */
  .scene-dot{
    width:10px;
    height:10px;
    border-radius:999px;
    background:#333;
  }

  /* INTRO: contenido abajo centrado, sin media */
  .scene[data-layout="intro"], .scene[data-layout="outro"]{
    grid-template-rows: auto auto;   /* marker arriba, contenido abajo */
    align-content: center;           /* centra el bloque (marker+content) en la pantalla */
    row-gap: 14px;                   /* separación entre dot y contenido */
  }

  .scene[data-layout="intro"] .scene-marker{
    grid-column: 2;
    grid-row: 1;

  }

  .scene[data-layout="intro"] .scene-content{
    grid-column: 2;
    grid-row: 2;

    justify-self: center;
    text-align: center;
    min-width: 50ch;

    font-size: x-large;
  }

  .scene[data-layout="intro"] .scene-media{ display:none; }

  /* SPLIT: texto e imagen en columnas opuestas */

  .scene[data-layout="split"] .scene-content,
  .scene[data-layout="split"] .scene-media{
    grid-row: 1;
    align-self: center;

    width: 100%;
  }
  /* Para manejar textos largos sin romper */

  .scene-media{
    max-width: min(48vw, 900px);
  }

  .scene-media :global(img){
    width: 100%;
    height: 75vh;
    object-fit: cover;
    display: block;
    
  }

  .scene[data-layout="split"] .scene-content{
    font-size: large;
  }
  /* A: imagen izquierda / texto derecha */
  .scene[data-layout="split"][data-side="A"] .scene-media{
    grid-column: 1 / 2;
    justify-self: stretch;
  }

  .scene[data-layout="split"][data-side="A"] .scene-content{
    grid-column: 3;
    place-self: center end;
  }

  /* B: texto izquierda / imagen derecha */
  .scene[data-layout="split"][data-side="B"] .scene-content{
    grid-column: 1;
    place-self: center start;
  }

  .scene[data-layout="split"][data-side="B"] .scene-media{
    grid-column: 3 / 4;
    justify-self: stretch;
  }


  /* AÑO */
  .scene-year{
    line-height: 1;
    padding: 0.15em 0.25em;   /* placa */
    background: white;
    border-radius: 12px;
  }


  /* tipografía común */
  .year{
    font-weight: 700;
    font-size: clamp(5rem, 6vw, 6rem);
    line-height: 1;

    position: relative;
    display: inline-block;

    /* ✅ base visible */
    color: #999;
  }

  /* vertical apilado */
  .year-vertical{
    white-space: pre-line;
    text-align: center;
  }

  /* overlay: el “relleno” */
  .year::after{
    content: attr(data-text);
    position: absolute;
    inset: 0;

    white-space: inherit;
    text-align: inherit;

    color: transparent;
    -webkit-text-fill-color: transparent;

    background-image: linear-gradient(#111, #111);
    background-repeat: no-repeat;

    -webkit-background-clip: text;
    background-clip: text;

    pointer-events: none;
  }

  /* relleno horizontal (izq→der) */
  .year-horizontal::after{
    background-size: calc(var(--fill, 0) * 100%) 100%;
    background-position: 0 0;
  }

  /* relleno vertical (abajo→arriba) */
  .year-vertical::after{
    background-size: 100% calc(var(--fill, 0) * 100%);
    background-position: 0 100%;
  }





  /*OUTRO */
  /* OUTRO: bloque centrado, lema debajo del dot */
  .scene[data-layout="outro"] .scene-marker{
    grid-column: 2;
    grid-row: 1;
  }

  .scene[data-layout="outro"] .scene-content{
    grid-column: 1 / 4;
    grid-row: 2;
    justify-self: center;
    text-align: center;
    max-width: 70ch;

    font-size: xx-large;
  }

  .scene-tagline{
    margin: 0;
  }
  .scene[data-layout="outro"] .scene-media{ display:none; }


  /*degradado imagen*/
  .scene-marker{ z-index: 3; }
  .scene-content{ z-index: 2; }
  .scene-media{ z-index: 1; position: relative; }
  
  .scene-media :global(picture){
    display: block;
    width: 100%;
  }
  
  .scene[data-layout="split"][data-side="A"] .scene-media{
    -webkit-mask-image: linear-gradient(to right, #000 0%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to right, #000 0%, #000 72%, transparent 100%);
  }

  .scene[data-layout="split"][data-side="B"] .scene-media{
    -webkit-mask-image: linear-gradient(to left, #000 0%, #000 72%, transparent 100%);
    mask-image: linear-gradient(to left, #000 0%, #000 72%, transparent 100%);
  }

  
  /* Mobile fallback (lista normal) */
  @media (max-width:768px){
    .scene{
      position: static;
      display:block;
      padding: 1.5rem 0;
    }

    .scene.is-active{ display:block; }

    .scene-marker{
      margin-bottom: .5rem;
    }

    .scene-content, .scene-media{
      max-width: none;
    }
  }

</style>
