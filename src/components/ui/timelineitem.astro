---
import { Image } from 'astro:assets';
import type { TimelineItemData } from '../../utils/timeline';
import Dot from './Dot.astro';

type Props = TimelineItemData & { side: 'left' | 'right' };

const {
  date,
  title,
  description,
  side,
  image,
  imageAlt,
} = Astro.props as Props;
---

<article class={`timeline-item ${side}`}>
  <!-- Columna izquierda -->
  <div class="timeline-col timeline-col-left">
    {side === 'left' ? (
      <div class="timeline-content-inner">
        <h3>{title}</h3>
        <p>{description}</p>
      </div>
    ) : (
      image ? (
        <div class="timeline-media-inner">
          <Image src={image} alt={imageAlt ?? ''} class="timeline-image" loading="lazy" />
        </div>
      ) : null
    )}
  </div>

  <!-- Centro -->
  <div class="timeline-marker">
    <div class="timeline-marker-inner">
      <Dot />
      <time class="timeline-date" datetime={date}>{date}</time>
    </div>
  </div>

  <!-- Columna derecha -->
  <div class="timeline-col timeline-col-right">
    {side === 'right' ? (
      <div class="timeline-content-inner">
        <h3>{title}</h3>
        <p>{description}</p>
      </div>
    ) : (
      image ? (
        <div class="timeline-media-inner">
          <Image src={image} alt={imageAlt ?? ''} class="timeline-image" loading="lazy" />
        </div>
      ) : null
    )}
  </div>
</article>

<style>
  .timeline-item{
    width: 100%;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: 1fr minmax(110px, auto) 1fr;
    grid-template-areas: "left marker right";
    gap: 2rem;
    align-items: start;

    --branch: 3rem;

    min-height: 100vh;
    padding-block: 0;

    /* reveal */
    --x: 0px;
    --y: 24px;
    transform: translate(var(--x), var(--y));
    opacity: 0;
    transition: opacity .35s ease, transform .35s ease;
  }

  .timeline-item.is-visible{
    opacity: 1;
    --x: 0px;
    --y: 0px;
  }

  /* columnas */
  .timeline-col-left{ grid-area: left; }
  .timeline-col-right{ grid-area: right; }

  /* reveal X por lado (solo animación, NO cambies grid aquí) */
  .timeline-item.left{ --x: -32px; }
  .timeline-item.right{ --x: 32px; }

  /* =========================
     Sticky (escena)
     ========================= */

  .timeline-marker{
    grid-area: marker;
    position: sticky;
    top: 45vh;
    transform: translateY(-50%);
    z-index: 2;
  }

  .timeline-content-inner,
  .timeline-media-inner{
    position: sticky;
    top: 45vh;
    transform: translateY(-0.5rem);
    z-index: 1;
  }

  /* alineación del contenido según lado */
  .timeline-item.left .timeline-content-inner{
    text-align: right;
    margin-left: auto;
  }
  .timeline-item.right .timeline-content-inner{
    text-align: left;
    margin-right: auto;
  }

  /* =========================
     Marker layout + branch
     ========================= */

  .timeline-marker-inner{
    position: relative;
    min-width: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

    /* LEFT: reverse para que la fecha quede hacia afuera (izq) y el dot quede más cerca del eje */
  .timeline-item.left .timeline-marker-inner{
    flex-direction: row-reverse;
  }

  /* RIGHT: normal */
  .timeline-item.right .timeline-marker-inner{
    flex-direction: row;
  }

  .timeline-item{ --dot-shift: 10px; }

  /* left: desplaza el dot hacia la izquierda del eje */
  .timeline-item.left .timeline-dot{
    margin-left: calc(-1 * var(--dot-shift));
  }

  /* right: desplaza el dot hacia la derecha del eje */
  .timeline-item.right .timeline-dot{
    margin-left: var(--dot-shift);
  }
  .timeline-dot{
    transform: translateX(var(--dot-shift));
  }

  /* =========================
     Date + Dot states
     ========================= */

  .timeline-date{
    font-weight: 600;
    font-size: 0.9rem;
    color: #555;
    line-height: 1;
    display: inline-block;

    opacity: 0;
    --ty: 6px;
    transform: translateY(var(--ty));
    transition: opacity .4s ease-out, transform .4s ease-out;
    transition-delay: calc(var(--delay, 0ms) + 80ms);
  }

  .timeline-item.is-visible .timeline-date{
    opacity: 1;
    --ty: 0px;
  }

  .timeline-dot{
    transition: transform .2s ease, opacity .2s ease;
  }

  .timeline-item.is-visible:not(.is-active) .timeline-dot,
  .timeline-item.is-visible:not(.is-active) .timeline-date{
    opacity: 0.6;
  }

  .timeline-item.is-active .timeline-dot{ transform: scale(1.2); }
  .timeline-item.is-active .timeline-dot,
  .timeline-item.is-active .timeline-date{ opacity: 1; }


  .timeline-item.right .timeline-col-left .timeline-media-inner{ margin-left: auto; }
  .timeline-item.left  .timeline-col-right .timeline-media-inner{ margin-right: auto; }
  /* =========================
     Content typography (FIX)
     ========================= */

  .timeline-content-inner h3{
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }

  .timeline-content-inner p{
    line-height: 1.6;
    max-width: 65ch;
  }

  /* media */
  .timeline-image{
    display: block;
    width: 100%;
    max-width: 520px;
    height: auto;
    border-radius: 16px;
  }

  /* =========================
     Mobile
     ========================= */

  @media (max-width: 768px){
    .timeline-item{
      grid-template-columns: 1fr;
      grid-template-areas:
        "marker"
        "left"
        "right";
      min-height: auto;
      opacity: 1;
      transform: none;
      transition: none !important;
    }

    .timeline-marker{
      position: relative;
      top: auto;
      transform: none;
    }

    .timeline-content-inner,
    .timeline-media-inner{
      position: static;
      transform: none;
    }

    .timeline-marker-inner{
      justify-content: flex-start;
      min-width: auto;
    }

    .timeline-marker-inner::before{ display: none; }

    .timeline-dot,
    .timeline-date{
      transition: none !important;
      transform: none !important;
    }

    .timeline-item.left .timeline-content-inner{
      text-align: left;
      margin: 0;
    }
  }
</style>
