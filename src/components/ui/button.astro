---
interface Props {
  href?: string;
  variant?: 'primary';
  class?: string;
  type?: 'button' | 'submit' | 'reset'; 
  disabled?: boolean;                   
}

const {
  href,
  variant = 'primary',
  class: extraClass = '',
  type = 'button',
  disabled = false,
} = Astro.props;
---

{href ? (
  <a
    href={href}
    class={`btn btn-${variant} ${extraClass}`}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={`btn btn-${variant} ${extraClass}`}
    disabled={disabled}
  >
    <slot />
  </button>
)}
