---
import Layout from '../layouts/Layout.astro';
import contactoHero from '../assets/images/contacto/contactoHero.jpg';


import ContactForm from '../components/sections/contacto/ContactForm.astro';
import ContactInfo from '../components/sections/contacto/ContactInfo.astro';
import ContactMap from '../components/sections/contacto/ContactMap.astro';

---

<Layout title="Valcer - Contacto" heroTitle="Contacto" heroImage={contactoHero}>


<section class="section">
  <div class="container contact-grid">
    <ContactForm />
    <ContactInfo />
  </div>

  <div class="map-wrap">
    <div class="container">
      <ContactMap />
    </div>
  </div>
</section>
  <!-- Resto del contenido -->
</Layout>

<style>

  .contact-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* “Levanta” visual: paneles tipo card */
  :global(.contact-form),
  :global(.info-block) {
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 14px;
    padding: 1.75rem;
    box-shadow: 0 12px 34px rgba(0,0,0,.08);
  }

  :global(.contact-form) {
    border-top: 4px solid rgba(0,0,0,.08); /* acento sutil sin colores */
  }

  /* separación del mapa */
  .map-wrap {
    margin-top: 2.25rem;
  }

  /* card para el mapa */
  :global(.map-block) {
    background: #fff;
    border: 1px solid #e7e7e7;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
  }

  /* (luego veremos móvil, pero lo dejo) */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>