---
import Layout from '../layouts/Layout.astro';
import contactoHero from '../assets/images/contacto/contactoHero.jpg';


import ContactForm from '../components/sections/contacto/ContactForm.astro';
import ContactInfo from '../components/sections/contacto/ContactInfo.astro';
import ContactMap from '../components/sections/contacto/ContactMap.astro';

---

<Layout title="Valcer - Contacto" heroTitle="Contacto" heroImage={contactoHero}>


<section class="section">
  <div class="container contact-grid">
    <ContactForm />
    <ContactInfo />
  </div>

  <div class="map-wrap">
    <div class="container">
      <ContactMap />
    </div>
  </div>
</section>
  <!-- Resto del contenido -->
</Layout>

<style>

  .contact-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* “Levanta” visual: paneles tipo card */
  :global(.contact-form),
  :global(.info-block) {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.75rem;
    box-shadow: var(--shadow-md);
  }

  :global(.contact-form) {
    border-top: 4px solid rgba(109, 186, 235, 0.55);
  }

  /* separación del mapa */
  .map-wrap {
    margin-top: 2.25rem;
  }

  /* card para el mapa */
  :global(.map-block) {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  /* (luego veremos móvil, pero lo dejo) */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
