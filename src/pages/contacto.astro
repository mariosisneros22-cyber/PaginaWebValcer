---
import Layout from '../layouts/Layout.astro';
import contactoHero from '../assets/images/contacto/contactoHero.jpg';


import ContactForm from '../components/sections/contacto/ContactForm.astro';
import ContactInfo from '../components/sections/contacto/ContactInfo.astro';
import ContactMap from '../components/sections/contacto/ContactMap.astro';

---

<Layout title="Valcer - Contacto" heroTitle="Contacto" heroImage={contactoHero}>


<section class="section">
  <div class="container contact-grid">
    <ContactForm />
    <ContactInfo />
  </div>

  <div class="map-wrap">
    <div class="container">
      <ContactMap />
    </div>
  </div>
</section>
  <!-- Resto del contenido -->
</Layout>

<style>

  .contact-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* “Levanta” visual: paneles tipo card */
  :global(.contact-form),
  :global(.info-block) {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(42, 43, 111, 0.08);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 10px 22px rgba(32, 39, 87, 0.06);
  }

  /* separación del mapa */
  .map-wrap {
    margin-top: 2.25rem;
  }

  /* card para el mapa */
  :global(.map-block) {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(42, 43, 111, 0.08);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 22px rgba(32, 39, 87, 0.06);
  }

  /* (luego veremos móvil, pero lo dejo) */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    :global(.contact-form),
    :global(.info-block) {
      padding: 1.2rem;
      border-radius: 14px;
    }

    :global(.map-block) {
      border-radius: 14px;
    }
  }
</style>
