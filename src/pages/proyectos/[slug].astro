---
export const prerender = true;

import MiniMapProyecto from "../../components/sections/proyectos/react/MiniMapProyecto.tsx"
import Layout from "../../layouts/Layout.astro";
import { Image , getImage} from "astro:assets";
import proyectoHero from "../../assets/images/proyecto/proyectoHero.jpg";

import proyectos from "../../data/proyectos.json";
import { isVisibleProject, assertValidProjects, estadoToKey, formatEstadoLabel, formatMonto, formatSimpleLabel, getUniqueProjectsBySlug } from "../../lib/projects";
import { getProjectImageFromPath } from "../../utils/proyectoImages";

import RelatedProyecto from "../../components/sections/proyectos/astro/RelatedProyecto.astro";

import ProyectoGallery from "../../components/sections/proyectos/react/ProyectoGallery.tsx";


export function getStaticPaths() {
  return getUniqueProjectsBySlug(proyectos.filter(isVisibleProject)).map((p) => ({ params: { slug: p.slug } }));
}
assertValidProjects(proyectos);

const { slug } = Astro.params;
const proyecto = proyectos.find((p) => p.slug === slug);

const backQuery = Astro.url.search ?? "";

if (!proyecto || !isVisibleProject(proyecto)) {
  return Astro.redirect("/proyectos");
}


const estadoKey = estadoToKey(proyecto.estado);
const portada = getProjectImageFromPath(proyecto.portada) ?? proyectoHero;

const galeria = await Promise.all(
  (proyecto.galeria ?? [])
    .filter((g) => !!getProjectImageFromPath(g.src))
    .map(async (g) => {
    const srcMeta = getProjectImageFromPath(g.src)!;
    const alt = g.alt ?? proyecto.nombre;

    // Thumb real para la columna de miniaturas
    const thumb = await getImage({
      src: srcMeta,
      width: 140,
      format: "webp",
      quality: 60,
    });

    // Grid (3 columnas)
    const grid = await getImage({
      src: srcMeta,
      width: 520,
      format: "webp",
      quality: 70,
    });

    // Modal (pantalla grande, pero no exagerado)
    const modal = await getImage({
      src: srcMeta,
      width: 1200,
      format: "webp",
      quality: 80,
    });

    return {
      alt,

      thumbSrc: thumb.src,
      thumbSrcset: thumb.srcSet.attribute,
      thumbSizes: "140px",

      gridSrc: grid.src,
      gridSrcset: grid.srcSet.attribute,
      gridSizes: "(max-width: 900px) 100vw, 33vw",

      modalSrc: modal.src,
      modalSrcset: modal.srcSet.attribute,
      modalSizes: "(max-width: 900px) 100vw, 70vw",
    };
  })
);


const title = `Valcer - ${proyecto.nombre}`;
---

<Layout title={title} heroTitle={proyecto.nombre} heroImage={portada}>
  <section class="proyecto-container">
    <a class="proyecto-back" href={`/proyectos${backQuery}`} data-proyectos-back>Volver a proyectos</a>

    {/* MAPA FULL */}
    <section class="proyecto-mapwide">
      {typeof proyecto.ubicacion?.lng === "number" && typeof proyecto.ubicacion?.lat === "number" ? (
        <>
          <header class="block-head">
            <h2>Ubicación</h2>
            <p class="muted">
              {proyecto.ubicacion.distrito}, {proyecto.ubicacion.departamento}
            </p>
          </header>

          <div class="map-card">
            <MiniMapProyecto client:visible lng={proyecto.ubicacion.lng} lat={proyecto.ubicacion.lat} zoom={14} />
          </div>
        </>
      ) : (
        <div class="mapEmpty">Sin coordenadas para este proyecto.</div>
      )}
    </section>

    {/* 2 COLS: FICHA + RESUMEN */}
    <section class="proyecto-grid2">
      <section class="proyecto-tech">
        <header class="tech-header"><h2>Ficha técnica</h2></header>
        <div class="tech-grid">
          <div class="tech-item">
            <span class="tech-label">Cliente</span>
            <span class="tech-value">{proyecto.cliente}</span>
          </div>


          <div class="tech-item">
            <span class="tech-label">Estado</span>
            <span class={`tech-badge estado-${estadoKey}`}>
              {formatEstadoLabel(estadoKey)}
            </span>
          </div>

          

          <div class="tech-item">
            <span class="tech-label">Inicio</span>
            <span class="tech-value">{proyecto.fecha_inicio}</span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Fin</span>
            <span class="tech-value">
              {proyecto.fecha_fin ?? "En ejecución"}
            </span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Monto</span>
            <span class="tech-value">
              {typeof proyecto.monto === "number" ? formatMonto(proyecto.monto) : "No disponible"}
            </span>
          </div>

          <div class="tech-item tech-item--full">
            <span class="tech-label">Servicios</span>

            {(proyecto.servicios?.length ?? 0) > 0 ? (
              <div class="tech-chips">
                {proyecto.servicios!.map((s) => (
                  <span class="tag">{formatSimpleLabel(s)}</span>
                ))}
              </div>
            ) : (
              <span class="tech-value">—</span>
            )}
          </div>
        </div>
      </section>

      {proyecto.resumen ? (
        <section class="proyecto-resumen">
          <header class="tech-header"><h2>Resumen</h2></header>
          <p class="resumen-text">{proyecto.resumen}</p>
        </section>
      ) : (
        <section class="proyecto-resumen">
          <header class="tech-header"><h2>Resumen</h2></header>
          <p class="resumen-text">—</p>
        </section>
      )}
    </section>

    {/* GALERÍA FULL */}
    {(galeria?.length ?? 0) > 0 ? (
      <section class="proyecto-fotos">
        <header class="block-head"><h2>Registro fotográfico</h2></header>
        <ProyectoGallery client:visible images={galeria} />
      </section>
    ) : null}

    {/* RELACIONADOS FULL */}
    <section class="proyecto-related">
      <RelatedProyecto currentSlug={proyecto.slug} limit={3} />
    </section>
  </section>
</Layout>

<style is:global>


  .proyecto-back{
    display:inline-flex;
    align-items:center;
    gap:8px;

    padding:8px 14px;

    border-radius: 999px;
    background: rgba(109, 186, 235, 0.08);

    font-size: var(--text-sm);
    font-weight:500;
    text-decoration:none;
    color: var(--color-primary);

    transition: background .2s ease, transform .2s ease;
  }

  .proyecto-back:hover{
    background: rgba(109, 186, 235, .16);
    transform: translateX(-2px);
  }

  .proyecto-back::before{
    content: "←";
    font-size: var(--text-sm);
    opacity: .8;
  }
  .proyecto-fotos{
    margin-top: 28px;
  }

  .proyecto-related{
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid rgba(42, 43, 111, .08);
  }
  .proyecto-mapwide { margin: 14px 0 18px; }


  .proyecto-grid2{
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 18px;
    align-items: start;
    margin-bottom: 18px;
  }

  .block-head{
    display:flex;
    flex-direction:column;
    gap:6px;
    margin: 0 0 10px;
  }

  .block-head h2{ 
    font-size: var(--text-xl);
    margin:0; 
    font-weight: 750; 
  }

  .muted{ margin:0; opacity:.75; font-size:var(--text-sm); }


  .proyecto-container { max-width: 1100px; margin: 0 auto; padding: 24px 16px 44px; }

  .proyecto-tech,
  .proyecto-resumen{
    padding: 22px;
    border: 1px solid rgba(42, 43, 111, .08);
    border-radius: 14px;
    background: rgba(255, 255, 255, .86);

  }

  .tech-header { margin-bottom: 18px; }

  .tech-header h2 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
  }

  /* ✅ 3 columnas: Cliente | Estado | Ubicación */
  .tech-grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px 22px;
  }

  .tech-item{
    display:flex;
    flex-direction:column;
    gap:6px;
  }

  /* ✅ Servicios full width dentro de ficha */
  .tech-item--full{
    grid-column: 1 / -1;
  }

  .tech-label{
    font-size: var(--text-xs);
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .6;
  }

  .tech-value{
    font-size: var(--text-base);
    font-weight: 500;
  }

  /* chips dentro de ficha técnica */
  .tech-chips{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top: 8px;
  }

  /* -------------------------------------------------- */
  /* Detalles del proyecto (resumen + fotos) */


  .resumen-text{
    margin: 0;
    opacity: .9;
    text-align: justify;
  }

  /* -------------------------------------------------- */
  /* minimapa */
  .miniMap{
    width: 100%;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
  }

  .mapEmpty{
    display:flex;
    align-items:center;
    justify-content:center;
    height: 260px;
    border-radius: 12px;
    background: rgba(109, 186, 235, .08);
    border: 1px dashed rgba(42, 43, 111, .18);
    font-size: var(--text-sm);
  }



  /* -------------------------------------------------- */
  /* responsive */
  @media (max-width: 900px){

    .tech-grid{ grid-template-columns: 1fr; }
    .tech-item--full{ grid-column: auto; }
  
    .proyecto-grid2{ grid-template-columns: 1fr; }
  }


</style>

