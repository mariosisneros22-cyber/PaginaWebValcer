---
export const prerender = true;

import MiniMapProyecto from "../../components/sections/proyectos/react/MiniMapProyecto.tsx"
import Layout from "../../layouts/Layout.astro";
import { Image , getImage} from "astro:assets";
import type { ImageMetadata } from "astro";

import proyectos from "../../data/proyectos.json";
import { isVisibleProject, assertValidProjects, estadoToKey, formatEstadoLabel, formatSimpleLabel } from "../../lib/projects";

import RelatedProyecto from "../../components/sections/proyectos/astro/RelatedProyecto.astro";

import ProyectoGallery from "../../components/sections/proyectos/react/ProyectoGallery.tsx";


export function getStaticPaths() {
  return proyectos.filter(isVisibleProject).map((p) => ({ params: { slug: p.slug } }));
}
assertValidProjects(proyectos);

const { slug } = Astro.params;
const proyecto = proyectos.find((p) => p.slug === slug);

if (!proyecto || !isVisibleProject(proyecto)) {
  return Astro.redirect("/proyectos");
}


const estadoKey = estadoToKey(proyecto.estado);

type ImgModule = { default: ImageMetadata };

const imgs = import.meta.glob<ImgModule>(
  "../../assets/images/proyecto/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

function resolveImg(relPath: string): ImageMetadata {
  const key = `../../assets/images/proyecto/${relPath}`;
  const mod = imgs[key];
  if (!mod) throw new Error(`Imagen no encontrada: ${key}`);
  return mod.default;
}

const portada = resolveImg(proyecto.portada);

const galeria = await Promise.all(
  (proyecto.galeria ?? []).map(async (g) => {
    const srcMeta = resolveImg(g.src);
    const alt = g.alt ?? proyecto.nombre;

    // Thumb real para la columna de miniaturas
    const thumb = await getImage({
      src: srcMeta,
      width: 140,
      format: "webp",
      quality: 60,
    });

    // Grid (3 columnas)
    const grid = await getImage({
      src: srcMeta,
      width: 520,
      format: "webp",
      quality: 70,
    });

    // Modal (pantalla grande, pero no exagerado)
    const modal = await getImage({
      src: srcMeta,
      width: 1200,
      format: "webp",
      quality: 80,
    });

    return {
      alt,

      thumbSrc: thumb.src,
      thumbSrcset: thumb.srcSet.attribute,
      thumbSizes: "140px",

      gridSrc: grid.src,
      gridSrcset: grid.srcSet.attribute,
      gridSizes: "(max-width: 900px) 100vw, 33vw",

      modalSrc: modal.src,
      modalSrcset: modal.srcSet.attribute,
      modalSizes: "(max-width: 900px) 100vw, 70vw",
    };
  })
);


const title = `Valcer - ${proyecto.nombre}`;
---

<Layout title={title} heroTitle={proyecto.nombre} heroImage={portada}>
  <section class="proyecto-container">

    <a class="proyecto-back" href="/proyectos" data-proyectos-back>
      ← Volver a proyectos
    </a>

    <section class="proyecto-top">
      <section class="proyecto-tech">
        <header class="tech-header">
          <h2>Ficha técnica</h2>
        </header>

        <div class="tech-grid">
          <div class="tech-item">
            <span class="tech-label">Cliente</span>
            <span class="tech-value">{proyecto.cliente}</span>
          </div>


          <div class="tech-item">
            <span class="tech-label">Ubicación</span>
            <span class="tech-value">
              {proyecto.ubicacion.distrito}, {proyecto.ubicacion.departamento}
            </span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Estado</span>
            <span class={`tech-badge estado-${estadoKey}`}>
              {formatEstadoLabel(estadoKey)}
            </span>
          </div>

          

          <div class="tech-item">
            <span class="tech-label">Inicio</span>
            <span class="tech-value">{proyecto.fecha_inicio}</span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Fin</span>
            <span class="tech-value">
              {proyecto.fecha_fin ?? "En ejecución"}
            </span>
          </div>

          <div class="tech-item tech-item--full">
            <span class="tech-label">Servicios</span>

            {(proyecto.servicios?.length ?? 0) > 0 ? (
              <div class="tech-chips">
                {proyecto.servicios!.map((s) => (
                  <span class="tag">{formatSimpleLabel(s)}</span>
                ))}
              </div>
            ) : (
              <span class="tech-value">—</span>
            )}
          </div>
        </div>
      </section>


      <aside class="proyecto-minimap">
        {typeof proyecto.ubicacion?.lng === "number" && typeof proyecto.ubicacion?.lat === "number" ? (
          <MiniMapProyecto client:visible lng={proyecto.ubicacion.lng} lat={proyecto.ubicacion.lat} zoom={14} />
        ) : (
          <div class="mapEmpty">Sin coordenadas para este proyecto.</div>
        )}
      </aside>
    </section>




    <section class="proyecto-contenido">
      
      {proyecto.resumen ? (
        <section class="proyecto-resumen">
          <h3> Sobre {proyecto.nombre}</h3>
          <p class="resumen-text">{proyecto.resumen}</p>
        </section>
      ) : null}

      {(galeria?.length ?? 0) > 0 ? (
        <section class="proyecto-fotos">
          <h3>Registro fotográfico</h3>

          <ProyectoGallery
            client:visible
            images={galeria}
          />
        </section>
      ) : null}
    </section>


    <RelatedProyecto
      currentSlug={proyecto.slug}
      limit={3}
    />

  </section>
</Layout>

<style is:global>
  .proyecto-container { max-width: 1100px; margin: 0 auto; padding: 24px 16px 44px; }

  .proyecto-top{
    display:grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 18px;
    align-items: start;
    margin-bottom: 24px;
  }

  .proyecto-tech {
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.7);
    padding: 22px;
  }

  .tech-header { margin-bottom: 18px; }

  .tech-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
  }

  /* ✅ 3 columnas: Cliente | Estado | Ubicación */
  .tech-grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px 22px;
  }

  .tech-item{
    display:flex;
    flex-direction:column;
    gap:6px;
  }

  /* ✅ Servicios full width dentro de ficha */
  .tech-item--full{
    grid-column: 1 / -1;
  }

  .tech-label{
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .6;
  }

  .tech-value{
    font-size: 15px;
    font-weight: 500;
  }

  /* chips dentro de ficha técnica */
  .tech-chips{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top: 8px;
  }

  /* -------------------------------------------------- */
  /* ✅ Detalles del proyecto (resumen + fotos) */
  .proyecto-contenido{
    margin-top: 22px;
    display:grid;
    gap: 14px;
  }

  .contenido-head{
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.7);
    padding: 18px 22px;
  }

  .contenido-head h2{
    margin: 0;
    font-size: 20px;
    font-weight: 600;
  }

  .contenido-sub{
    margin-top: 8px;
    opacity: .75;
  }

  .proyecto-resumen{
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.7);
    padding: 18px 50px;
  }

  .proyecto-resumen h3{
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
    
  }

  .resumen-text{
    margin: 0;
    opacity: .9;
    text-align: justify;
  }

  /* -------------------------------------------------- */
  /* minimapa */
  .proyecto-minimap{
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.6);
    padding: 10px;
  }

  .miniMap{
    width: 100%;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
  }

  .mapEmpty{
    display:flex;
    align-items:center;
    justify-content:center;
    height: 260px;
    border-radius: 12px;
    background: rgba(0,0,0,.04);
    border: 1px dashed rgba(0,0,0,.18);
    font-size: 14px;
  }

  /* -------------------------------------------------- */
  /* galería */
  .proyecto-gallery { margin-top: 22px; }

  .proyecto-gallery-grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .proyecto-gallery-grid figure{
    margin:0;
    border-radius:14px;
    overflow:hidden;
    border:1px solid rgba(0,0,0,.08);
  }

  .proyecto-gallery-grid img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  /* -------------------------------------------------- */
  /* servicios chips (si aún lo usas en algún lado) */
  .servicios-chips{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top: 10px;
  }

  /* -------------------------------------------------- */
  /* responsive */
  @media (max-width: 900px){
    .proyecto-top{ grid-template-columns: 1fr; }

    .tech-grid{ grid-template-columns: 1fr; }
    .tech-item--full{ grid-column: auto; }

    .proyecto-gallery-grid{ grid-template-columns: 1fr; }
  }

  @media (max-width: 560px){
    .proyecto-gallery-grid{ grid-template-columns: 1fr; }
  }

</style>

<script is:inline>
  const a = document.querySelector('[data-proyectos-back]');
  if (a) a.setAttribute('href', '/proyectos' + window.location.search);
</script>