---
export const prerender = true;

import MiniMapProyecto from "../../components/sections/proyectos/MiniMapProyecto.tsx"
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import proyectos from "../../data/proyectos.json";
import { isVisibleProject, assertValidProjects } from "../../lib/projects";

import RelatedProyecto from "../../components/sections/proyectos/RelatedProyecto.astro";
import { lazy } from "astro:schema";

export function getStaticPaths() {
  return proyectos.filter(isVisibleProject).map((p) => ({ params: { slug: p.slug } }));
}
assertValidProjects(proyectos);

const { slug } = Astro.params;
const proyecto = proyectos.find((p) => p.slug === slug);

if (!proyecto || !isVisibleProject(proyecto)) {
  return Astro.redirect("/proyectos");
}

type ImgModule = { default: ImageMetadata };

const imgs = import.meta.glob<ImgModule>(
  "../../assets/images/proyecto/**/*.{png,jpg,jpeg,webp,avif}",
  { eager: true }
);

function resolveImg(relPath: string): ImageMetadata {
  const key = `../../assets/images/proyecto/${relPath}`;
  const mod = imgs[key];
  if (!mod) throw new Error(`Imagen no encontrada: ${key}`);
  return mod.default;
}

const portada = resolveImg(proyecto.portada);

const galeria = (proyecto.galeria ?? []).map((g) => ({
  img: resolveImg(g.src),
  alt: g.alt ?? proyecto.nombre,
}));

const title = `Valcer - ${proyecto.nombre}`;
---

<Layout title={title} heroTitle={proyecto.nombre} heroImage={portada}>
  <section class="proyecto-container">

    <a class="proyecto-back" href="/proyectos" data-proyectos-back>
      ← Volver a proyectos
    </a>

    <section class="proyecto-top">
      <section class="proyecto-tech">
        <header class="tech-header">
          <h2>Ficha técnica</h2>
        </header>

        <div class="tech-grid">
          <div class="tech-item">
            <span class="tech-label">Cliente</span>
            <span class="tech-value">{proyecto.cliente}</span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Estado</span>
            <span class={`tech-badge estado-${proyecto.estado}`}>
              {proyecto.estado}
            </span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Ubicación</span>
            <span class="tech-value">
              {proyecto.ubicacion.distrito}, {proyecto.ubicacion.departamento}
            </span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Inicio</span>
            <span class="tech-value">{proyecto.fecha_inicio}</span>
          </div>

          <div class="tech-item">
            <span class="tech-label">Fin</span>
            <span class="tech-value">
              {proyecto.fecha_fin ?? "En ejecución"}
            </span>
          </div>
        </div>
      </section>


      <aside class="proyecto-minimap">
        {typeof proyecto.ubicacion?.lng === "number" && typeof proyecto.ubicacion?.lat === "number" ? (
          <MiniMapProyecto client:visible lng={proyecto.ubicacion.lng} lat={proyecto.ubicacion.lat} zoom={14} />
        ) : (
          <div class="mapEmpty">Sin coordenadas para este proyecto.</div>
        )}
      </aside>
    </section>

    <section class="proyecto-gallery">
      <h2>Galería</h2>
      <div class="proyecto-gallery-grid">
        {galeria.map((g) => (
          <figure>
            <Image src={g.img} alt={g.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </section>

    <RelatedProyecto
      currentSlug={proyecto.slug}
      limit={3}
    />

  </section>
</Layout>

<style is:global>
  .proyecto-container { max-width: 1100px; margin: 0 auto; padding: 24px 16px 44px; }

  .proyecto-top{
    display:grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 18px;
    align-items: start;
    margin-bottom: 24px;
  }

  .proyecto-tech {
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.7);
    padding: 22px;
  }

  .tech-header {
    margin-bottom: 18px;
  }

  .tech-header h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0,1fr));
    gap: 18px 28px;
  }

  .tech-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tech-label {
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .6;
  }

  .tech-value {
    font-size: 15px;
    font-weight: 500;
  }

  .tech-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    width: fit-content;
  }

  /* estados ejemplo */
  .estado-en_ejecucion {
    background: rgba(0, 120, 255, .1);
    color: rgb(0, 90, 200);
  }

  .estado-finalizado {
    background: rgba(0, 150, 80, .12);
    color: rgb(0, 110, 60);
  }

  .estado-proyectado {
    background: rgba(200, 140, 0, .15);
    color: rgb(160, 110, 0);
  }




  .proyecto-minimap{
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 14px;
    background: rgba(255,255,255,.6);
    padding: 10px;
  }

  .miniMap{
    width: 100%;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
  }

  .mapEmpty{
    display:flex;
    align-items:center;
    justify-content:center;
    height: 260px;
    border-radius: 12px;
    background: rgba(0,0,0,.04);
    border: 1px dashed rgba(0,0,0,.18);
    font-size: 14px;
  }

  .proyecto-gallery { margin-top: 22px; }
  .proyecto-gallery-grid { display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .proyecto-gallery-grid figure { margin:0; border-radius:14px; overflow:hidden; border:1px solid rgba(0,0,0,.08); }
  .proyecto-gallery-grid img { width:100%; height:100%; object-fit:cover; display:block; }


  @media (max-width: 900px){ .proyecto-gallery-grid{ grid-template-columns: 1fr; } }
  @media (max-width: 560px){ .proyecto-gallery-grid{ grid-template-columns: 1fr; } }
</style>

<script is:inline>
  const a = document.querySelector('[data-proyectos-back]');
  if (a) a.setAttribute('href', '/proyectos' + window.location.search);
</script>