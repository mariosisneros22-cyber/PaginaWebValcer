---
import Layout from "../../layouts/Layout.astro";
import proyectoHero from "../../assets/images/proyecto/proyectoHero.jpg";

import ProyectoExplorer from "../../components/sections/proyectos/astro/ProyectoExplorer.astro";
import ProjectCta from "../../components/sections/shared/ProjectCta.astro";
---

<Layout title="Valcer - Proyectos" heroTitle="Proyectos" heroImage={proyectoHero}>

  <section class="section-2">
    <div class="container">
      <h2 class="inp-t">Construimos soluciones que transforman territorio e industria.</h2>
      <p class="inp-p">Más de 20 proyectos ejecutados en todo el país</p>
    </div>
  </section>

  <ProyectoExplorer />

  <ProjectCta />
</Layout>

<style>
  .section-2 .container {
    text-align: center;
  }

  .inp-t {
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .inp-p {
    font-size: var(--text-2xl);
    opacity: .8;
    margin-bottom: 1.5rem;
  }
</style>
