---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';

import AboutSlider from '../components/aboutSlider.astro';
import SliderHero from '../components/hero/sliderHero.astro';
import Button from '../components/button.astro';
import Tab from '../components/tab.astro';

import {serviceTabs} from '../assets/pages/index/exportContent.ts'
import { heroImages, about, aboutCards, infoServicios } from '../assets/pages/index/indexImage.ts';


---

<Layout title="Valcer - Inicio">
  <SliderHero 
    images={heroImages}
    title="Bienvenido a Valcer"
    subtitle="Tu empresa de confianza"
  />
  <section class = "section">
    <div class = "container">
      <!--About us -->
      <div class ="about-us">
        <div class="about-us-content">
          <h2>Sobre Nosotros</h2>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
          <Button href="/nosotros">Leer más</Button>
        </div>
        <div class = "about-us-image"> 
        <Image src={about} alt="Sobre Nosotros"  loading= "eager"/>
        </div>
      </div>

      <AboutSlider cards={aboutCards} />

    </div>

  </section>

  <!-- Servicios Interactivos -->
  <section class="section-2">
    <div class="container">
       <Tab tabs={serviceTabs}      />
    </div>
  </section>

  <!-- Valor Diferencial -->
  <section class="section">
    <div class="container">
      <h2 class="valor-titulo">Por qué elegir Valcer</h2>
      <div class="valor-grid">

        <div class="valor-item">
          <div class="valor-numero">01</div>
          <h3>Experiencia Industrial</h3>
          <p>Más de 15 años trabajando en proyectos de alta complejidad en el sector industrial.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">02</div>
          <h3>Estándares de Calidad</h3>
          <p>Cumplimos con las certificaciones internacionales más exigentes en cada proyecto.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">03</div>
          <h3>Equipo Especializado</h3>
          <p>Profesionales altamente capacitados en construcción, fabricación y mantenimiento.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">04</div>
          <h3>Compromiso y Seguridad</h3>
          <p>Seguridad laboral como prioridad. Cumplimiento estricto de plazos y presupuestos.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section">
    <div class="container">

      <div class="proyectos-ht">
        <h2 class="proyectos-titulo">Proyectos Destacados</h2>
        <Button href="/proyectos">Ver todos los proyectos</Button>
      </div>
    
      <div class="proyectos-grid">

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 1" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 2" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 3" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 4" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 5" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 6" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

      </div>
     
    </div>
  </section>

  <!-- Nuestros Clientes -->
  <section class="clientes-seccion">
    <div class="container">
      <h2 class="clientes-titulo">Nuestros Clientes</h2>
    </div>

    <div class="carrusel-wrapper">
      <div class="carrusel-track">
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 1" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 2" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 3" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 4" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 5" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 6" />
        </div>

        <!-- Duplicados para loop infinito -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 1" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 2" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 3" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 4" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 5" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 6" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* about us */
  .about-us {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-lg);
  }

  .about-us-content{
    flex: 3;
    min-width: 0;
  }

  .about-us-image{
    flex:2;
  }
  .about-us-content,
  .about-us-image {
    min-width: 0;
  }


  .about-us-content h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-md);
  }

  .about-us-image {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .about-us-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 5px;
    border: solid 1px var(--color-border);
  }


  @media (max-width: 768px) {
    .about-us {
      flex-direction: column;
      gap: 2rem;
    }

    .about-us-content,
    .about-us-image {
      flex: 1;
      width: 100%;
    }

    .about-us-image {
      aspect-ratio: 4 / 3;
    }
  }
  /* servicios */
  .servicios-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .servicios-section {
    background: #94daff;

  }

  .servicios-boton {
    text-align: center;
    margin-top: var(--spacing-xl);
  }

  /* valor diferencial */
  .valor-seccion {
    background: var(--color-background-light);
  }

  .valor-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .valor-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .valor-item {
    text-align: center;
  }

  .valor-numero {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-sm);
  }

  .valor-item h3 {
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .valor-item p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .valor-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .valor-grid {
      grid-template-columns: 1fr;
    }
  }

  /* proyectos destacados */
  .proyectos-ht {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
  }

  .proyectos-titulo {
    margin: 0;
  }

  .proyectos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .proyecto-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    cursor: pointer;
  }

  .proyecto-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .proyecto-card:hover img {
    transform: scale(1.05);
  }

  .proyecto-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--spacing-md);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .proyecto-card:hover .proyecto-overlay {
    opacity: 1;
  }

  .proyecto-overlay h3 {
    color: white;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .proyecto-overlay p {
    color: #a0aec0;
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .proyectos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .proyectos-grid {
      grid-template-columns: 1fr;
    }

    .proyecto-overlay {
      opacity: 1;
    }
  }

  /* clientes */
  .clientes-seccion {
    background: var(--color-background-light);
    padding: var(--spacing-lg) 0;
    overflow: hidden;
  }

  .clientes-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .carrusel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .carrusel-track {
    display: flex;
    width: max-content;
    animation: carrusel-scroll 25s linear infinite;
  }

  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: 180px;
    height: 80px;
    margin: 0 var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cliente-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter var(--transition-normal), opacity var(--transition-normal);
  }

  .cliente-logo:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes carrusel-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .cliente-logo {
      width: 140px;
      height: 60px;
      margin: 0 var(--spacing-sm);
    }
  }
</style>