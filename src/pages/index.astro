---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import ServicioCard from '../components/servicioCard.astro';

import img1 from '../assets/pages/index/hero_1.jpg';
import img2 from '../assets/pages/index/hero_2.jpg';
import img3 from '../assets/pages/index/hero_3.jpg';
import about from '../assets/pages/index/about.jpg';

const heroImages = [img1, img2, img3];
---

<Layout title="Valcer - Inicio">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-slider">
      {heroImages.map((image, index) => (
        <div class={`slide ${index === 0 ? 'active' : ''}`}>
          <Image 
            src={image} 
            alt={`Slide ${index + 1}`} 
            loading={index === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
      
      <div class="hero-content">
        <h1>Bienvenido a Valcer</h1>
        <p>Tu empresa de confianza</p>
      </div>
      
      <button class="slide-btn prev" id="prevBtn">‹</button>
      <button class="slide-btn next" id="nextBtn">›</button>
    </div>
  </section>
  
  <!-- Presentacion corta -->
  <section class="section">
    <div class="container">
      <div class="presentacion-grid">
        <div class="presentacion-imagen">
          <Image class="image-box" src={about} alt="VALCER">
        </div> 
      
        <div class="presentacion-texto">
          <h2>Sobre Valcer</h2>
          <!--cambiar el texto -->
          <p> 
            VALCER es una empresa especializada en servicios industriales y construcción, 
            con amplia experiencia en el sector. Nos comprometemos a entregar soluciones 
            de calidad que cumplen con los más altos estándares de seguridad y eficiencia.
          </p>
          <a href="/nosotros" class="btn btn-primary">Más información</a>
        </div>
      </div>
    </div>
  </section>


  <!-- Servicios -->
  <section class="section servicios-section">
    <div class="container">
      <h2 class="servicios-titulo">Nuestros Servicios</h2>
      
      <div class="servicios-grid">
        <ServicioCard
          icon="construccion"
          title="Servicio 1"
          description="Lorem ipsum dolor sit amet consectetur adipiscing elit, interdum odio dictumst dis varius dui, nullam natoque inceptos in auctor congue.."
        />
        <ServicioCard
          icon="mantenimiento"
          title="Servicio 2"
          description="Lorem ipsum dolor sit amet consectetur adipiscing elit, interdum odio dictumst dis varius dui, nullam natoque inceptos in auctor congue."
        />
        <ServicioCard
          icon="fabricacion"
          title="Servicio 3"
          description="Lorem ipsum dolor sit amet consectetur adipiscing elit, interdum odio dictumst dis varius dui, nullam natoque inceptos in auctor congue."
        />
        <ServicioCard
          icon="consultoria"
          title="Servicio 4"
          description="Lorem ipsum dolor sit amet consectetur adipiscing elit, interdum odio dictumst dis varius dui, nullam natoque inceptos in auctor congue."
        />
      </div>

      <div class="servicios-boton">
        <a href="/servicios" class="btn btn-primary">Conoce más</a>
      </div>
    </div>
  </section>

    <!-- Valor Diferencial -->
  <section class="section valor-seccion">
    <div class="container">
      <h2 class="valor-titulo">Por qué elegir Valcer</h2>
      <div class="valor-grid">

        <div class="valor-item">
          <div class="valor-numero">01</div>
          <h3>Experiencia Industrial</h3>
          <p>Más de 15 años trabajando en proyectos de alta complejidad en el sector industrial.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">02</div>
          <h3>Estándares de Calidad</h3>
          <p>Cumplimos con las certificaciones internacionales más exigentes en cada proyecto.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">03</div>
          <h3>Equipo Especializado</h3>
          <p>Profesionales altamente capacitados en construcción, fabricación y mantenimiento.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">04</div>
          <h3>Compromiso y Seguridad</h3>
          <p>Seguridad laboral como prioridad. Cumplimiento estricto de plazos y presupuestos.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section">
    <div class="container">
      <h2 class="proyectos-titulo">Proyectos Destacados</h2>
      <div class="proyectos-grid">

        <!-- Reemplaza los src por tus imágenes reales -->
        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 1" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 2" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 3" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 4" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 5" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

        <div class="proyecto-card">
          <Image src={about} alt="Proyecto 6" />
          <div class="proyecto-overlay">
            <h3>Nombre del Proyecto</h3>
            <p>Descripción breve</p>
          </div>
        </div>

      </div>
      <div class="proyectos-boton">
        <a href="/proyectos" class="btn btn-primary">Ver todos los proyectos</a>
      </div>
    </div>
  </section>

    <!-- Nuestros Clientes -->
  <section class="clientes-seccion">
    <div class="container">
      <h2 class="clientes-titulo">Nuestros Clientes</h2>
    </div>

    <!-- El carrusel va fuera del container para que el fade se extienda full-width -->
    <div class="carrusel-wrapper">
      <div class="carrusel-track">
        <!-- Logo 1 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 1" />
        </div>
        <!-- Logo 2 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 2" />
        </div>
        <!-- Logo 3 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 3" />
        </div>
        <!-- Logo 4 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 4" />
        </div>
        <!-- Logo 5 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 5" />
        </div>
        <!-- Logo 6 -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 6" />
        </div>

        <!-- Duplicados para que el loop se vea infinito -->
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 1" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 2" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 3" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 4" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 5" />
        </div>
        <div class="cliente-logo">
          <Image src={about} alt="Cliente 6" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }

  .hero-slider {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .slide.active {
    opacity: 1;
  }


  /*oscuro inicio*/


  .slide::after { 
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }
  /*oscuro fin*/

  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: absolute;
    bottom: 10%;
    top: 50%;
    left: 5%;
    transform: none;
    color: white;
    text-align: left;
    z-index: 10;
  }

  .hero-content h1 {
    color: white;
    margin-bottom: 1rem;
    font-size: var(--text-3xl);
  }

  .hero-content p {
    color: white;
    font-size: var(--text-2xl);
  }

  .slide-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.5);
    border: none;
    font-size: 3rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
    z-index: 10;
  }

  .slide-btn.prev {
    left: 20px;
  }

  .slide-btn.next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .hero {
      height: 60vh;
    }
    
    .hero-content {
      left: 5%;
    }

    .hero-content h1 {
    font-size: var(--text-2xl);
    }

    .hero-content p {
    font-size: var(--text-xl);
    }
    
    .slide-btn {
      font-size: 2rem;
      padding: 0.5rem 1rem;
    }
  }

  /* presentacion */
  .presentacion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;  /* Cambiado de spacing-xl a 0 */
    align-items: center;
    min-height: 600px;
    padding: var(--spacing-lg) 0;
    position: relative;
  }

  .presentacion-imagen {
    position: relative;
    z-index: 2;  /* Imagen encima */
  }

  .presentacion-imagen::before {
    content: '';
    position: absolute;
    top: -15px;
    left: 15px;
    width: 95%;
    height: 100%;
    background: rgb(163, 221, 255);
    z-index: -1;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .presentacion-texto {
    background: rgb(163, 221, 255);
    border: 1px solid var(--color-border);
    padding: var(--spacing-lg);
    padding-left: calc(var(--spacing-lg) + 50px);  /* Espacio extra a la izquierda */
    max-height: 520px;
    margin-left: -50px;  /* Sobrepasa la imagen */
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 1;  /* Cuadro detrás */
  }
  .presentacion-texto h2 {
  font-size: var(--text-2xl);  /* Titulo mas grande */
  margin-bottom: var(--spacing-md);
  }

  .presentacion-texto p {
    font-size: var(--text-lg);  /* Texto mas grande */
    margin-bottom: var(--spacing-md);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .presentacion-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }
  }

  /* servicios */
  .servicios-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .servicios-section {
    background: rgb(39, 149, 223);
    padding-left: 0;
    padding-right: 0;
  }


  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .servicios-boton {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .servicios-grid {
      grid-template-columns: 1fr;
    }
  }

   /* valor diferencial */
  .valor-seccion {
    background: var(--color-background-light);
  }

  .valor-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .valor-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .valor-item {
    text-align: center;
  }

  .valor-numero {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-sm);
  }

  .valor-item h3 {
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .valor-item p {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .valor-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .valor-grid {
      grid-template-columns: 1fr;
    }
  }

  /* proyectos destacados */
  .proyectos-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .proyectos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
  }

  .proyecto-card {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    cursor: pointer;
  }

  .proyecto-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .proyecto-card:hover img {
    transform: scale(1.05);
  }

  .proyecto-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--spacing-md);
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .proyecto-card:hover .proyecto-overlay {
    opacity: 1;
  }

  .proyecto-overlay h3 {
    color: white;
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .proyecto-overlay p {
    color: #a0aec0;
    font-size: var(--text-sm);
    margin-bottom: 0;
  }

  .proyectos-boton {
    text-align: center;
    margin-top: var(--spacing-lg);
  }

  @media (max-width: 768px) {
    .proyectos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-sm);
    }
  }

  @media (max-width: 480px) {
    .proyectos-grid {
      grid-template-columns: 1fr;
    }

    .proyecto-overlay {
      opacity: 1;
    }
  }

  /* clientes */
  .clientes-seccion {
    background: var(--color-background-light);
    padding: var(--spacing-lg) 0;
    overflow: hidden;
  }

  .clientes-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .carrusel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* Fade transparente en los bordes izquierdo y derecho */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .carrusel-track {
    display: flex;
    width: max-content;
    animation: carrusel-scroll 25s linear infinite;
  }

  /* Pausa al hacer hover */
  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: 180px;
    height: 80px;
    margin: 0 var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cliente-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    /* Escala de grises por defecto */
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter var(--transition-normal), opacity var(--transition-normal);
  }

  .cliente-logo:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes carrusel-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Mueve exactamente la mitad (los originales) para que el loop sea perfecto */
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .cliente-logo {
      width: 140px;
      height: 60px;
      margin: 0 var(--spacing-sm);
    }
  }
</style>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.slide');
  const totalSlides = slides.length;
  //cambios por NodeJs.Timeout
  let autoSlide: ReturnType<typeof setTimeout>;

  function showSlide(index: number) {
    slides.forEach(slide => slide.classList.remove('active'));
    slides[index].classList.add('active');
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    showSlide(currentSlide);
  }

  function prevSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(currentSlide);
  }

  function startAutoSlide() {
    autoSlide = setInterval(nextSlide, 5000);
  }

  document.getElementById('nextBtn')?.addEventListener('click', () => {
    clearInterval(autoSlide);
    nextSlide();
    startAutoSlide();
  });

  document.getElementById('prevBtn')?.addEventListener('click', () => {
    clearInterval(autoSlide);
    prevSlide();
    startAutoSlide();
  });

  startAutoSlide();

  
</script>