---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';

import Slider from '../components/sections/infoSlider.astro';
import Tab from '../components/sections/infoTab.astro';
import SliderHero from '../components/sections/hero/sliderHero.astro';
import Button from '../components/ui/button.astro';
import Card from '../components/sections/infoCards.astro';
import Carrusel from '../components/sections/carrusel.astro';

import {serviceTabs} from '../utils/exportContent.ts'
import { heroImages, about, infoSliders } from '../utils/indexImage.ts';
import { infoCard } from '../utils/projectInfo.ts';
import { clients } from "../utils/clients";
---

<Layout title="Valcer - Inicio">
  <SliderHero 
    images={heroImages}
    title="Bienvenido a Valcer"
    subtitle="Tu empresa de confianza"
  />
  <section class = "section">
    <div class = "container">
      <!--About us -->
      <div class ="about-us">
        <div class="about-us-content">
          <h2>Sobre Nosotros</h2>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
          <Button href="/nosotros">Leer más</Button>
        </div>
        <div class = "about-us-image"> 
        <Image src={about} alt="Sobre Nosotros"  loading= "lazy"/>
        </div>
      </div>

      <Slider slider={infoSliders} />

    </div>

  </section>

  <!-- Servicios Interactivos -->
  <section class="section-2">
    <div class="container">
       <Tab tabs={serviceTabs}      />
    </div>
  </section>

  <!-- Valor Diferencial -->
  <section class="section section-video">
    <video
      class="section-video-bg"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source
        src="/videos/fondo.mp4"
        type="video/mp4"
      />
    </video>

    <div class="section-overlay"></div>

    <div class="container section-content">
      <h2 class="valor-titulo">Por qué elegir Valcer</h2>

      <div class="valor-grid">
        <div class="valor-item">
          <div class="valor-numero">01</div>
          <h3>Experiencia Industrial</h3>
          <p>Más de 15 años trabajando en proyectos de alta complejidad en el sector industrial.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">02</div>
          <h3>Estándares de Calidad</h3>
          <p>Cumplimos con las certificaciones internacionales más exigentes.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">03</div>
          <h3>Equipo Especializado</h3>
          <p>Profesionales altamente capacitados.</p>
        </div>

        <div class="valor-item">
          <div class="valor-numero">04</div>
          <h3>Compromiso y Seguridad</h3>
          <p>Seguridad laboral como prioridad.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section">
    <div class="container">
      <Card cards={infoCard} />

      <div class="proyectos-ht">
        <h2 class="proyectos-titulo">Proyectos Destacados</h2>
        <Button href="/proyectos">Ver todos los proyectos</Button>
      </div>
    
    </div>
  </section>

  <!-- Nuestros Clientes -->
  <section class="section-2">
    <div class="container">
      <h2 class="clientes-titulo">Nuestros Clientes</h2>
      <Carrusel clients={clients} />
    </div>
  </section>
</Layout>

<style>
  /* about us */
  .about-us {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-lg);
  }

  .about-us-content{
    flex: 3;
    min-width: 0;
  }

  .about-us-image{
    flex:2;
  }
  .about-us-content,
  .about-us-image {
    min-width: 0;
  }


  .about-us-content h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--spacing-md);
  }

  .about-us-image {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .about-us-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 5px;
    border: solid 1px var(--color-border);
  }


  @media (max-width: 768px) {
    .about-us {
      flex-direction: column;
      gap: 2rem;
    }

    .about-us-content,
    .about-us-image {
      flex: 1;
      width: 100%;
    }

    .about-us-image {
      aspect-ratio: 4 / 3;
    }
  }
  /* servicios */
  .servicios-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .servicios-section {
    background: #94daff;

  }

  .servicios-boton {
    text-align: center;
    margin-top: var(--spacing-xl);
  }

  /* valor diferencial */

  .section-video {
    position: relative;
    overflow: hidden;
  }

  .section-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Capa oscura para legibilidad */
  .section-overlay {
    position: absolute;
    inset: 0;
    background: rgba(39, 44, 96, 0.65); /* #272c60 con alpha */
    z-index: 1;
  }

  .section-content {
    position: relative;
    z-index: 2;
  }

  /* Ajuste de texto sobre video */
  .section-video h2,
  .section-video h3,
  .section-video p {
    color: #fff;
  }


  .valor-titulo {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }

  .valor-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
  }

  .valor-item {
    text-align: center;
  }

  .valor-numero {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xl);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto var(--spacing-sm);
  }

  .valor-item h3 {
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
  }

  .valor-item p {
    font-size: var(--text-sm);
    color: white;
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .valor-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .valor-grid {
      grid-template-columns: 1fr;
    }
  }

  /* proyectos destacados */
  .proyectos-ht {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
  }

  /* clientes */
  .clientes-seccion {
    background: var(--color-background-light);
    padding: var(--spacing-lg) 0;
    overflow: hidden;
  }

  .clientes-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
  }

  .carrusel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
  }

  .carrusel-track {
    display: flex;
    width: max-content;
    animation: carrusel-scroll 25s linear infinite;
  }

  .carrusel-wrapper:hover .carrusel-track {
    animation-play-state: paused;
  }

  .cliente-logo {
    flex-shrink: 0;
    width: 180px;
    height: 80px;
    margin: 0 var(--spacing-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cliente-logo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter var(--transition-normal), opacity var(--transition-normal);
  }

  .cliente-logo:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  @keyframes carrusel-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .cliente-logo {
      width: 140px;
      height: 60px;
      margin: 0 var(--spacing-sm);
    }
  }
</style>