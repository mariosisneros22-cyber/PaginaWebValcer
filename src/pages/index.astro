---
import { Image } from 'astro:assets';

import Layout from '../layouts/Layout.astro';
import RelatedProyecto from '../components/sections/proyectos/astro/RelatedProyecto.astro';
import Slider from '../components/sections/index/infoSlider.astro';

import SliderHero from '../components/sections/hero/sliderHero.astro';
import Button from '../components/ui/button.astro';

import Carrusel from '../components/sections/index/carrusel.astro';

import { heroImages, about, infoSliders } from '../utils/indexImage.ts';
import serviceHero from '../assets/images/servicios/servicioHero.jpg';

import { clients } from "../utils/clients";
import serviciosRaw from '../data/servicios.json';

type InicioServicio = {
  id: string;
  title: string;
  tagline: string;
};

const serviceHighlights = (serviciosRaw as InicioServicio[]).slice(0, 4).map((service) => ({
  id: service.id,
  title: service.title.replaceAll('\n', ' '),
  description: service.tagline,
}));
---

<Layout title="Valcer - Inicio">
  <SliderHero 
    images={heroImages}
    titleImage="/icons/logo/logo_head.png"
    subtitle="Tu empresa de confianza"
    primaryButton={{ label: "Nosotros", href: "/nosotros" }}
    secondaryButton={{ label: "Contacto", href: "/contacto" }}
  />    
  <section class = "section-2">
    <div class = "container containerabout">
      <!--About us -->
      <div class ="about-us">
        <div class="about-us-content">
          <h3 class="section-heading">Sobre <span class="text-highlight">Nosotros</span></h3>
          <p class="section-copy section-copy--lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
          <p class="section-copy">Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p>
          
        </div>
        
        <div class = "about-us-image"> 
          <Image src={about} alt="Sobre Nosotros"  loading= "eager" width={800} height={600} quality={85} densities={[1, 2]}/>
        </div>
      </div>

      <Slider slider={infoSliders} />

    </div>
  </section>

  <!-- Servicios -->
  <section class="section-2 services-brief">
    <div class="container services-brief__wrap">
      <div class="services-brief__intro">
        <h2 class="services-brief__title">Servicios</h2>
        <div class="services-brief__media surface-callout">
          <Image
            src={serviceHero}
            alt="Equipo y operaciones de servicios"
            loading="lazy"
            width={900}
            height={1100}
            quality={85}
            densities={[1, 2]}
          />
        </div>
        <div class="services-brief__actions">
          <Button href="/servicios">Ver nuestros servicios</Button>
        </div>
      </div>

      <div class="services-brief__list">
        {serviceHighlights.map((service, index) => (
          <a class="services-brief__item" href={`/servicios?tab=${encodeURIComponent(service.id)}`}>
            <span class="services-brief__index">0{index + 1}</span>
            <div class="services-brief__item-content">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Valor Diferencial -->
  <section class="section section-video">
    <video
      class="section-video-bg"
      autoplay
      muted
      loop
      playsinline
      preload="none"
    >
      <source
        src="/videos/fondo-video.mp4"
        type="video/mp4"
      />
      <source
        src="/videos/fondo-video.webm"
        type="video/webm"
      />
    </video>

    <div class="section-overlay"></div>

    <div class="container section-content">

      <h2 class="valor-titulo">Nuestro enfoque en cada <span class="text-highlight">proyecto</span></h2>

      <p class="valor-subtitulo">
        Un proceso estructurado que garantiza planificaciÃ³n tÃ©cnica, ejecuciÃ³n controlada y entrega conforme a especificaciones.
      </p>

      <div class="valor-grid valor-grid-3">
        <div class="valor-item">
          <div class="valor-index">01</div>
          <h3>Planificamos</h3>
          <p>
            Definimos alcance, riesgos, cronograma y recursos antes de iniciar,
            asegurando claridad operativa desde el primer dÃ­a.
          </p>
        </div>

        <div class="valor-item">
          <div class="valor-index">02</div>
          <h3>Ejecutamos</h3>
          <p>
            SupervisiÃ³n en campo, coordinaciÃ³n tÃ©cnica y control continuo
            para mantener calidad y seguridad durante toda la intervenciÃ³n.
          </p>
        </div>

        <div class="valor-item">
          <div class="valor-index">03</div>
          <h3>Garantizamos</h3>
          <p>
            ValidaciÃ³n final, documentaciÃ³n tÃ©cnica y entrega estructurada
            conforme a requerimientos del cliente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Proyectos Destacados -->
  <section class="section-2 section-featured-projects">
    <div class="container">
      <div class="proyectos-ht">
        <div class="proyectos-copy">
          <h2 class="proyectos-titulo">Proyectos destacados</h2>
          <p class="proyectos-subtitulo">
            Mantenemos un proyecto principal en foco y una selecciÃ³n complementaria para mostrar distintas escalas, servicios y contextos de ejecuciÃ³n.
          </p>
        </div>
        <Button href="/proyectos">Leer mÃ¡s</Button>
      </div>

      <RelatedProyecto
        ids={["proj_001", "proj_002", "proj_005", "proj_004"]}
        limit={4}
      />
    </div>
  </section>

  <!-- Nuestros Clientes -->
  <section class="section">
    <div class="container">
      <h2 class="clientes-titulo">Nuestros Clientes</h2>
      <Carrusel clients={clients} />
    </div>
  </section>
</Layout>

<style>
  /* about us */
  .containerabout{
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .about-us {
    display: flex;
    align-items: stretch;
    gap: var(--spacing-lg);
  }

  .about-us-content{
    flex: 3;
    min-width: 0;
    padding: clamp(1.4rem, 2.5vw, 2.35rem);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .about-us-image{
    flex:2;
    min-width: 0;
  }

  .about-us-content h3 {
    max-width: 9ch;
    margin-bottom: 1rem;
  }

  .about-us-content p {
    margin-bottom: 0.9rem;
  }

  .about-us-image {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
  }

  .about-us-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border: 1px solid var(--color-border);
  }


  @media (max-width: 768px) {
    .about-us {
      flex-direction: column;
      gap: 2rem;
    }

    .about-us-content,
    .about-us-image {
      flex: 1;
      width: 100%;
    }

    .about-us-image {
      aspect-ratio: 4 / 3;
    }
  }

  .services-brief__wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: stretch;
  }

  .services-brief__intro {
    display: grid;
    gap: 0.9rem;
    align-self: stretch;
  }

  .services-brief__title {
    margin: 0;
  }

  .services-brief__media {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: #fff;
    border: 1px solid rgba(42, 43, 111, 0.06);
    box-shadow: 0 14px 28px rgba(17, 24, 39, 0.05);
  }

  .services-brief__media :global(img) {
    width: 100%;
    height: clamp(360px, 44vw, 520px);
    object-fit: cover;
    display: block;
  }

  .services-brief__actions {
    display: flex;
    justify-content: flex-start;
  }

  .services-brief__list {
    display: grid;
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    height: 100%;
  }

  .services-brief__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(42, 43, 111, 0.1);
    color: inherit;
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease;
  }

  .services-brief__item-content {
    padding-left: 1rem;
    border-left: 2px solid rgba(42, 43, 111, 0.12);
    transition: border-color .18s ease;
  }

  .services-brief__item:first-child {
    padding-top: 0.1rem;
  }

  .services-brief__item:hover {
    transform: translateX(4px);
    border-color: rgba(42, 43, 111, 0.22);
  }

  .services-brief__item:hover .services-brief__item-content {
    border-left-color: rgba(42, 43, 111, 0.28);
  }

  .services-brief__item:hover .services-brief__index {
    background: rgba(255, 255, 255, 0.98);
    border-color: rgba(42, 43, 111, 0.24);
  }

  .services-brief__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgba(42, 43, 111, 0.12);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .services-brief__item h3 {
    margin-bottom: 0.45rem;
    font-size: var(--text-lg);
  }

  .services-brief__item p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .services-brief__wrap {
      grid-template-columns: 1fr;
    }

    .services-brief__list {
      grid-template-rows: none;
      height: auto;
    }

    .services-brief__media :global(img) {
      height: clamp(280px, 56vw, 420px);
    }
  }

  @media (max-width: 640px) {
    .services-brief__item {
      gap: 0.85rem;
    }

    .services-brief__item-content {
      padding-left: 0.85rem;
    }
  }

  /* valor diferencial */

  .section-video {
    position: relative;
    overflow: hidden;
    min-height: 500px;
  }

  .video-poster {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #36408f 0%, #2a2b6f 58%, #1d1f56 100%);
    z-index: 0;
  }

  .section-video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    transition: opacity 1s ease-in;
  }

  .section-video-bg[data-loaded="true"] {
    opacity: 1;
  }

  .section-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 24, 58, 0.9) 0%,
      rgba(42, 43, 111, 0.76) 48%,
      rgba(18, 22, 52, 0.9) 100%
    );
    z-index: 1;
  }

  .section-content {
    position: relative;
    z-index: 2;
  }

  .section-video h2,
  .section-video h3,
  .section-video p {
    color: var(--color-white);
  }

  .valor-titulo {
    text-align: center;
    max-width: 13ch;
    margin-inline: auto;
  }
  .valor-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 28px;
    padding: 0 10px;
    border-radius: 999px;
    border: 1px solid rgba(109, 186, 235, 0.34);
    background: rgba(109, 186, 235, 0.14);
    color: rgba(255,255,255,0.92);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .valor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--spacing-lg);
  }

  .valor-item {
    text-align: center;
    padding: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(109, 186, 235, 0.08));
    backdrop-filter: blur(6px);
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .valor-item:hover {
    transform: translateY(-8px);
    border-color: rgba(109, 186, 235, 0.3);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(109, 186, 235, 0.14));
  }

  .valor-grid-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .valor-subtitulo {
    text-align: center;
    max-width: 720px;
    margin: 0 auto var(--spacing-lg);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.7;
    font-size: var(--text-lg);
  }

  .valor-item h3 {
    font-weight: 700;
    margin-bottom: var(--spacing-xs);
    font-size: var(--text-xl);
  }

  .valor-item p {
    font-size: var(--text-base);
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .valor-grid-3 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .valor-grid {
      grid-template-columns: 1fr;
    }
  }

  /* proyectos destacados */
  .section-featured-projects {
    position: relative;
  }

  .section-featured-projects::before {
    display: none;
  }

  .proyectos-ht {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
    gap: var(--spacing-md);
    position: relative;
    z-index: 1;
  }

  .proyectos-copy {
    max-width: 52rem;
  }

  .proyectos-titulo {
    margin: 0;
  }

  .proyectos-subtitulo {
    max-width: 64ch;
    margin: 0.85rem 0 0;
    color: rgba(24, 29, 62, 0.8);
    line-height: 1.75;
    font-size: var(--text-base);
  }

  @media (max-width: 768px) {
    .section-featured-projects::before {
      inset: 1rem 0 auto;
      height: 180px;
    }

    .proyectos-ht {
      align-items: start;
    }

    .proyectos-subtitulo {
      font-size: var(--text-sm);
      line-height: 1.7;
    }
  }

  /* Clientes */
  .clientes-titulo {
    text-align: left;
    margin-bottom: var(--spacing-lg);
    max-width: 12ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-video-bg,
    .valor-item {
      transition: none;
    }
  }
</style>

<script>
  // Lazy load video optimizado
  function initVideoLazyLoad() {
    const video = document.querySelector<HTMLVideoElement>('.section-video-bg');
    if (!video) return;

    // Detectar si el usuario prefiere datos reducidos
    const prefersReducedData = 
      'connection' in navigator && 
      (navigator as any).connection?.saveData === true;

    // No cargar video en conexiones lentas o con ahorro de datos
    if (prefersReducedData) return;

    // Usar Intersection Observer para cargar solo cuando sea visible
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            // Cargar video solo cuando estÃ© cerca del viewport
            const sources = video.querySelectorAll('source');
            sources.forEach(source => {
              const src = source.getAttribute('src');
              if (src && !source.hasAttribute('data-loaded')) {
                source.setAttribute('data-loaded', 'true');
              }
            });

            video.load();
            
            video.addEventListener('loadeddata', () => {
              video.setAttribute('data-loaded', 'true');
            }, { once: true });

            observer.disconnect();
          }
        });
      },
      {
        rootMargin: '200px' // Comenzar a cargar 200px antes
      }
    );

    observer.observe(video);
  }

  initVideoLazyLoad();
</script>

