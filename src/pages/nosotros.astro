---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import Timeline from '../components/sections/nosotros/timeline.astro'

import Mvv from '../components/sections/nosotros/mv.astro'

import nosotrosHero from '../assets/images/nosotros/nosotrosHero.jpg';

import ValoresZigZag from '../components/sections/nosotros/valoresZigZag.astro';
import {valores} from '../utils/valores'
import { gerentes } from '../utils/gerente';
import { heroImages } from '../utils/indexImage';

import NosotrosSplit from '../components/sections/nosotros/nosotrosSplit.astro';
import ProjectCta from '../components/sections/shared/ProjectCta.astro';
---

<Layout title="Valcer - Nosotros" heroTitle="Nosotros" heroImage={nosotrosHero}>
  <section class="section gerente-section">
    <div class="container gerente-slider" data-gerente-slider>
      {gerentes.map((gerente, index) => (
        <div
          class={`gerente-grid${index === 0 ? " is-active" : ""}`}
          data-gerente-slide
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <div class="gerente-photo">
            <Image
              src={gerente.photo}
              alt={gerente.alt}
              width={720}
              height={900}
              quality={85}
              densities={[1, 2]}
            />
          </div>

          <div class="gerente-copy">
            <span class="gerente-kicker">Mensaje de gerencia</span>
            <blockquote class="gerente-quote">
              "{gerente.message}"
            </blockquote>
            <p class="gerente-name">{gerente.name}</p>
            <p class="gerente-role">{gerente.role}</p>
          </div>
        </div>
      ))}

      <div class="gerente-dots" aria-label="Cambiar mensaje de gerencia">
        {gerentes.map((gerente, index) => (
          <button
            type="button"
            class={`gerente-dot${index === 0 ? " is-active" : ""}`}
            data-gerente-dot
            data-index={index}
            aria-label={`Ver mensaje de ${gerente.name}`}
            aria-pressed={index === 0 ? "true" : "false"}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- Quienes somos -->
  <NosotrosSplit
    title="Quiénes somos"
    lead="Más de X años ejecutando proyectos con estándares técnicos y compromiso profesional."
    paragraphs={[
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."
    ]}
    images={heroImages}
  />

  <!-- Pilares empresa -->
  <ValoresZigZag items={valores} />

  <!-- Mision vision y valores -->
  <Mvv
    title="Propósito y rumbo"
    manifesto="Construimos infraestructura con seguridad y rigor técnico, para generar confianza hoy y desarrollo mañana."
    leftTag="Propósito"
    rightTag="Rumbo"
    mission={{
      title: "Cómo trabajamos",
      body: "Brindar servicios de ejecución, supervisión y consultoría en obras civiles y de esta manera podamos satisfacer las necesidades de nuestros clientes entregando un servicio de calidad bajo las normas y leyes vigentes, propiciando un ambiente de trabajo seguro.",
    }}
    vision={{
      title: "Hacia dónde vamos",
      body: "Ser una empresa líder, y promotor en el desarrollo del país a nivel nacional ejecutando los mejores proyectos constructivos, aplicando los más altos estándares de calidad.",
    }}
  />

  <Timeline />

  <ProjectCta />
</Layout>

<style>
  .gerente-section {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .gerente-slider {
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    min-height: 540px;
  }

  .gerente-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(1.4rem, 4vw, 3rem);
    align-items: center;
    justify-content: center;
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(42px);
    transition: opacity 0.55s ease, transform 0.55s ease, visibility 0.55s ease;
  }

  .gerente-grid.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .gerente-photo {
    max-width: 340px;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(42, 43, 111, 0.08);
    box-shadow: 0 10px 22px rgba(32, 39, 87, 0.06);
    background: rgba(255, 255, 255, 0.96);
  }

  .gerente-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  .gerente-copy {
    padding: clamp(1rem, 2vw, 1.4rem) 0;
    max-width: 42rem;
  }

  .gerente-kicker {
    display: inline-flex;
    padding: 0.38rem 0.8rem;
    border-radius: 999px;
    background: rgba(109, 186, 235, 0.12);
    color: var(--color-primary);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .gerente-quote {
    position: relative;
    margin: 0;
    padding-left: 1.8rem;
    color: var(--color-text);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.65;
    font-weight: 500;
    max-width: 38ch;
  }

  .gerente-quote::before,
  .gerente-quote::after {
    position: absolute;
    color: rgba(42, 43, 111, 0.2);
    font-family: Garamond, Baskerville, "Palatino Linotype", "Book Antiqua", serif;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .gerente-quote::before {
    content: '"';
    top: -0.25rem;
    left: 0;
  }

  .gerente-quote::after {
    content: '"';
    right: 0;
    bottom: -1.1rem;
  }

  .gerente-name {
    margin: 1.25rem 0 0;
    color: var(--color-text-light);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gerente-role {
    margin: 0.35rem 0 0;
    color: var(--color-text-lighter);
    font-size: var(--text-sm);
  }

  .gerente-dots {
    display: flex;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 1.25rem;
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: max-content;
  }

  .gerente-dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(42, 43, 111, 0.16);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .gerente-dot.is-active {
    background: var(--color-primary);
    transform: scale(1.15);
  }

  .pillars-grid{
    --overlap: 18px;
    --cut: 44px;

    display: grid;
    gap: 0;
    margin-top: 18px;

    max-width: 980px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 900px) {
    .gerente-slider {
      min-height: 760px;
    }

    .gerente-grid {
      grid-template-columns: 1fr;
    }

    .gerente-photo {
      max-width: 300px;
      width: 100%;
      margin: 0 auto;
    }

    .gerente-copy {
      padding-top: 0;
      max-width: none;
      text-align: center;
    }

    .gerente-quote {
      max-width: none;
      padding-left: 0.9rem;
      padding-right: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gerente-grid {
      transition: none;
    }

    .gerente-dot {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const slider = document.querySelector<HTMLElement>('[data-gerente-slider]');
    const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-gerente-slide]'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gerente-dot]'));
    let activeIndex = 0;
    let timerId: number | undefined;

    function showSlide(index: number) {
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;
        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === index;
        dot.classList.toggle('is-active', isActive);
        dot.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      activeIndex = index;
    }

    function startSlider() {
      if (slides.length <= 1) return;
      window.clearInterval(timerId);
      timerId = window.setInterval(() => {
        showSlide((activeIndex + 1) % slides.length);
      }, 5000);
    }

    if (slider && slides.length) {
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          showSlide(index);
          startSlider();
        });
      });

      slider.addEventListener('mouseenter', () => window.clearInterval(timerId));
      slider.addEventListener('mouseleave', startSlider);

      showSlide(0);
      startSlider();
    }

    const pillars = document.querySelectorAll<HTMLElement>('.pillar');
    if (!pillars.length) return;

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const index = [...pillars].indexOf(el);
        el.style.transitionDelay = `${index * 120}ms`;
        el.classList.add('is-visible');
        obs.unobserve(el);
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -10% 0px" });

    pillars.forEach((p) => observer.observe(p));
  });
</script>
