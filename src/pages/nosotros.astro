<style>
  /*quienes somos section*/

  .section-who h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.5rem;
  }

  .section-who p {
    max-width: 720px;
    line-height: 1.6;
  }

  

  /*Pilares*/
  .section-highlight {
    background: #f5f5f5;
  }

  .pillar {
    padding: 2rem;
    border-left: 4px solid #000;
  }

  .pillar h3 {
    margin-bottom: 0.75rem;
  }

  /*Historia y trayectoria*/
  .list {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
  }

  .list li {
    margin-bottom: 0.5rem;
  }

  /*Mision vision y valores*/
  .section-highlight {
    background: #f5f5f5;
  }

  .card {
    padding: 2rem;
    border: 1px solid #e5e5e5;
  }


  /*CTA*/
  .cta {
    background: #000;
    color: white;
    padding: 4rem 1rem;
  }

  .cta-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-actions {
    margin-top: 2rem;
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

</style>