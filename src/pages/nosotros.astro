---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/button.astro';

import Pilar from '../components/sections/nosotros/pilar.astro'
import nosotrosHero from '../assets/images/nosotros/nosotrosHero.jpg';


import {valPilar} from '../utils/valores.ts';
---

<Layout title="Valcer - Nosotros"
  heroTitle= "Nosotros" 
  heroImage={nosotrosHero} 
>
  <!--Quienes somos-->
  <section class="section-2 section-who">
    <div class="container who-grid">
      <div class="who-content">
        <h2>Quiénes somos</h2>
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. 
          Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
        </p>

        <p>
          Duis aute irure dolor in reprehenderit in voluptate velit esse
          cillum dolore eu fugiat nulla pariatur.
        </p>  
      
      </div>

      <div class="who-video youtube-video" data-video-id="PmRv-3-tUwA">
        <div class="youtube-overlay ">   
        ▶
        </div>  
      </div>
      


    </div>
  </section>



  <!--Pilares empresa-->
  <section class="section">
    <div class="container">
      <h2>Nuestros pilares</h2>
        <div class="pillars-grid">
          {valPilar.map((pillar) => (<Pilar {...pillar} />
          ))}
        </div>
    </div>
  </section>

  <!--Equipo y experiencia-->
  <section class="section-2">
    <div class="container">
      <h2>Historia y trayectoria</h2>

        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit.
          Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
        </p>

        <ul class="list">
          <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          <li>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</li>
          <li>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</li>
        </ul>
    </div>
  </section>

  <!--Mision vision y valores-->
  <section class="section">
    <div class="container">
      <h2>Misión, visión y valores</h2>

        <div class="grid">
          <div class="card">
            <h3>Misión</h3>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
              Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
          </div>

          <div class="card">
            <h3>Visión</h3>
            <p>
              Ut enim ad minim veniam, quis nostrud exercitation ullamco
              laboris nisi ut aliquip ex ea commodo consequat.
            </p>
          </div>

          <div class="card">
            <h3>Valores</h3>
            <ul class="list">
              <li>Responsabilidad</li>
              <li>Compromiso</li>
              <li>Transparencia</li>
              <li>Trabajo en equipo</li>
            </ul>
          </div>
        </div>
    </div>
  </section>


  <!-- Resto del contenido -->
  <section class="section-2">
    <div class="container">
      <div class="cta-content">
            <h2>¿Tienes un proyecto en mente?</h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            </p>

            <Button href="/contacto">CONTACTAR</Button>
            </div>
      </div>

    </div>
    
  </section>


</Layout>

<style>
  /*quienes somos section*/
  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch; 
    gap: 3rem;
  }

  .section-who h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.5rem;
  }

  .section-who p {
    max-width: 720px;
    line-height: 1.6;
  }
  /* video conf */


  .who-video {
    display: flex;
  }

  .video-start {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /*youtube test*/
  .youtube-video {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    cursor: pointer;
  }

  .youtube-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: white;
    font-size: 4rem;
    background: rgba(0, 0, 0, 0.55);
  }
  /*Pilares*/

  /* Grid: uno debajo del otro */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
    overflow-x: hidden;
  }


  /*Historia y trayectoria*/
  .list {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
  }

  .list li {
    margin-bottom: 0.5rem;
  }

  /*Mision vision y valores*/
  .section-highlight {
    background: #f5f5f5;
  }

  .card {
    padding: 2rem;
    border: 1px solid #e5e5e5;
  }


  /*CTA*/

  .cta-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }



</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector('.youtube-video') as HTMLElement | null;
    if (!el) return;

    const id = el.dataset.videoId;
    if (!id) return;

    const handleClick = () => {
      el.removeEventListener('click', handleClick);

      el.innerHTML = `
        <iframe
          src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
          style="width:100%;height:100%;border:0"
        ></iframe>
      `;
    };

    el.addEventListener('click', handleClick);
  });


  document.addEventListener('astro:page-load', () => {
    const pillars = document.querySelectorAll('.pillar');
    if (!pillars.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const index = [...pillars].indexOf(el);

            el.style.transitionDelay = `${index * 120}ms`;
            el.classList.add('is-visible');

            obs.unobserve(el); // cleanup
          }
        });
      },
      { threshold: 0.2 }
    );

    pillars.forEach((pillar) => observer.observe(pillar));
  });
</script>