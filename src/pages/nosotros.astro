---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/button.astro';

import Timeline from '../components/sections/nosotros/timeline.astro'
import Pilar from '../components/sections/nosotros/pilar.astro'
import Mvv from '../components/sections/nosotros/mvv.astro'

import nosotrosHero from '../assets/images/nosotros/nosotrosHero.jpg';

import { valPilar } from '../utils/valores.ts';
import { heroImages } from '../utils/indexImage';

import NosotrosSplit from '../components/sections/nosotros/nosotrosSplit.astro';
---

<Layout title="Valcer - Nosotros" heroTitle="Nosotros" heroImage={nosotrosHero}>
  <!-- Quienes somos -->
  <NosotrosSplit
    title="Quiénes somos"
    lead="Más de X años ejecutando proyectos con estándares técnicos y compromiso profesional."
    paragraphs={[
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
      "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur."
    ]}
    images={heroImages}
  />

  <!-- Pilares empresa -->
  <section class="section-2">
    <div class="container">
      <h2>Nuestros pilares</h2>
      <div class="pillars-grid">
        {valPilar.map((pillar) => (<Pilar {...pillar} />))}
      </div>
    </div>
  </section>

  <!-- Mision vision y valores -->
  <Mvv
    mediaImage={nosotrosHero}
    mediaAlt="Ejecución de obra de Valcer"
    mediaSide="left"
    mission={{ title: "Misión", body: "..." }}
    vision={{ title: "Visión", body: "..." }}
    values={{ title: "Valores", items: [/* ... */] }}
  />

  <Timeline />

  <!-- CTA -->
  <section class="section-2">
    <div class="container cta-content">
      <h2>¿Tienes un proyecto en mente?</h2>
      <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
      <Button href="/contacto">CONTACTAR</Button>
    </div>
  </section>
</Layout>

<style>
  .pillars-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:2rem;
    position:relative;
    overflow-x:hidden;
  }

  .cta-content{
    max-width:900px;
    margin:0 auto;
    text-align:center;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const pillars = document.querySelectorAll('.pillar');
    if (!pillars.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const el = entry.target as HTMLElement; // ✅ fix TS
          const index = [...pillars].indexOf(el);

          el.style.transitionDelay = `${index * 120}ms`;
          el.classList.add('is-visible');

          obs.unobserve(el);
        });
      },
      { threshold: 0.2 }
    );

    pillars.forEach((pillar) => observer.observe(pillar));
  });
</script>