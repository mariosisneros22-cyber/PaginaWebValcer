          label: "Responsabilidad",
          desc: "Cumplimos plazos y estándares.",
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6 9 17l-5-5"/></svg>`,
        },
        {
          label: "Compromiso",
          desc: "Acompañamiento de inicio a fin.",
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M2 12h20"/></svg>`,
        },
        {
          label: "Transparencia",
          desc: "Información clara y trazable.",
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`,
        },
        {
          label: "Trabajo en equipo",
          desc: "Coordinación y comunicación constante.",
          icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 11c1.66 0 3-1.34 3-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3Z"/><path d="M8 11c1.66 0 3-1.34 3-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3Z"/><path d="M8 13c-2.21 0-4 1.79-4 4v2"/><path d="M16 13c2.21 0 4 1.79 4 4v2"/><path d="M12 12c1.66 0 3-1.34 3-3S13.66 6 12 6 9 7.34 9 9s1.34 3 3 3Z"/><path d="M12 14c-2.21 0-4 1.79-4 4v2h8v-2c0-2.21-1.79-4-4-4Z"/></svg>`,
        },
      ],
    }}
  />



  <!-- Resto del contenido -->
  <section class="section-2">
    <div class="container">
      <div class="cta-content">
            <h2>¿Tienes un proyecto en mente?</h2>
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit.
            </p>

            <Button href="/contacto">CONTACTAR</Button>
            </div>
      </div>

    </div>
    
  </section>


</Layout>

<style>
  /*quienes somos section*/
  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch; 
    gap: 3rem;
  }

  .section-who h2 {
    font-size: var(--text-2xl);
    margin-bottom: 1.5rem;
  }

  .section-who p {
    max-width: 720px;
    line-height: 1.6;
  }
  /* video conf */


  .who-video {
    display: flex;
  }

  .video-start {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /*youtube test*/
  .youtube-video {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    cursor: pointer;
  }

  .youtube-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: white;
    font-size: 4rem;
    background: rgba(0, 0, 0, 0.55);
  }
  /*Pilares*/

  /* Grid: uno debajo del otro */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
    overflow-x: hidden;
  }


  /*Historia y trayectoria*/
  .list {
    margin-top: 1.5rem;
    padding-left: 1.25rem;
  }

  .list li {
    margin-bottom: 0.5rem;
  }

  /*Mision vision y valores*/
  .section-highlight {
    background: #f5f5f5;
  }

  .card {
    padding: 2rem;
    border: 1px solid #e5e5e5;
  }


  /*CTA*/

  .cta-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }



</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector('.youtube-video') as HTMLElement | null;
    if (!el) return;

    const id = el.dataset.videoId;
    if (!id) return;

    const handleClick = () => {
      el.removeEventListener('click', handleClick);

      el.innerHTML = `
        <iframe
          src="https://www.youtube.com/embed/${id}?autoplay=1&rel=0"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
          style="width:100%;height:100%;border:0"
        ></iframe>
      `;
    };

    el.addEventListener('click', handleClick);
  });


  document.addEventListener('astro:page-load', () => {
    const pillars = document.querySelectorAll('.pillar');
    if (!pillars.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const index = [...pillars].indexOf(el);

            el.style.transitionDelay = `${index * 120}ms`;
            el.classList.add('is-visible');

            obs.unobserve(el); // cleanup
          }
        });
      },
      { threshold: 0.2 }
    );

    pillars.forEach((pillar) => observer.observe(pillar));
  });
</script>